---
import Base from '@layouts/Base.astro'
import Hero from '@components/Hero.astro'
import CTABanner from '@components/CTABanner.astro'
import practice from '@data/practice.json'
---

<Base title="Special Offers" description={`Special offers and promotions at ${practice.name}. Affordable dental care in ${practice.address.city}, ${practice.address.state} for the whole family.`}>
  <Hero title="Special Offers" subtitle="Quality dental care that fits your budget" />

  <section class="py-16 sm:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="text-gray-600 text-lg">
          Dr. Brian Call, Dr. Conner Ogden, and our expert team are proud to provide high-quality
          dental care in {practice.address.city}, {practice.address.state}, that fits your budget.
          We offer rotating specials to help families access the treatments they need at a great value.
        </p>
      </div>

      <div class="bg-white p-8 sm:p-10 rounded-xl border border-gray-200 shadow-sm text-center">
        <div class="w-16 h-16 mx-auto mb-6 bg-primary/10 rounded-full flex items-center justify-center">
          <svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
          </svg>
        </div>
        <h2 class="text-2xl font-bold font-heading mb-4">Check Back for Our Promotions!</h2>
        <p class="text-gray-600 text-lg mb-6">
          We regularly update our special offers to bring you the best value on dental care.
          Check back soon to see our latest promotions, or give us a call to ask about
          current specials.
        </p>
        <a
          href={`tel:${practice.phone.replace(/[^+\d]/g, '')}`}
          class="inline-flex items-center justify-center bg-primary text-white px-8 py-3.5 rounded-lg text-lg font-semibold hover:bg-secondary transition-colors"
        >
          <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Call {practice.phone}
        </a>
      </div>

      <div class="mt-10 bg-gray-50 p-6 rounded-xl border border-gray-100 text-center">
        <h3 class="font-semibold font-heading mb-2">Flexible Payment Options Available</h3>
        <p class="text-gray-600 text-sm mb-3">
          We also offer Cherry Financing and accept most PPO insurance plans to help make dental
          care affordable for your family.
        </p>
        <a
          href="/patient-resources/financial-options"
          class="inline-flex items-center text-primary font-semibold text-sm hover:text-secondary transition-colors"
        >
          View Financial Options
          <svg class="ml-1 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <CTABanner
    title="Ready to Schedule?"
    subtitle={`Call ${practice.name} today to learn about our current offers.`}
  />
</Base>

---
import practice from '@data/practice.json'

const reviews = (practice as any).reviews ?? {}
const placeId: string = reviews.placeId || ''
const base = `https://${practice.domain}`
const logo = (practice as any).logo ? `${base}${(practice as any).logo}` : `${base}/og.webp`
// Entity links (sameAs) strengthen the knowledge graph for GEO / AI engines
const sameAs = [
  ...Object.values(practice.social).filter(Boolean),
  placeId ? `https://www.google.com/maps/place/?q=place_id:${placeId}` : '',
].filter(Boolean)

// Doctors as linked Dentist entities (E-E-A-T + AI citation)
const employees = (practice.providers ?? []).map((p: any) => ({
  '@type': 'Dentist',
  name: `${p.name}, ${p.credentials}`,
  jobTitle: p.title,
  url: `${base}/team/${p.slug}`,
  image: p.photo ? `${base}${p.photo}` : undefined,
  knowsAbout: p.specialties,
}))

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  '@id': `${base}/#dentist`,
  name: practice.name,
  description: practice.tagline,
  url: base,
  telephone: practice.phone,
  email: practice.email || undefined,
  image: `${base}/og.webp`,
  logo,
  priceRange: '$$',
  currenciesAccepted: 'USD',
  paymentAccepted: 'Cash, Credit Card, Insurance',
  address: {
    '@type': 'PostalAddress',
    streetAddress: practice.address.street,
    addressLocality: practice.address.city,
    addressRegion: practice.address.state,
    postalCode: practice.address.zip,
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: practice.geo.lat,
    longitude: practice.geo.lng,
  },
  hasMap: placeId ? `https://www.google.com/maps/place/?q=place_id:${placeId}` : undefined,
  areaServed: (practice as any).areaServed?.map((a: string) => ({ '@type': 'City', name: a })),
  openingHoursSpecification: practice.hours
    .filter((h: { note?: string }) => !h.note)
    .map((h: { days: string; open?: string; close?: string }) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: h.days,
      opens: h.open,
      closes: h.close,
    })),
  medicalSpecialty: practice.serviceCategories,
  employee: employees.length ? employees : undefined,
  sameAs,
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', '.eyebrow', '[data-speakable]'],
  },
  aggregateRating:
    reviews.count > 0
      ? {
          '@type': 'AggregateRating',
          ratingValue: reviews.rating,
          reviewCount: reviews.count,
          bestRating: 5,
        }
      : undefined,
}
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

---
import Base from '@layouts/Base.astro'
import CTABanner from '@components/CTABanner.astro'
import practice from '@data/practice.json'
---
<Base title="Meet Our Doctors" description={`Meet the dentists at ${practice.name} in ${practice.address.city}, ${practice.address.state}.`}>
  <section class="relative bg-secondary text-white">
    <img src="/images/oak/internal-banner.webp" alt="" class="absolute inset-0 w-full h-full object-cover opacity-30" />
    <div class="absolute inset-0 bg-gradient-to-r from-secondary via-secondary/90 to-primary/70"></div>
    <div class="container-px relative py-16">
      <p class="eyebrow text-accent-soft">Meet the doctors</p>
      <h1 class="mt-4 text-4xl sm:text-5xl font-semibold">The dentists behind your smile</h1>
      <p class="mt-4 text-white/85 max-w-2xl">Four experienced, caring dentists providing comprehensive dentistry for the whole family in {practice.address.city}.</p>
    </div>
  </section>
  <section class="py-16 sm:py-20">
    <div class="container-px grid grid-cols-2 lg:grid-cols-4 gap-6">
      {practice.providers.map((doc) => (
        <div class="card-soft overflow-hidden text-center">
          {doc.photo
            ? <div class="aspect-square overflow-hidden bg-cream"><img src={doc.photo} alt={`${doc.name}, ${doc.credentials}`} class="w-full h-full object-cover object-top" loading="lazy" /></div>
            : <div class="aspect-square grid place-items-center bg-gradient-to-br from-primary to-secondary text-white text-3xl font-semibold">{doc.name.replace(/^Dr\.?\s+/, '').split(' ').map((p) => p[0]).slice(0, 2).join('')}</div>}
          <div class="p-5">
            <h2 class="text-lg font-semibold text-dark">{doc.name}, {doc.credentials}</h2>
            <p class="text-sm text-primary">{doc.title}</p>
            <div class="mt-3 flex flex-wrap gap-1.5 justify-center">
              {doc.specialties.slice(0, 2).map((s) => <span class="text-xs bg-primary/10 text-primary px-2 py-0.5 rounded-full">{s}</span>)}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
  <CTABanner />
</Base>

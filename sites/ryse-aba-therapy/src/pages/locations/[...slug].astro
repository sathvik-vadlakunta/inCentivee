---
import Base from '@layouts/Base.astro'
import practice from '@data/practice.json'
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
  const locations = await getCollection('locations')
  return locations.map((l) => ({ params: { slug: l.slug }, props: { entry: l } }))
}
const { entry } = Astro.props
const { Content } = await entry.render()
const phoneHref = `tel:${practice.phone.replace(/[^+\d]/g, '')}`
const faqs = entry.data.faqs ?? []
const city = entry.data.city
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(city + ', Utah')}&z=11&output=embed`
const others = (await getCollection('locations')).filter((l) => l.slug !== entry.slug)
const heroImg = entry.data.image && entry.data.image.startsWith('/images/locations') ? '/images/categories/local.jpg' : (entry.data.image || '/images/categories/local.jpg')
const slugify = (s) => s.toLowerCase().replace(/[^a-z]+/g, '-').replace(/^-|-$/g, '')
---
<Base title={entry.data.title} description={entry.data.description}>
  <!-- HERO with image -->
  <section class="section-sky relative overflow-hidden">
    <div class="parallax blob" data-speed="0.3" style="width:340px;height:340px;background:var(--color-sun);top:-120px;right:-70px;opacity:.35;"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16 grid lg:grid-cols-2 gap-10 items-center">
      <div class="reveal is-visible">
        <a href="/locations" class="text-sm font-semibold text-primary">← Areas we serve</a>
        <span class="inline-block mt-3 text-accent font-bold uppercase tracking-wide text-xs">📍 Southern Utah · No waitlist</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-dark mt-2 leading-tight">{entry.data.title}</h1>
        <p class="mt-4 text-lg text-slate-600">{entry.data.description}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/contact" class="btn btn-accent text-lg">Get started — no waitlist</a>
          <a href={phoneHref} class="btn btn-ghost text-lg">📞 {practice.phone}</a>
        </div>
      </div>
      <div class="reveal is-visible relative">
        <div class="parallax blob-mask aspect-[5/4] shadow-2xl" data-speed="-0.12" style="background:linear-gradient(150deg,var(--color-sun),var(--color-accent));">
          <img src={heroImg} alt={`In-home ABA therapy in ${city}, Utah`} class="w-full h-full object-cover" loading="eager" onerror="this.style.opacity=0" />
        </div>
      </div>
    </div>
  </section>

  <!-- BODY + MAP -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 grid lg:grid-cols-[1fr_360px] gap-12">
      <article class="reveal prose prose-slate prose-lg prose-headings:font-heading prose-headings:text-dark prose-a:text-primary max-w-none">
        <Content />
      </article>
      <aside class="reveal reveal-delay-1">
        <div class="card overflow-hidden sticky top-24">
          <div class="aspect-[4/3] bg-sky">
            <iframe src={mapSrc} title={`Map of ${city}, Utah`} loading="lazy" class="w-full h-full border-0" referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
          <div class="p-6">
            <h3 class="font-extrabold text-dark">Serving {city} in-home</h3>
            <p class="mt-2 text-sm text-slate-600">We bring ABA therapy to your home and community across {city} and Southern Utah.</p>
            <a href="/contact" class="btn btn-accent w-full justify-center mt-4">Check my insurance — free</a>
            <a href={phoneHref} class="block text-center mt-3 font-bold text-primary">{practice.phone}</a>
          </div>
        </div>
      </aside>
    </div>

    {faqs.length > 0 && (
      <div class="max-w-3xl mx-auto px-4 mt-16">
        <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) })} />
        <h2 class="text-2xl sm:text-3xl font-extrabold text-dark mb-6">{city} ABA — common questions</h2>
        <div class="space-y-3">
          {faqs.map((f) => (
            <details class="card p-5 group">
              <summary class="font-bold text-dark cursor-pointer flex justify-between items-center gap-4">{f.question}<span class="text-primary group-open:rotate-45 transition-transform text-2xl shrink-0">+</span></summary>
              <p class="mt-3 text-slate-600 leading-relaxed">{f.answer}</p>
            </details>
          ))}
        </div>
      </div>
    )}
  </section>

  <!-- NEARBY AREAS -->
  <section class="py-14 section-cream">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <h2 class="text-xl font-extrabold text-dark mb-6 reveal">We also serve nearby Southern Utah communities</h2>
      <div class="flex flex-wrap justify-center gap-2.5 reveal">
        {others.map((l) => (<a href={`/locations/${l.slug}`} class="px-4 py-2 bg-white rounded-full shadow-sm text-sm font-semibold text-primary-deep hover:shadow-lift hover:-translate-y-0.5 transition-all">📍 {l.data.city}</a>))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16" style="background:linear-gradient(120deg,var(--color-primary-deep),var(--color-primary));">
    <div class="max-w-2xl mx-auto px-4 text-center text-white reveal">
      <h2 class="text-3xl font-extrabold">Serving {city} with no waitlist</h2>
      <p class="mt-3 text-white/85">Free insurance check · in your home · BCBA-led care.</p>
      <a href="/contact" class="btn btn-accent mt-6 text-lg">Get started today</a>
    </div>
  </section>
</Base>

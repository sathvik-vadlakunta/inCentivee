---
import Base from '@layouts/Base.astro'
import ServiceCard from '@components/ServiceCard.astro'
import Testimonials from '@components/Testimonials.astro'
import CTABanner from '@components/CTABanner.astro'
import practice from '@data/practice.json'
import { getCollection } from 'astro:content'

export function getStaticPaths() {
  const areas: string[] = (practice as any).areaServed ?? []
  return areas.map((area) => ({
    params: { location: area.toLowerCase().replace(/[^a-z0-9]+/g, '-') },
    props: { area },
  }))
}

const { area } = Astro.props
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order)
const serviceCategories: string[] = (practice as any).serviceCategories ?? []
const grouped = serviceCategories
  .map((cat) => ({ name: cat, items: services.filter((s) => s.data.category === cat) }))
  .filter((g) => g.items.length)
const tel = practice.phone.replace(/[^+\d]/g, '')
const domain = practice.domain
const reviews = (practice as any).reviews ?? {}
const isHome = area.toLowerCase() === practice.address.city.toLowerCase()
const isCounty = area.toLowerCase().includes('county')
const ST = practice.address.state
const STATE_NAMES: Record<string, string> = { UT: 'Utah', WY: 'Wyoming', NV: 'Nevada', TX: 'Texas', CA: 'California', AZ: 'Arizona', ID: 'Idaho' }
const STATE = STATE_NAMES[ST] || ST
const CITY = practice.address.city
// Per-town drive times / directions can be filled in per practice; empty by default.
const DRIVE: Record<string, string> = {}
const driveTime = DRIVE[area.toLowerCase()]
const lede = isHome
  ? `${practice.name} is proud to be ${area}'s trusted family and cosmetic dental home — right here at ${practice.address.street}.`
  : isCounty
    ? `${practice.name} proudly serves families throughout ${area} from our convenient office in ${CITY}.`
    : `Looking for a dentist near ${area}, ${ST}? ${practice.name} is just ${driveTime || 'a short drive'} away in ${CITY} — an easy trip for ${area} families of all ages.`

const dest = encodeURIComponent(`${practice.address.street}, ${CITY}, ${ST} ${practice.address.zip}`)
const originLabel = isCounty ? CITY : area
const origin = encodeURIComponent(`${originLabel}, ${ST}`)
const mapsApiKey = (practice as any).mapsApiKey || ''
const mapSrc = mapsApiKey
  ? `https://www.google.com/maps/embed/v1/directions?key=${mapsApiKey}&origin=${origin}&destination=${dest}&mode=driving`
  : `https://maps.google.com/maps?saddr=${origin}&daddr=${dest}&output=embed`
const directionsUrl = `https://www.google.com/maps/dir/?api=1&origin=${origin}&destination=${dest}`
const DIRECTIONS: Record<string, string> = {}
const directionsText = DIRECTIONS[area.toLowerCase()]
---

<Base
  title={`Dentist in ${area}, ${ST}`}
  description={`${practice.name} welcomes ${area}, ${STATE} families — general, cosmetic, implant, and orthodontic dentistry. Call ${practice.phone} to schedule.`}
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-secondary text-white">
    <div class="absolute inset-0 bg-gradient-to-r from-secondary via-secondary/90 to-dark/70"></div>
    <div class="container-px relative py-20 lg:py-24">
      <p class="eyebrow text-accent-soft">{area}, {STATE}</p>
      <h1 class="mt-4 max-w-3xl text-4xl sm:text-5xl font-semibold">Your trusted dentist for {area} families</h1>
      <p class="mt-5 max-w-2xl text-lg text-white/80">{lede}</p>
      {driveTime && (
        <p class="mt-5 inline-flex items-center gap-2 rounded-full bg-accent/20 border border-accent/40 px-4 py-2 text-sm font-medium text-white">
          <svg class="w-4 h-4 text-accent-soft" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13l2-5h14l2 5M5 13h14v4a1 1 0 01-1 1h-1a1 1 0 01-1-1v-1H8v1a1 1 0 01-1 1H6a1 1 0 01-1-1v-4z"/></svg>
          Just {driveTime} from {area} to our {CITY} office
        </p>
      )}
      <div class="mt-8 flex flex-col sm:flex-row gap-3">
        <a href="/contact" class="btn btn-gold">Book an appointment</a>
        <a href={`tel:${tel}`} class="btn btn-ghost">Call {practice.phone}</a>
      </div>
      {reviews.count > 0 && <p class="mt-5 text-sm text-white/75">★ {reviews.rating} from {reviews.count.toLocaleString()}+ Google reviews.</p>}
    </div>
  </section>

  <!-- Intro + services -->
  <section class="py-16 sm:py-20">
    <div class="container-px">
      <div class="max-w-3xl reveal">
        <h2 class="text-3xl font-semibold text-dark">Complete dental care, minutes from {area}</h2>
        <p class="mt-4 text-dark/70 leading-relaxed">From routine cleanings and fillings to dental implants, clear aligners, dentures, and sleep apnea treatment, our experienced dentists and team provide comprehensive, comfortable care for {area} patients of every age — with most major insurance accepted, plus Cherry financing and an in-house membership plan.</p>
      </div>
      <!-- Category-tabbed services (keeps the full list browsable without a wall of cards) -->
      <div class="mt-10">
        <div class="flex flex-wrap gap-2" role="tablist" aria-label="Service categories">
          {grouped.map((group, i) => (
            <button
              type="button"
              role="tab"
              data-loc-cat={i}
              aria-selected={i === 0 ? 'true' : 'false'}
              class={`loc-cat rounded-full border px-4 py-2 text-sm font-medium transition-colors ${i === 0 ? 'border-primary bg-primary text-white' : 'border-black/10 bg-white text-dark/70 hover:border-primary/40 hover:text-primary'}`}
            >
              {group.name}
              <span class="ml-1.5 text-xs opacity-60">{group.items.length}</span>
            </button>
          ))}
        </div>
        <div class="relative mt-8">
          {grouped.map((group, i) => (
            <div data-loc-panel={i} class={`loc-panel ${i === 0 ? '' : 'hidden'}`}>
              <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {group.items.map((s) => (
                  <div class="reveal"><ServiceCard title={s.data.title} description={s.data.description} href={`/services/${s.slug}`} category={s.data.category} /></div>
                ))}
              </div>
            </div>
          ))}
        </div>
        <div class="mt-8">
          <a href="/services" class="btn btn-outline">View all {services.length} services →</a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    function prBindLocTabs() {
      var cats = document.querySelectorAll('.loc-cat')
      var panels = document.querySelectorAll('.loc-panel')
      if (!cats.length) return
      cats.forEach(function (btn) {
        if (btn.dataset.bound) return
        btn.dataset.bound = '1'
        btn.addEventListener('click', function () {
          var i = btn.getAttribute('data-loc-cat')
          cats.forEach(function (b) {
            var on = b.getAttribute('data-loc-cat') === i
            b.setAttribute('aria-selected', on ? 'true' : 'false')
            b.classList.toggle('bg-primary', on)
            b.classList.toggle('text-white', on)
            b.classList.toggle('border-primary', on)
            b.classList.toggle('bg-white', !on)
            b.classList.toggle('text-dark/70', !on)
            b.classList.toggle('border-black/10', !on)
          })
          panels.forEach(function (p) { p.classList.toggle('hidden', p.getAttribute('data-loc-panel') !== i) })
        })
      })
    }
    document.addEventListener('astro:page-load', prBindLocTabs)
    if (document.readyState !== 'loading') prBindLocTabs()
    else document.addEventListener('DOMContentLoaded', prBindLocTabs)
  </script>

  <div class="bg-light"><Testimonials limit={3} heading={`What ${area}-area patients say`} /></div>

  <!-- Directions map -->
  <section class="py-16 sm:py-20">
    <div class="container-px grid lg:grid-cols-3 gap-8 items-center">
      <div class="reveal">
        <p class="eyebrow">Easy to find</p>
        <h2 class="mt-4 text-3xl font-semibold text-dark">Directions from {originLabel}</h2>
        <p class="mt-3 text-dark/65">{driveTime ? `Just ${driveTime} from ${area} — ` : ''}we're at {practice.address.street}, {practice.address.city}, {practice.address.state} {practice.address.zip}.</p>
        {directionsText && (
          <p class="mt-4 flex items-start gap-2 text-dark/75 bg-light rounded-xl p-4 text-sm">
            <svg class="w-4 h-4 text-primary mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" /></svg>
            {directionsText}
          </p>
        )}
        <a href={directionsUrl} target="_blank" rel="noopener" class="btn btn-gold mt-5">Get directions ↗</a>
      </div>
      <div class="lg:col-span-2 reveal rounded-2xl overflow-hidden shadow-lg ring-1 ring-black/5 aspect-[16/9]">
        <iframe src={mapSrc} class="w-full h-full" style="border:0" loading="lazy" title={`Directions to ${practice.name} from ${area}`} referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>

  <!-- Local schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Dentist',
    name: `${practice.name} — serving ${area}, ${ST}`,
    url: `https://${domain}/dentist/${area.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`,
    telephone: practice.phone,
    address: { '@type': 'PostalAddress', streetAddress: practice.address.street, addressLocality: practice.address.city, addressRegion: practice.address.state, postalCode: practice.address.zip, addressCountry: 'US' },
    areaServed: { '@type': 'City', name: `${area}, ${ST}` },
    aggregateRating: reviews.count ? { '@type': 'AggregateRating', ratingValue: reviews.rating, reviewCount: reviews.count, bestRating: 5 } : undefined,
  })} />

  <CTABanner title={`${area}'s dentist is ready to see you`} subtitle={`New patients from ${area} are always welcome at ${practice.name}.`} />
</Base>

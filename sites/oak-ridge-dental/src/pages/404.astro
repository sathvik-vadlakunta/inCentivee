---
import Base from '@layouts/Base.astro'
import practice from '@data/practice.json'
const tel = practice.phone.replace(/[^+\d]/g, '')
---
<Base title="Page Not Found" description="Sorry, we couldn't find that page." noindex={true}>
  <section class="bg-primary text-white">
    <div class="max-w-3xl mx-auto px-4 py-24 text-center">
      <p class="text-sm uppercase tracking-widest text-white/70">Error 404</p>
      <h1 class="mt-3 text-4xl font-bold">We couldn't find that page</h1>
      <p class="mt-4 text-white/80">The page may have moved or no longer exists.</p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/" class="bg-white text-primary px-6 py-3 rounded-lg font-semibold">Back home</a>
        <a href="/services" class="border border-white/40 px-6 py-3 rounded-lg font-semibold">Browse services</a>
        <a href={`tel:${tel}`} class="border border-white/40 px-6 py-3 rounded-lg font-semibold">Call {practice.phone}</a>
      </div>
    </div>
  </section>
</Base>

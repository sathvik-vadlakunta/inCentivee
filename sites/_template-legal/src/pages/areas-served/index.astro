---
import Base from '@layouts/Base.astro'
import Hero from '@components/Hero.astro'
import CTABanner from '@components/CTABanner.astro'
import practice from '@data/practice.json'
import { getCollection } from 'astro:content'

const locations = (await getCollection('locations')).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
)
---

<Base title={`Areas We Serve | ${practice.name}`} description={`${practice.name} represents injury clients across ${(practice.areaServed || []).slice(0, 6).join(', ')} and surrounding communities.`}>
  <Hero title="Areas We Serve" subtitle={`Local representation across ${practice.address.state} and the communities we call home.`} />

  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    {locations.length > 0 ? (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {locations.map((loc) => (
          <a href={`/areas-served/${loc.slug}`} class="block border border-gray-200 rounded-xl p-5 hover:border-primary hover:shadow-sm transition">
            <h2 class="font-bold font-heading text-lg">{loc.data.city}, {loc.data.state}</h2>
            <p class="text-sm text-gray-600 mt-1">{loc.data.description}</p>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-gray-600">We serve {(practice.areaServed || []).join(', ')} and surrounding areas. <a href="/contact" class="text-primary font-semibold">Contact us</a> about your case.</p>
    )}
  </section>
  <CTABanner />
</Base>

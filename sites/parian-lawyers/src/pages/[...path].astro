---
import Base from '@layouts/Base.astro'
import CTABanner from '@components/CTABanner.astro'
import practice from '@data/practice.json'
import mirror from '@data/mirror.json'
import { marked } from 'marked'

// Renders every mirrored page from the original site at its ORIGINAL URL (1:1
// parity), in our branded layout with legal schema + bar disclaimers layered on.
export async function getStaticPaths() {
  // Paths that have bespoke, hand-built pages (home, blog, contact, scholarship)
  // are excluded so the catch-all doesn't collide with those routes.
  const exclude = (p: string) =>
    p === '/' ||
    p === '/blog' || p.startsWith('/blog/') ||
    p === '/contact-us' ||
    p === '/scholarship-2021'
  return (mirror as any).pages
    .filter((p: any) => p.path && p.content_md && !exclude(p.path))
    .map((p: any) => ({ params: { path: p.path.replace(/^\//, '') }, props: { page: p } }))
}

const { page } = Astro.props
const tel = practice.phone.replace(/[^+\d]/g, '')
const d = (practice as any).disclaimers || {}
const html = marked.parse(page.content_md)
const h1 = page.h1 || page.title?.split('|')[0].trim() || page.title
const isBlog = page.section === 'blog'

// Deterministic layout variety so the 900 pages don't read as clones.
const sum = [...page.path].reduce((a: number, c: string) => a + c.charCodeAt(0), 0)
const heroVariant = sum % 3
const accent = ['border-primary', 'border-accent', 'border-secondary'][sum % 3]

// Breadcrumb from the URL segments.
const segs = page.path.replace(/^\//, '').split('/').filter(Boolean)
let acc = ''
const crumbs = segs.map((s: string) => {
  acc += '/' + s
  return { name: s.replace(/-/g, ' ').replace(/\b\w/g, (m: string) => m.toUpperCase()), href: acc }
})

const schemaType = isBlog ? 'Article' : 'LegalService'
---

<Base title={page.title || `${h1} | ${practice.name}`} description={page.description || h1}>
  <nav class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-4 text-sm text-gray-500">
    <a href="/" class="hover:text-primary">Home</a>
    {crumbs.map((c: any, i: number) => (
      <span>
        <span class="mx-2">/</span>
        {i === crumbs.length - 1 ? <span class="text-gray-900">{c.name}</span> : <a href={c.href} class="hover:text-primary">{c.name}</a>}
      </span>
    ))}
  </nav>

  {heroVariant === 0 && (
    <header class="bg-dark text-white"><div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <h1 class="text-3xl sm:text-4xl font-bold font-heading">{h1}</h1>
      {page.description && <p class="mt-3 text-lg text-gray-200 max-w-2xl">{page.description}</p>}
      <a href={`tel:${tel}`} class="inline-block mt-5 bg-accent text-dark px-6 py-3 rounded-lg font-semibold">Call {practice.phone}</a>
    </div></header>
  )}
  {heroVariant === 1 && (
    <header class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-9">
      <h1 class="text-3xl sm:text-4xl font-bold font-heading">{h1}</h1>
      {page.description && <p class="mt-3 text-lg text-gray-600">{page.description}</p>}
    </header>
  )}
  {heroVariant === 2 && (
    <header class={`max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-9 border-l-4 ${accent} pl-6 mt-4`}>
      <h1 class="text-3xl sm:text-4xl font-bold font-heading">{h1}</h1>
      {page.description && <p class="mt-3 text-lg text-gray-600">{page.description}</p>}
    </header>
  )}

  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="prose prose-lg max-w-none mt-8" set:html={html} />

    {d.pastResults && <p class="mt-8 text-xs text-gray-500 border-t border-gray-200 pt-4 italic">{d.pastResults}</p>}

    {!isBlog && (
      <div class={`mt-10 bg-gray-50 rounded-xl p-8 text-center border-t-4 ${accent}`}>
        <h3 class="text-xl font-bold font-heading mb-2">Injured? Talk to {practice.name}.</h3>
        <p class="text-gray-600 mb-4">{practice.feePromise} — free, confidential consultation.</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/contact" class="inline-block bg-primary text-white px-6 py-3 rounded-lg font-semibold">Free Consultation</a>
          <a href={`tel:${tel}`} class="inline-block border-2 border-primary text-primary px-6 py-3 rounded-lg font-semibold">Call {practice.phone}</a>
        </div>
      </div>
    )}

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': schemaType,
      ...(isBlog
        ? { headline: h1, description: page.description, author: { '@type': 'Organization', name: practice.name } }
        : { name: `${h1} — ${practice.name}`, telephone: practice.phone, areaServed: (practice.areaServed || []).map((a: string) => ({ '@type': 'City', name: a })) }),
      url: `https://${practice.domain}${page.path}`,
    })} />
  </article>
  <CTABanner />
</Base>

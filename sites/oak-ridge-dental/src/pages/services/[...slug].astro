---
import Base from '@layouts/Base.astro'
import CTABanner from '@components/CTABanner.astro'
import practice from '@data/practice.json'
import testimonials from '@data/testimonials.json'
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
  const services = await getCollection('services')
  return services.map((service) => ({ params: { slug: service.slug }, props: { service, services } }))
}

const { service, services } = Astro.props
const { Content } = await service.render()
const faqs = service.data.faqs || []

// Per-service hero (real practice backgrounds from the asset pack), then category, then default
const SLUG_IMG: Record<string, string> = {
  'dental-implants': '/images/oak/dental-implants-bg.webp',
  'clear-aligners': '/images/oak/clear-aligners-bg.webp',
  'dental-crowns': '/images/oak/dental-crowns-bg.webp',
  'teeth-whitening': '/images/oak/inoffice-whitening-bg.webp',
  'smile-makeover': '/images/oak/smile-makeover-bg.webp',
}
// Distinct hero per category so every service page looks different.
const CAT_IMG: Record<string, string> = {
  'Cosmetic Dentistry': '/images/oak/cosmetic-bg.webp',
  'General Dentistry': '/images/stock/general-dentistry.webp',
  'Pediatric Dentistry': '/images/stock/pediatric-dentistry.webp',
  'Technology': '/images/stock/technology.webp',
  'Restorative Dentistry': '/images/stock/restorative-dentistry.webp',
  'Periodontics': '/images/stock/periodontics.webp',
  'Sedation Dentistry': '/images/stock/sedation-dentistry.webp',
  'Holistic Dentistry': '/images/stock/holistic-dentistry.webp',
  'Orthodontics': '/images/stock/orthodontics.webp',
  'Oral Surgery': '/images/stock/oral-surgery.webp',
  'Endodontics': '/images/stock/endodontics.webp',
}
const heroImg = service.data.image || SLUG_IMG[service.slug] || CAT_IMG[service.data.category] || '/images/stock/hero-office.webp'

const related = services
  .filter((s) => s.data.category === service.data.category && s.slug !== service.slug)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 5)

const tel = practice.phone.replace(/[^+\d]/g, '')
const domain = practice.domain
const featuredReview = testimonials[service.slug.length % testimonials.length]
const financingUrl = (practice as any).financingUrl || '/contact'
---

<Base title={service.data.title} description={service.data.description}>
  <!-- Hero banner with per-service photo -->
  <section class="relative bg-secondary text-white overflow-hidden">
    {heroImg && <img src={heroImg} alt={service.data.title} class="absolute inset-0 w-full h-full object-cover opacity-45 kenburns" />}
    <div class="absolute inset-0 bg-gradient-to-r from-secondary via-secondary/85 to-primary/45"></div>
    <div class="container-px relative flex min-h-[42vh] flex-col justify-end pt-12 pb-14">
      <nav class="text-sm text-white/70">
        <a href="/" class="hover:text-white">Home</a><span class="mx-2">/</span>
        <a href="/services" class="hover:text-white">Services</a><span class="mx-2">/</span>
        <span class="text-white/95">{service.data.title}</span>
      </nav>
      <p class="eyebrow text-accent-soft mt-6">{service.data.category}</p>
      <h1 class="mt-3 max-w-3xl text-4xl sm:text-5xl font-semibold drop-shadow-sm">{service.data.title}</h1>
      <p class="mt-4 max-w-2xl text-lg text-white/85">{service.data.description}</p>
      <div class="mt-7 flex flex-col sm:flex-row gap-3">
        <a href="/contact" class="btn btn-gold">Book this treatment</a>
        <a href={`tel:${tel}`} class="btn btn-ghost">Call {practice.phone}</a>
      </div>
    </div>
  </section>

  <div class="container-px py-14 grid lg:grid-cols-12 gap-10">
    <!-- Main content -->
    <article class="lg:col-span-8">
      <div class="prose-brand">
        <Content />
      </div>

      {faqs.length > 0 && (
        <section class="mt-12">
          <h2 class="text-2xl font-semibold text-dark mb-6">Frequently Asked Questions</h2>
          <div class="space-y-3">
            {faqs.map((faq: { question: string; answer: string }) => (
              <details class="card-soft group p-0">
                <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer font-semibold list-none">
                  {faq.question}
                  <span class="text-primary text-xl transition-transform group-open:rotate-45">+</span>
                </summary>
                <p class="px-5 pb-5 -mt-1 text-dark/65 leading-relaxed">{faq.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )}
    </article>

    <!-- Sticky sidebar -->
    <aside class="lg:col-span-4 space-y-6">
      <div class="card-soft p-6 lg:sticky lg:top-28">
        <h3 class="text-lg font-semibold text-dark">Ready to get started?</h3>
        <p class="mt-2 text-sm text-dark/60">Book your {service.data.title.toLowerCase()} consultation at {practice.name} in {practice.address.city}.</p>
        <a href="/contact" class="btn btn-gold w-full mt-4">Request an appointment</a>
        <a href={`tel:${tel}`} class="btn btn-outline w-full mt-2">{practice.phone}</a>
        <a href={financingUrl} class="mt-3 flex items-center justify-center gap-1.5 text-sm text-primary font-medium hover:underline">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
          Flexible monthly payments with Cherry
        </a>
        {featuredReview && (
          <figure class="mt-5 pt-5 border-t border-black/5">
            <div class="flex gap-0.5 text-accent" aria-label="5 out of 5 stars">
              {[0, 1, 2, 3, 4].map(() => (<svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.27 5.82.85-4.21 4.1.99 5.79L10 14.77 4.8 17.5l.99-5.79-4.21-4.1 5.82-.85z" /></svg>))}
            </div>
            <blockquote class="mt-2 text-sm text-dark/70 italic leading-relaxed">"{featuredReview.quote.length > 180 ? featuredReview.quote.slice(0, 177) + '…' : featuredReview.quote}"</blockquote>
            <figcaption class="mt-2 text-sm font-semibold text-dark">— {featuredReview.name}, <a href="/reviews" class="text-primary font-medium hover:underline">verified patient</a></figcaption>
          </figure>
        )}
        <div class="mt-5 pt-5 border-t border-black/5 text-sm text-dark/60 space-y-1">
          <p class="font-semibold text-dark">Hours</p>
          {practice.hours.map((h: any) => (
            <p class="flex justify-between gap-3"><span>{h.days}</span><span class="text-dark/45">{h.note ? h.note : `${h.open}–${h.close}`}</span></p>
          ))}
        </div>
      </div>

      {related.length > 0 && (
        <div class="card-soft p-6">
          <p class="text-[11px] uppercase tracking-wider text-accent font-semibold mb-3">{service.data.category}</p>
          <ul class="space-y-1.5">
            {related.map((s) => (
              <li><a href={`/services/${s.slug}`} class="text-sm text-dark/70 hover:text-primary flex items-center gap-2"><span class="text-accent">→</span> {s.data.title}</a></li>
            ))}
          </ul>
        </div>
      )}
    </aside>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'MedicalProcedure',
    name: service.data.title,
    description: service.data.description,
    procedureType: service.data.category,
    provider: { '@type': 'Dentist', name: practice.name, telephone: practice.phone, address: { '@type': 'PostalAddress', streetAddress: practice.address.street, addressLocality: practice.address.city, addressRegion: practice.address.state, postalCode: practice.address.zip } },
    url: `https://${domain}/services/${service.slug}`,
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `https://${domain}/` },
      { '@type': 'ListItem', position: 2, name: 'Services', item: `https://${domain}/services` },
      { '@type': 'ListItem', position: 3, name: service.data.title, item: `https://${domain}/services/${service.slug}` },
    ],
  })} />
  {faqs.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq: { question: string; answer: string }) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })),
    })} />
  )}

  <CTABanner />
</Base>

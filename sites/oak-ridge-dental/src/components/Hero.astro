---
interface Props {
  title: string
  subtitle?: string
  eyebrow?: string
  cta?: { label: string; href: string }
}

const { title, subtitle, eyebrow, cta } = Astro.props
---

<section class="relative overflow-hidden bg-secondary text-white">
  <div class="blob" style="width:26rem;height:26rem;background:#6b7882;top:-9rem;right:-5rem;"></div>
  <div class="blob" style="width:18rem;height:18rem;background:#a38f79;bottom:-8rem;left:-4rem;opacity:0.25;"></div>
  <div class="container-px relative py-16 sm:py-20 lg:py-24">
    {eyebrow && <p class="eyebrow text-accent-soft">{eyebrow}</p>}
    <h1 class="mt-4 max-w-3xl text-4xl sm:text-5xl font-semibold">{title}</h1>
    {subtitle && <p class="mt-5 max-w-2xl text-lg text-white/80">{subtitle}</p>}
    {cta && <a href={cta.href} class="btn btn-gold mt-8">{cta.label}</a>}
  </div>
</section>

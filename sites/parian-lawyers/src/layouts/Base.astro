---
import SiteHeader from '@components/SiteHeader.astro'
import SiteFooter from '@components/SiteFooter.astro'
import SchemaMarkup from '@components/SchemaMarkup.astro'
import practice from '@data/practice.json'
import '@/styles/global.css'

interface Props {
  title: string
  description?: string
  image?: string
  noindex?: boolean
}

const { title, description = practice.tagline, image, noindex = false } = Astro.props
const pageTitle = title === practice.name ? title : `${title} | ${practice.name}`
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Light-only design — pin to light so dark-mode visitors don't get a dark UA canvas. -->
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}

    <!-- Brand type: Inter (body) + Georgia (headings, system serif) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <!-- shared enhancement layer: consultation modal, scroll-reveal, polish -->
    <link rel="stylesheet" href="/enhance.css" />

    <SchemaMarkup />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#pr-main" class="pr-skip">Skip to main content</a>
    <SiteHeader />
    <main id="pr-main" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
    <script src="/enhance.js" is:inline defer></script>
  </body>
</html>

---
import Base from '@layouts/Base.astro'
import practice from '@data/practice.json'
const tel = practice.phone.replace(/[^+\d]/g, '')
---
<Base title={`Page Not Found | ${practice.name}`} description="The page you're looking for can't be found.">
  <section class="max-w-2xl mx-auto px-4 py-24 text-center">
    <p class="text-accent font-semibold">404</p>
    <h1 class="text-3xl sm:text-4xl font-bold font-heading mt-2">We couldn't find that page</h1>
    <p class="mt-4 text-gray-600">It may have moved. Try our <a href="/services" class="text-primary font-semibold">practice areas</a> or <a href="/contact" class="text-primary font-semibold">contact us</a> — we're available 24/7.</p>
    <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
      <a href="/" class="inline-block bg-primary text-white px-6 py-3 rounded-lg font-semibold">Back to Home</a>
      <a href={`tel:${tel}`} class="inline-block border-2 border-primary text-primary px-6 py-3 rounded-lg font-semibold">Call {practice.phone}</a>
    </div>
  </section>
</Base>

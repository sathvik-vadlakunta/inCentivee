# Required API keys
ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...

# Google Places API (New) — for verified business data in audit reports
# Enable at: https://console.cloud.google.com/apis/api/places.googleapis.com
GOOGLE_PLACES_API_KEY=AIza...

# Optional: Cloudflare (for hosting llms.txt/robots.txt)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Per-customer Webflow API keys (format: WEBFLOW_KEY_<CUSTOMER_ID_UPPER_WITH_UNDERSCORES>)
# These MUST be set as env vars — never put them in customers.json
WEBFLOW_KEY_HILLTOP_FAMILY_DENTAL=ws-...

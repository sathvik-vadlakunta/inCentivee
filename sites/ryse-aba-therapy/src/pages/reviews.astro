---
import Base from '@layouts/Base.astro'
import practice from '@data/practice.json'
const phoneHref = `tel:${practice.phone.replace(/[^+\d]/g, '')}`
// Real Google "write a review" deep link needs the GBP place_id:
//   https://search.google.com/local/writereview?placeid=PLACE_ID
// Until we have it, fall back to a Google search for the listing.
const reviewUrl = practice.reviews?.googleReviewUrl || 'https://www.google.com/search?q=Ryse+ABA+Therapy+St+George+Utah'
const qr = `https://api.qrserver.com/v1/create-qr-code/?size=220x220&margin=10&data=${encodeURIComponent(reviewUrl)}`
const hasReviews = practice.reviews?.count && practice.reviews.count > 0
---
<Base title="Reviews — Ryse ABA Therapy" description="Read reviews from Southern Utah families and share your own experience with Ryse ABA Therapy.">
  <section class="section-sky py-16 relative overflow-hidden">
    <div class="blob" style="width:340px;height:340px;background:var(--color-sun);top:-90px;left:-60px;opacity:.4;"></div>
    <div class="relative max-w-3xl mx-auto px-4 text-center reveal is-visible">
      <span class="text-accent font-bold uppercase tracking-wide text-sm">Reviews</span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-dark mt-2">What families say about <span class="gradient-text">Ryse</span></h1>
      {hasReviews ? (
        <p class="mt-4 text-lg text-slate-600">⭐ {practice.reviews.rating} from {practice.reviews.count} Google reviews</p>
      ) : (
        <p class="mt-4 text-lg text-slate-600">We're a growing, family-first practice — your review helps other Southern Utah parents find compassionate care.</p>
      )}
    </div>
  </section>

  <!-- Leave a review -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4">
      <div class="card p-8 sm:p-12 grid md:grid-cols-[1fr_auto] gap-8 items-center reveal">
        <div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-dark">Share your experience in 30 seconds</h2>
          <p class="mt-3 text-slate-600">If Ryse has helped your family, a quick Google review means the world — and helps another parent take their first step. Tap the button or scan the code.</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={reviewUrl} target="_blank" rel="noopener" class="btn btn-accent text-lg">⭐ Leave a Google review</a>
            <a href={phoneHref} class="btn btn-ghost text-lg">📞 {practice.phone}</a>
          </div>
        </div>
        <div class="text-center">
          <img src={qr} alt="Scan to leave a Google review" width="160" height="160" class="rounded-xl border border-sky mx-auto" loading="lazy" />
          <p class="mt-2 text-xs text-slate-400">Scan to review</p>
        </div>
      </div>
    </div>
  </section>

  {!hasReviews && (
    <section class="pb-20 bg-white">
      <div class="max-w-3xl mx-auto px-4 text-center reveal">
        <div class="text-5xl mb-3">🌟</div>
        <h3 class="text-xl font-bold text-dark">Be among the first to share your story</h3>
        <p class="mt-2 text-slate-600">As our families share their experiences, their reviews will appear here.</p>
      </div>
    </section>
  )}

  <section class="py-16" style="background:linear-gradient(120deg,var(--color-primary-deep),var(--color-primary));">
    <div class="max-w-2xl mx-auto px-4 text-center text-white reveal">
      <h2 class="text-3xl font-extrabold">Ready to get started?</h2>
      <p class="mt-3 text-white/85">Free insurance check · no waitlist · in your home.</p>
      <a href="/contact" class="btn btn-accent mt-6 text-lg">Get started today</a>
    </div>
  </section>
</Base>

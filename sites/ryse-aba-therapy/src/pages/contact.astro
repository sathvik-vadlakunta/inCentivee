---
import Base from '@layouts/Base.astro'
import Hero from '@components/Hero.astro'
import ContactForm from '@components/ContactForm.astro'
import MapEmbed from '@components/MapEmbed.astro'
import practice from '@data/practice.json'
---

<Base title="Contact Us" description={`Contact ${practice.name} at ${practice.phone}. Located at ${practice.address.street}, ${practice.address.city}, ${practice.address.state}.`}>
  <section class="section-sky relative overflow-hidden py-14 sm:py-16">
    <div class="aurora"></div>
    <div class="blob" style="width:320px;height:320px;background:var(--color-sun);top:-100px;right:-60px;opacity:.4;"></div>
    <div class="relative max-w-3xl mx-auto px-4 text-center">
      <span class="text-accent font-bold uppercase tracking-wide text-sm">Get started</span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-dark mt-2">Let's talk about your <span class="gradient-text">child</span></h1>
      <p class="mt-4 text-lg text-slate-600">Free insurance check · no waitlist · in your home across Southern Utah. We'd love to hear from you.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href={`tel:${practice.phone.replace(/[^+\d]/g, '')}`} class="btn btn-accent text-lg">📞 {practice.phone}</a>
        <a href={`mailto:${practice.email}`} class="btn btn-ghost text-lg">✉️ Email us</a>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Contact Form -->
        <div>
          <h2 class="text-2xl font-bold font-heading mb-6">Request an Appointment</h2>
          <ContactForm />
        </div>

        <!-- Info + Map -->
        <div class="space-y-8">
          <div>
            <h2 class="text-2xl font-bold font-heading mb-4">Visit Us</h2>
            <div class="space-y-3 text-gray-600">
              <p class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span>
                  {practice.address.street && <>{practice.address.street}<br /></>}
                  {practice.address.city}, {practice.address.state} {practice.address.zip}
                </span>
              </p>
              <p class="flex items-center gap-3">
                <svg class="w-5 h-5 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <a href={`tel:${practice.phone.replace(/[^+\d]/g, '')}`} class="text-primary hover:underline font-medium">
                  {practice.phone}
                </a>
              </p>
              {practice.email && (
                <p class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                  <a href={`mailto:${practice.email}`} class="text-primary hover:underline">
                    {practice.email}
                  </a>
                </p>
              )}
            </div>
          </div>

          <div>
            <h3 class="text-lg font-semibold font-heading mb-3">Office Hours</h3>
            <ul class="space-y-1 text-sm text-gray-600">
              {practice.hours.map((h: { days: string; open?: string; close?: string; note?: string }) => (
                <li class="flex justify-between">
                  <span class="font-medium">{h.days}</span>
                  <span>{h.note ? h.note : `${h.open} – ${h.close}`}</span>
                </li>
              ))}
            </ul>
          </div>

          <MapEmbed />
        </div>
      </div>
    </div>
  </section>
</Base>

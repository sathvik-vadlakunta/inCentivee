---
import Base from '@layouts/Base.astro'
import practice from '@data/practice.json'
const tel = practice.phone.replace(/[^+\d]/g, '')

const areas = [
  { t: 'Car Accidents', h: '/carrollton-car-accident-lawyer/', i: 'fa-car-burst' },
  { t: 'Truck Accidents', h: '/carrollton-truck-accident-lawyer/', i: 'fa-truck' },
  { t: 'Motorcycle Accidents', h: '/carrollton-motorcycle-accident-lawyer/', i: 'fa-motorcycle' },
  { t: 'Catastrophic Injury', h: '/carrollton-catastrophic-injury-lawyer/', i: 'fa-hospital' },
  { t: 'Wrongful Death', h: '/carrollton-wrongful-death-lawyer/', i: 'fa-dove' },
  { t: 'Slip & Fall', h: '/carrollton-slip-and-fall-accident-lawyer/', i: 'fa-person-falling' },
  { t: 'Nursing Home Abuse', h: '/carrollton-nursing-home-abuse-lawyer/', i: 'fa-wheelchair' },
  { t: "Workers' Comp", h: '/carrollton-workers-compensation-lawyer/', i: 'fa-helmet-safety' },
  { t: 'Mass Torts', h: '/carrollton-mass-torts-lawyer/', i: 'fa-pills' },
]
const reviews = [
  { q: "Cade fought for me. Fought hard. Wouldn't give up and wouldn't back down. I appreciate him as my lawyer and now as my friend.", w: 'Personal Injury Client' },
  { q: 'Had Cade as my lawyer when I had a really bad car wreck and he got me back tons of money within a couple of months. Great guy that knows how to handle business.', w: 'Car Accident Client' },
  { q: 'Cade kept in touch with me and was truly interested in my case. I would recommend him for most any legal assistance, especially bodily injury.', w: 'Catastrophic Injury Client' },
]
---

<Base title={practice.name} description={practice.tagline}>
  <section class="hero">
    <div class="hero__bg"></div>
    <div class="hero__wrap">
      <img class="hero__cade" src="/wp-content/uploads/2026/02/cade-parian-D36mMTuN-738x1024.png" alt="Cade Parian, Personal Injury Lawyer" loading="eager" />
      <div class="hero__copy">
        <h1>Proven. Personal. <span>Parian.</span></h1>
        <p class="hero__sub">West Georgia's personal injury law firm. The only thing we do is represent injury victims — and there's <strong>no fee unless we win.</strong></p>
        <div class="hero__cta">
          <a href={`tel:${tel}`} class="btn btn--gold"><i class="fas fa-phone"></i> Call 24/7 · {practice.phone}</a>
          <a href="/contact-us/" class="btn btn--ghost">Free Consultation</a>
        </div>
      </div>
      <form class="hero__form" id="hForm">
        <h2>How can we help you?</h2>
        <input name="name" placeholder="Full Name *" required />
        <input name="phone" placeholder="Phone Number *" required />
        <input name="email" type="email" placeholder="Email Address *" required />
        <textarea name="msg" rows="3" placeholder="Tell us what happened"></textarea>
        <button type="submit">Request My Free Consultation</button>
        <p class="ok" id="hOk">Thank you — we'll reach out shortly. For immediate help, call {practice.phone}.</p>
      </form>
    </div>
  </section>

  <section class="stats">
    {[['fa-clock','24/7','Always available'],['fa-scale-balanced','No Fee','Unless we win'],['fa-location-dot','3 Offices','Carrollton · Bremen · Atlanta'],['fa-award','Top 40','Under 40 — National Trial Lawyers']].map(([i,n,s])=>(
      <div class="stat"><i class={`fas ${i}`}></i><strong>{n}</strong><span>{s}</span></div>
    ))}
  </section>

  <section class="sec">
    <div class="sec__head"><span class="ey">What We Do</span><h2>Personal Injury Practice Areas</h2><div class="bar"></div></div>
    <div class="grid">
      {areas.map((a)=>(
        <a class="pa" href={a.h}><i class={`fas ${a.i}`}></i><span>{a.t}</span><em>Learn more →</em></a>
      ))}
    </div>
    <div class="sec__more"><a href="/practice-areas/" class="btn btn--navy">View all practice areas</a></div>
  </section>

  <section class="why">
    <div class="why__in">
      <span class="ey ey--light">Why Parian Lawyers</span>
      <h2>The only thing we do is represent injury victims.</h2>
      <p>You deserve a firm that isn't distracted by other practice areas. We focus on personal injury, we answer 24/7, and you'll have your attorney's direct line — there are no walls between you and your lawyer.</p>
      <a href="/about-us/" class="btn btn--gold">Meet Our Attorneys</a>
    </div>
  </section>

  <section class="sec">
    <div class="sec__head"><span class="ey">Client Testimonials</span><h2>What Our Clients Say</h2><div class="bar"></div></div>
    <div class="tgrid">
      {reviews.map((r)=>(
        <figure class="tcard"><div class="stars">★★★★★</div><blockquote>"{r.q}"</blockquote><figcaption>— {r.w}</figcaption></figure>
      ))}
    </div>
    <div class="sec__more"><a href="/client-testimonials/" class="btn btn--navy">Read more reviews</a></div>
  </section>

  <section class="cta">
    <h2>Injured? Call Cade. Get Paid.</h2>
    <p>Free, confidential consultation — available 24/7, no fee unless we win.</p>
    <a href={`tel:${tel}`} class="btn btn--gold btn--lg"><i class="fas fa-phone"></i> {practice.phone}</a>
  </section>
</Base>

<style>
  .btn{display:inline-flex;align-items:center;gap:8px;font:700 14px 'Inter';text-decoration:none;padding:.9rem 1.4rem;border-radius:10px;transition:transform .2s,box-shadow .2s,background .2s;}
  .btn--gold{background:#c18d15;color:#fff;}.btn--gold:hover{background:#a9790f;transform:translateY(-2px);box-shadow:0 12px 26px rgba(193,141,21,.4);}
  .btn--ghost{border:2px solid rgba(255,255,255,.6);color:#fff;}.btn--ghost:hover{background:rgba(255,255,255,.12);}
  .btn--navy{background:#27314f;color:#fff;}.btn--navy:hover{background:#1a2238;transform:translateY(-2px);}
  .btn--lg{font-size:18px;padding:1.1rem 2rem;}
  .ey{display:block;color:#c18d15;font:800 12px 'Inter';text-transform:uppercase;letter-spacing:.12em;margin-bottom:.4rem;}
  .ey--light{color:#ffb400;}
  h2{font-family:Georgia,serif;color:#27314f;font-size:34px;margin:0;}
  .bar{width:64px;height:3px;background:#c18d15;margin:14px auto 0;}
  .sec__head{text-align:center;max-width:720px;margin:0 auto 40px;}
  .sec{max-width:1200px;margin:0 auto;padding:72px 20px;}
  .sec__more{text-align:center;margin-top:36px;}
  .hero{position:relative;background:#1a2238;color:#fff;overflow:hidden;}
  .hero__bg{position:absolute;inset:0;background:radial-gradient(120% 100% at 70% 0,#2a3760 0,#1a2238 55%,#10162a 100%);}
  .hero__wrap{position:relative;max-width:1280px;margin:0 auto;display:grid;grid-template-columns:300px 1fr 380px;gap:1.5rem;align-items:end;padding:0 20px;min-height:520px;}
  .hero__cade{align-self:end;height:480px;width:auto;object-fit:contain;filter:drop-shadow(0 20px 40px rgba(0,0,0,.4));}
  .hero__copy{align-self:center;padding-bottom:40px;}
  .hero__copy h1{font-family:Georgia,serif;font-size:54px;line-height:1.05;margin:0 0 1rem;}
  .hero__copy h1 span{color:#ffb400;}
  .hero__sub{font-size:18px;color:#cfd6e6;max-width:46ch;line-height:1.6;margin:0 0 1.6rem;}
  .hero__cta{display:flex;gap:.8rem;flex-wrap:wrap;}
  .hero__form{align-self:center;margin:36px 0;background:linear-gradient(160deg,rgba(39,49,79,.92),rgba(20,26,46,.92));backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.1);border-radius:18px;padding:24px;box-shadow:0 30px 70px rgba(0,0,0,.4);}
  .hero__form h2{color:#fff;font-size:22px;margin:0 0 14px;}
  .hero__form input,.hero__form textarea{width:100%;margin-bottom:10px;padding:11px 13px;border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.06);color:#fff;border-radius:9px;font:15px 'Inter';outline:none;}
  .hero__form input::placeholder,.hero__form textarea::placeholder{color:#aeb6cc;}
  .hero__form input:focus,.hero__form textarea:focus{border-color:#ffb400;}
  .hero__form button{width:100%;background:#c18d15;color:#fff;border:0;padding:13px;border-radius:10px;font:800 15px 'Inter';cursor:pointer;transition:.2s;}
  .hero__form button:hover{background:#a9790f;}
  .hero__form .ok{display:none;color:#bbf7d0;font-size:13px;margin:10px 0 0;}
  @media(max-width:1080px){.hero__wrap{grid-template-columns:1fr;}.hero__cade{display:none;}.hero__copy{padding:50px 0 0;}.hero__form{margin-bottom:50px;}}
  .stats{background:#141a2e;display:grid;grid-template-columns:repeat(4,1fr);max-width:1280px;margin:0 auto;}
  @media(max-width:700px){.stats{grid-template-columns:repeat(2,1fr);}}
  .stat{padding:28px;text-align:center;color:#cfd6e6;border-left:1px solid rgba(255,255,255,.06);}
  .stat i{color:#c18d15;font-size:24px;}
  .stat strong{display:block;font-family:Georgia,serif;font-size:28px;color:#fff;margin:8px 0 2px;}
  .stat span{font-size:12.5px;color:#8893ad;}
  .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;}
  @media(max-width:840px){.grid{grid-template-columns:repeat(2,1fr);}}
  @media(max-width:520px){.grid{grid-template-columns:1fr;}}
  .pa{display:flex;flex-direction:column;align-items:flex-start;gap:6px;background:#fff;border:1px solid #eceef1;border-radius:14px;padding:24px;text-decoration:none;transition:transform .25s cubic-bezier(.22,1,.36,1),box-shadow .25s,border-color .25s;}
  .pa:hover{transform:translateY(-5px);box-shadow:0 18px 40px rgba(16,24,40,.12);border-color:#c18d15;}
  .pa i{font-size:26px;color:#c18d15;}
  .pa span{font-family:Georgia,serif;font-size:18px;color:#27314f;}
  .pa em{font-size:13px;color:#9aa6b2;font-style:normal;font-weight:600;}
  .why{background:#27314f;color:#fff;}
  .why__in{max-width:820px;margin:0 auto;padding:72px 20px;text-align:center;}
  .why__in h2{color:#fff;font-size:32px;margin:0 0 1rem;}
  .why__in p{color:#cfd6e6;font-size:17px;line-height:1.7;margin:0 0 1.6rem;}
  .tgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}
  @media(max-width:840px){.tgrid{grid-template-columns:1fr;}}
  .tcard{background:#fff;border:1px solid #eceef1;border-radius:16px;padding:26px;margin:0;box-shadow:0 2px 10px rgba(16,24,40,.05);transition:transform .25s,box-shadow .25s;}
  .tcard:hover{transform:translateY(-4px);box-shadow:0 18px 40px rgba(16,24,40,.12);}
  .tcard .stars{color:#ffb400;font-size:16px;margin-bottom:10px;}
  .tcard blockquote{margin:0 0 14px;color:#3a4250;line-height:1.7;font-size:15px;}
  .tcard figcaption{color:#c18d15;font-weight:700;font-size:14px;}
  .cta{background:linear-gradient(135deg,#c18d15,#a9790f);color:#fff;text-align:center;padding:64px 20px;}
  .cta h2{color:#fff;font-size:34px;margin:0 0 .5rem;}
  .cta p{font-size:17px;opacity:.95;margin:0 0 1.6rem;}
  .cta .btn--gold{background:#fff;color:#a9790f;}.cta .btn--gold:hover{background:#fff;color:#8a6300;}
</style>

<script>
  function w(){var f=document.getElementById('hForm');if(f&&!f.dataset.w){f.dataset.w='1';f.addEventListener('submit',function(e){e.preventDefault();document.getElementById('hOk').style.display='block';f.querySelectorAll('input,textarea,button').forEach(function(x){x.disabled=true;});});}}
  document.addEventListener('astro:page-load',w);w();
</script>

---
import Base from '@layouts/Base.astro'
import CTABanner from '@components/CTABanner.astro'
import practice from '@data/practice.json'
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
  const services = await getCollection('services')
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }))
}

const { service } = Astro.props
const { Content } = await service.render()
const faqs = service.data.faqs || []
const d = (practice as any).disclaimers || {}
const tel = practice.phone.replace(/[^+\d]/g, '')

// ── Anti-cookie-cutter: deterministic layout variety per practice area ──
const sum = [...service.slug].reduce((a, c) => a + c.charCodeAt(0), 0)
const heroVariant = sum % 3        // 0 dark band · 1 split image · 2 accent rule
const heroAspect = ['aspect-[21/9]', 'aspect-[16/9]', 'aspect-[3/2]'][sum % 3]
const ctaFirst = sum % 2 === 0     // alternate whether FAQ or CTA comes first
const accent = ['border-primary', 'border-accent', 'border-secondary'][sum % 3]
---

<Base title={`${service.data.title} | ${practice.name}`} description={service.data.description}>
  <!-- Breadcrumb -->
  <nav class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-4 text-sm text-gray-500">
    <a href="/" class="hover:text-primary">Home</a><span class="mx-2">/</span>
    <a href="/services" class="hover:text-primary">Practice Areas</a><span class="mx-2">/</span>
    <span class="text-gray-900">{service.data.title}</span>
  </nav>

  <!-- Hero — three variants so pages within a category don't look identical -->
  {heroVariant === 0 && (
    <header class="bg-dark text-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <p class="text-accent font-medium text-sm mb-2 uppercase tracking-wide">{service.data.category}</p>
        <h1 class="text-3xl sm:text-4xl font-bold font-heading">{service.data.title}</h1>
        <p class="mt-3 text-lg text-gray-200 max-w-2xl">{service.data.description}</p>
        <a href={`tel:${tel}`} class="inline-block mt-6 bg-accent text-dark px-6 py-3 rounded-lg font-semibold">Call {practice.phone}</a>
      </div>
    </header>
  )}
  {heroVariant === 1 && (
    <header class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 grid md:grid-cols-2 gap-8 items-center">
      <div>
        <p class="text-primary font-medium text-sm mb-2 uppercase tracking-wide">{service.data.category}</p>
        <h1 class="text-3xl sm:text-4xl font-bold font-heading">{service.data.title}</h1>
        <p class="mt-3 text-lg text-gray-600">{service.data.description}</p>
        <a href="/contact" class="inline-block mt-6 bg-primary text-white px-6 py-3 rounded-lg font-semibold">Free Consultation</a>
      </div>
      {service.data.image && <img src={service.data.image} alt={service.data.title} class={`w-full rounded-xl ${heroAspect} object-cover`} loading="eager" />}
    </header>
  )}
  {heroVariant === 2 && (
    <header class={`max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 border-l-4 ${accent} pl-6 mt-4`}>
      <p class="text-secondary font-medium text-sm mb-2 uppercase tracking-wide">{service.data.category}</p>
      <h1 class="text-3xl sm:text-4xl font-bold font-heading">{service.data.title}</h1>
      <p class="mt-3 text-lg text-gray-600">{service.data.description}</p>
    </header>
  )}

  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    {heroVariant !== 1 && service.data.image && (
      <img src={service.data.image} alt={service.data.title} class={`w-full rounded-xl my-8 ${heroAspect} object-cover`} loading="lazy" />
    )}

    <div class="prose prose-lg max-w-none">
      <Content />
    </div>

    {d.pastResults && (
      <p class="mt-8 text-xs text-gray-500 border-t border-gray-200 pt-4 italic">{d.pastResults}</p>
    )}

    {/* FAQ + CTA order alternates per page */}
    {ctaFirst && (
      <div class={`mt-12 bg-gray-50 rounded-xl p-8 text-center border-t-4 ${accent}`}>
        <h3 class="text-xl font-bold font-heading mb-2">Injured? Talk to {practice.name} today.</h3>
        <p class="text-gray-600 mb-4">{practice.feePromise || 'Free consultation — no obligation.'}</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/contact" class="inline-block bg-primary text-white px-6 py-3 rounded-lg font-semibold">Free Consultation</a>
          <a href={`tel:${tel}`} class="inline-block border-2 border-primary text-primary px-6 py-3 rounded-lg font-semibold">Call {practice.phone}</a>
        </div>
      </div>
    )}

    {faqs.length > 0 && (
      <section class="mt-12">
        <h2 class="text-2xl font-bold font-heading mb-6">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {faqs.map((faq: { question: string; answer: string }) => (
            <details class="group border border-gray-200 rounded-lg">
              <summary class="flex items-center justify-between p-4 cursor-pointer font-medium hover:text-primary">
                {faq.question}
                <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
              </summary>
              <div class="px-4 pb-4 text-gray-600">{faq.answer}</div>
            </details>
          ))}
        </div>
        <script type="application/ld+json" set:html={JSON.stringify({
          '@context': 'https://schema.org', '@type': 'FAQPage',
          mainEntity: faqs.map((faq: { question: string; answer: string }) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })),
        })} />
      </section>
    )}

    {!ctaFirst && (
      <div class={`mt-12 bg-gray-50 rounded-xl p-8 text-center border-t-4 ${accent}`}>
        <h3 class="text-xl font-bold font-heading mb-2">Injured? Talk to {practice.name} today.</h3>
        <p class="text-gray-600 mb-4">{practice.feePromise || 'Free consultation — no obligation.'}</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/contact" class="inline-block bg-primary text-white px-6 py-3 rounded-lg font-semibold">Free Consultation</a>
          <a href={`tel:${tel}`} class="inline-block border-2 border-primary text-primary px-6 py-3 rounded-lg font-semibold">Call {practice.phone}</a>
        </div>
      </div>
    )}

    {/* Service + Breadcrumb schema */}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'Service',
      serviceType: service.data.title, name: service.data.title, description: service.data.description,
      provider: { '@type': 'LegalService', name: practice.name, telephone: practice.phone },
      areaServed: (practice.areaServed || []).map((a: string) => ({ '@type': 'City', name: a })),
      url: `https://${practice.domain}/services/${service.slug}`,
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `https://${practice.domain}/` },
        { '@type': 'ListItem', position: 2, name: 'Practice Areas', item: `https://${practice.domain}/services` },
        { '@type': 'ListItem', position: 3, name: service.data.title, item: `https://${practice.domain}/services/${service.slug}` },
      ],
    })} />
  </article>

  <CTABanner />
</Base>

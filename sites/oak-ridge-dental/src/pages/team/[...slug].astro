---
import Base from '@layouts/Base.astro'
import CTABanner from '@components/CTABanner.astro'
import practice from '@data/practice.json'

export function getStaticPaths() {
  return (practice.providers ?? []).map((doc: any) => ({ params: { slug: doc.slug }, props: { doc } }))
}

const { doc } = Astro.props
const tel = practice.phone.replace(/[^+\d]/g, '')
const base = `https://${practice.domain}`
const bio: string[] = doc.bio ?? []
const others = (practice.providers ?? []).filter((d: any) => d.slug !== doc.slug)

const physician = {
  '@context': 'https://schema.org',
  '@type': ['Physician', 'Dentist'],
  '@id': `${base}/team/${doc.slug}#person`,
  name: `${doc.name}, ${doc.credentials}`,
  jobTitle: doc.title,
  url: `${base}/team/${doc.slug}`,
  image: doc.photo ? `${base}${doc.photo}` : undefined,
  description: bio[0] || `${doc.name}, ${doc.credentials} at ${practice.name}.`,
  knowsAbout: doc.specialties,
  worksFor: { '@type': 'Dentist', '@id': `${base}/#dentist`, name: practice.name },
  workLocation: {
    '@type': 'Dentist',
    name: practice.name,
    address: {
      '@type': 'PostalAddress',
      streetAddress: practice.address.street,
      addressLocality: practice.address.city,
      addressRegion: practice.address.state,
      postalCode: practice.address.zip,
    },
  },
}
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${base}/` },
    { '@type': 'ListItem', position: 2, name: 'Our Team', item: `${base}/team` },
    { '@type': 'ListItem', position: 3, name: doc.name, item: `${base}/team/${doc.slug}` },
  ],
}
---
<Base title={`${doc.name}, ${doc.credentials}`} description={bio[0] || `Meet ${doc.name}, ${doc.credentials} — ${doc.title} at ${practice.name} in ${practice.address.city}, ${practice.address.state}.`}>
  <section class="bg-secondary text-white">
    <div class="container-px py-6 text-sm text-white/70">
      <a href="/" class="hover:text-white">Home</a><span class="mx-2">/</span>
      <a href="/team" class="hover:text-white">Our Team</a><span class="mx-2">/</span>
      <span class="text-white/95">{doc.name}</span>
    </div>
  </section>

  <article class="py-14 sm:py-20">
    <div class="container-px grid lg:grid-cols-12 gap-10">
      <!-- Photo + quick facts -->
      <aside class="lg:col-span-4">
        <div class="lg:sticky lg:top-28">
          {doc.photo
            ? <div class="aspect-[4/5] overflow-hidden rounded-3xl bg-cream shadow-lg"><img src={doc.photo} alt={`${doc.name}, ${doc.credentials}`} class="h-full w-full object-cover object-top" /></div>
            : <div class="aspect-[4/5] grid place-items-center rounded-3xl bg-gradient-to-br from-primary to-secondary text-white text-5xl font-semibold">{doc.name.replace(/^Dr\.?\s+/, '').split(' ').map((p: string) => p[0]).slice(0, 2).join('')}</div>}
          <div class="mt-5 card-soft p-5">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-primary">Specialties</h2>
            <div class="mt-2 flex flex-wrap gap-1.5">
              {doc.specialties.map((s: string) => <span class="text-xs bg-primary/10 text-primary px-2.5 py-1 rounded-full">{s}</span>)}
            </div>
            <a href="/contact" class="btn btn-gold w-full mt-4">Book with {doc.name.split(' ')[0]}</a>
            <a href={`tel:${tel}`} class="btn btn-outline w-full mt-2">{practice.phone}</a>
          </div>
        </div>
      </aside>

      <!-- Bio -->
      <div class="lg:col-span-8">
        <p class="eyebrow" data-speakable>Meet your dentist</p>
        <h1 class="mt-3 text-4xl sm:text-5xl font-semibold text-dark">{doc.name}, {doc.credentials}</h1>
        <p class="mt-2 text-lg text-primary font-medium">{doc.title} at {practice.name}</p>
        <div class="prose-brand mt-6" data-speakable>
          {bio.map((para) => <p>{para}</p>)}
        </div>

        {others.length > 0 && (
          <div class="mt-12 border-t border-black/5 pt-8">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-primary mb-4">More of our dentists</h2>
            <div class="flex flex-wrap gap-3">
              {others.map((d: any) => (
                <a href={`/team/${d.slug}`} class="inline-flex items-center gap-3 card-soft p-2 pr-4 hover:text-primary">
                  {d.photo && <img src={d.photo} alt={d.name} class="h-12 w-12 rounded-full object-cover object-top" />}
                  <span class="text-sm font-semibold">{d.name}, {d.credentials}</span>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(physician)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  <CTABanner />
</Base>

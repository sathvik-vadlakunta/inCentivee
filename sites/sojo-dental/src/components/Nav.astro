---
import practice from '@data/practice.json'
import { getCollection } from 'astro:content'

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order)

// Group services by category
const categories = practice.serviceCategories.map((cat: string) => ({
  label: cat,
  services: services.filter((s) => s.data.category === cat),
}))

const currentPath = Astro.url.pathname

// Areas We Serve — drives the location-page dropdown from practice.areaServed.
const areas: string[] = (practice as any).areaServed ?? []
const areaSlug = (a: string) => a.toLowerCase().replace(/[^a-z0-9]+/g, '-')

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About Us', href: '/about' },
  {
    label: 'Our Services',
    href: '/services',
    children: categories.map((cat: { label: string; services: { data: { title: string }; slug: string }[] }) => ({
      label: cat.label,
      href: `/services`,
      children: cat.services.map((s: { data: { title: string }; slug: string }) => ({
        label: s.data.title,
        href: `/services/${s.slug}`,
      })),
    })),
  },
  {
    label: 'Patient Resources',
    href: '/patient-resources',
    children: [
      {
        label: 'Financial Options',
        href: '/patient-resources/financial-options',
        children: [{ label: 'Cherry Financing', href: '/patient-resources/financial-options' }],
      },
      { label: 'Patient Forms', href: '/patient-resources/patient-forms' },
      { label: 'Reviews', href: '/patient-resources/reviews' },
      { label: 'Special Offers', href: '/patient-resources/special-offers' },
      { label: 'Patient Portal', href: practice.patientPortal, external: true },
    ],
  },
  ...(areas.length
    ? [{
        label: 'Areas We Serve',
        href: `/dentist/${areaSlug(areas[0])}`,
        children: areas.map((a) => ({ label: `Dentist in ${a}`, href: `/dentist/${areaSlug(a)}` })),
      }]
    : []),
  { label: 'Blog', href: '/blog' },
  { label: 'Contact Us', href: '/contact' },
]
---

{/* Top Bar - Green */}
<div class="bg-primary w-full">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2.5 flex items-center justify-between">
    <div class="hidden md:flex items-center gap-10">
      <a
        href={`tel:${practice.phone.replace(/[^+\d]/g, '')}`}
        class="flex items-center gap-3 text-dark text-sm font-bold uppercase tracking-wider hover:text-secondary transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        {practice.phone}
      </a>
      <a
        href={practice.maps}
        target="_blank"
        rel="noopener"
        class="flex items-center gap-3 text-dark text-sm font-bold uppercase tracking-wider hover:text-secondary transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        {practice.address.street}, {practice.address.city}, {practice.address.state} {practice.address.zip}
      </a>
    </div>
    <div class="flex items-center gap-4 ml-auto">
      <a
        href={practice.social.google}
        target="_blank"
        rel="noopener"
        class="hidden sm:inline-flex items-center gap-2 text-dark text-sm font-bold uppercase tracking-wider hover:text-secondary transition-colors"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
        </svg>
        Review
      </a>
      <a
        href={practice.maps}
        target="_blank"
        rel="noopener"
        class="hidden sm:inline-flex items-center gap-2 text-dark text-sm font-bold uppercase tracking-wider hover:text-secondary transition-colors"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
        </svg>
        Directions
      </a>
      <a
        href={`tel:${practice.phone.replace(/[^+\d]/g, '')}`}
        class="hidden sm:inline-flex items-center gap-2 text-dark text-sm font-bold uppercase tracking-wider hover:text-secondary transition-colors md:hidden"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        Call Us
      </a>
      <button
        data-action="appointment"
        class="bg-dark text-white px-5 py-2 text-xs font-bold uppercase tracking-widest border-2 border-dark hover:bg-transparent hover:text-dark transition-colors"
        onclick="window.location.href='/contact'"
      >
        Request Appointment
      </button>
    </div>
  </div>
</div>

{/* Main Header - Dark */}
<header class="bg-dark sticky top-0 z-50">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between py-4 lg:py-6">
      {/* Logo */}
      <a href="/" class="shrink-0">
        <img src="/images/logo.webp" alt={practice.name} class="h-12 sm:h-14 lg:h-16 w-auto" />
      </a>

      {/* Desktop Nav */}
      <div class="hidden lg:flex items-center gap-0">
        {navLinks.map((link) => (
          <div class="nav-item group relative">
            <a
              href={link.href}
              class:list={[
                'px-3 xl:px-4 py-6 text-sm font-medium uppercase tracking-wider transition-colors inline-flex items-center gap-1',
                currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                  ? 'text-primary'
                  : 'text-white hover:text-primary',
              ]}
            >
              {link.label}
              {link.children && (
                <svg class="w-3 h-3 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              )}
            </a>
            {/* Level 1 dropdown */}
            {link.children && (
              <div class="dropdown absolute top-full left-0 hidden group-hover:block bg-white shadow-lg border border-gray-200 min-w-[220px] z-50">
                {link.children.map((child: any) => (
                  <div class="sub-item relative group/sub">
                    <a
                      href={child.href}
                      target={child.external ? '_blank' : undefined}
                      rel={child.external ? 'noopener' : undefined}
                      class="flex items-center justify-between px-4 py-2.5 text-sm text-dark hover:text-primary hover:bg-gray-50 transition-colors"
                    >
                      {child.label}
                      {child.children && child.children.length > 0 && (
                        <svg class="w-3 h-3 ml-2 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                        </svg>
                      )}
                    </a>
                    {/* Level 2 flyout */}
                    {child.children && child.children.length > 0 && (
                      <div class="flyout absolute top-0 left-full hidden group-hover/sub:block bg-white shadow-lg border border-gray-200 min-w-[240px] z-50">
                        {child.children.map((grandchild: any) => (
                          <a
                            href={grandchild.href}
                            class="block px-4 py-2.5 text-sm text-dark hover:text-primary hover:bg-gray-50 transition-colors"
                          >
                            {grandchild.label}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>

      {/* Mobile menu button */}
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 text-white hover:text-primary"
        aria-label="Toggle menu"
      >
        <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    {/* Mobile Nav */}
    <div id="mobile-menu" class="hidden lg:hidden pb-6">
      {navLinks.map((link) => (
        link.children ? (
          <details class="group/acc border-b border-white/10">
            <summary class="flex items-center justify-between px-3 py-3 text-sm font-medium uppercase tracking-wider text-white cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              {link.label}
              <svg class="w-4 h-4 transition-transform group-open/acc:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="pb-2">
              <a href={link.href} class="block px-3 py-1.5 text-xs uppercase tracking-wider text-primary hover:text-white">All {link.label} →</a>
              {link.children.map((child: any) => (
                child.children ? (
                  <details class="group/sub">
                    <summary class="flex items-center justify-between px-3 py-2 text-xs uppercase tracking-wider text-gray-300 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                      {child.label}
                      <svg class="w-3.5 h-3.5 transition-transform group-open/sub:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
                    </summary>
                    <div class="pl-5 pb-1">
                      {child.children.map((gc: any) => (
                        <a href={gc.href} class="block px-3 py-1 text-xs text-gray-400 hover:text-primary">{gc.label}</a>
                      ))}
                    </div>
                  </details>
                ) : (
                  <a href={child.href} target={child.external ? '_blank' : undefined} rel={child.external ? 'noopener' : undefined} class="block px-3 py-2 text-xs uppercase tracking-wider text-gray-300 hover:text-primary">{child.label}</a>
                )
              ))}
            </div>
          </details>
        ) : (
          <a href={link.href} class:list={['block px-3 py-3 border-b border-white/10 text-sm font-medium uppercase tracking-wider', currentPath === link.href ? 'text-primary' : 'text-white hover:text-primary']}>{link.label}</a>
        )
      ))}
      <div class="mt-4 px-3 flex flex-col gap-2">
        <a
          href={`tel:${practice.phone.replace(/[^+\d]/g, '')}`}
          class="text-center bg-primary text-dark px-4 py-2.5 font-bold text-sm uppercase tracking-wider"
        >
          Call {practice.phone}
        </a>
        <a
          href="/contact"
          class="text-center border-2 border-primary text-primary px-4 py-2.5 font-bold text-sm uppercase tracking-wider hover:bg-primary hover:text-dark transition-colors"
        >
          Request Appointment
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn')
  const menu = document.getElementById('mobile-menu')
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden')
  })
</script>

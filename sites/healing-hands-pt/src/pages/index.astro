              {r.source === 'Google' && <svg class="w-5 h-5" viewBox="0 0 24 24" aria-label="Google review"><path fill="#4285F4" d="M22.5 12.2c0-.8-.1-1.5-.2-2.2H12v4.2h5.9a5 5 0 0 1-2.2 3.3v2.7h3.6c2.1-1.9 3.2-4.8 3.2-8z"/><path fill="#34A853" d="M12 23c2.9 0 5.4-1 7.2-2.6l-3.6-2.7c-1 .7-2.3 1.1-3.6 1.1-2.8 0-5.1-1.9-6-4.4H2.3v2.8A11 11 0 0 0 12 23z"/><path fill="#FBBC05" d="M6 14.4a6.6 6.6 0 0 1 0-4.2V7.4H2.3a11 11 0 0 0 0 9.8L6 14.4z"/><path fill="#EA4335" d="M12 5.4c1.6 0 3 .5 4.1 1.6l3.1-3.1A11 11 0 0 0 12 1 11 11 0 0 0 2.3 7.4L6 10.2C6.9 7.7 9.2 5.4 12 5.4z"/></svg>}
            </div>
            <blockquote class="text-slate-600 leading-relaxed text-sm line-clamp-6 grow">"{r.text}"</blockquote>
            <figcaption class="mt-4 font-bold text-dark text-sm">{r.author} {(r.when || r.date) && <span class="text-slate-400 font-normal">· {r.when || r.date}</span>}</figcaption>
          </figure>
        ))}
      </div>
      <div class="mt-12 text-center reveal flex flex-wrap justify-center gap-3">
        <a href="/testimonials" class="btn btn-primary">Read more stories</a>
        <a href={reviews.googleReviewUrl} target="_blank" rel="noopener" class="btn btn-ghost">Leave a Google review</a>
      </div>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- 13 · MEET DR. JAMIE -->
  <!-- ============================================================= -->
  <section class="py-20 sm:py-28 section-bone overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-[.85fr_1.15fr] gap-14 items-center">
      <div class="reveal relative">
        <div class="frame-lux aspect-[4/5] max-w-sm mx-auto" transition:name="jamie-portrait">
          <Pic src={provider.photo} alt={`${provider.name}, ${provider.credentials} — owner of Healing Hands Physical Therapy in Reno`} width={420} height={525} sizes="(max-width: 1024px) 80vw, 380px" class="w-full h-full object-cover object-top" />
        </div>
      </div>
      <div class="reveal reveal-delay-1">
        <span class="eyebrow">Meet your doctor</span>
        <h2 class="text-3xl sm:text-[2.6rem] font-extrabold text-dark mt-3">{provider.name}, <span class="text-slate-400 font-bold">{provider.credentials}</span></h2>
        <p class="mt-2 font-semibold text-primary-deep">{provider.title} · Native Nevadan · 15+ years</p>
        <p class="mt-5 text-slate-600 leading-relaxed text-lg">A native Nevadan, Dr. Jamie earned her Doctorate of Physical Therapy and her Manual Therapy Certification (MTC) from the University of St. Augustine. Manual therapy and bodywork have been her passion ever since — and as a natural healer with a deep understanding of body mechanics, she brings over 15 years of hands-on experience to every visit.</p>
        <div class="mt-6 flex flex-wrap gap-2">
          {provider.specialties.map((s) => (<span class="px-3.5 py-1.5 bg-white rounded-full text-sm font-semibold text-primary-deep border border-black/5">{s}</span>))}
        </div>
        <a href="/about" class="btn btn-ghost mt-8">Read Dr. Jamie's full story →</a>
      </div>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- 14 · FAQ -->
  <!-- ============================================================= -->
  <section class="py-20 sm:py-28 section-sand">
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: homeFaqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) })} />
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center reveal">
        <span class="eyebrow">Common questions</span>
        <h2 class="text-3xl sm:text-[2.6rem] font-extrabold text-dark mt-3">Answers for Reno patients</h2>
      </div>
      <div class="mt-12 space-y-3">
        {homeFaqs.map((f) => (
          <details class="card-lux p-5 group reveal">
            <summary class="font-bold text-dark cursor-pointer flex justify-between items-center gap-4">{f.q}<span class="text-primary group-open:rotate-45 transition-transform text-2xl shrink-0">+</span></summary>
            <p class="mt-3 text-slate-600 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="py-20 sm:py-28 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between flex-wrap gap-4 reveal">
          <div><span class="eyebrow">Resources</span><h2 class="text-3xl sm:text-[2.6rem] font-extrabold text-dark mt-3">From our blog</h2></div>
          <a href="/blog" class="btn btn-ghost">Browse all articles →</a>
        </div>
        <div class="mt-12 grid md:grid-cols-3 gap-6">
          {posts.map((p, i) => (
            <a href={`/blog/${p.slug}`} class={`card-lux overflow-hidden reveal reveal-delay-${i+1} group`}>
              <div class="aspect-[16/10] overflow-hidden bg-sand">
                <Pic src={p.data.image} alt={p.data.title} width={520} height={325} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              </div>
              <div class="p-6">
                <span class="text-xs font-bold text-primary uppercase">{p.data.tags?.[0]}</span>
                <h3 class="mt-2 font-bold text-dark leading-snug group-hover:text-primary transition-colors">{p.data.title}</h3>
                <p class="mt-2 text-sm text-slate-500 line-clamp-2">{p.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ============================================================= -->
  <!-- 15 · FINAL CTA -->
  <!-- ============================================================= -->
  <section class="py-24 relative overflow-hidden" style="background:linear-gradient(120deg,var(--color-primary-deep),var(--color-primary));">
    <div class="parallax blob" data-speed="0.4" style="width:380px;height:380px;background:#fff;opacity:.08;top:-90px;right:8%;"></div>
    <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white reveal">
      <h2 class="text-3xl sm:text-5xl font-extrabold leading-tight">The fix you've been looking for.</h2>
      <p class="mt-5 text-white/90 text-lg">Start with a ${pricing.intro.price} intro session — a calm, hands-on hour with Dr. Jamie at our South Reno clinic or in your own home. No insurance gatekeeping, no rushed handoffs.</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href={practice.booking.url} target="_blank" rel="noopener" class="btn bg-white text-primary-deep text-lg">Book your intro session</a>
        <a href={phoneHref} class="btn btn-ghost text-lg" style="background:rgba(255,255,255,.12);color:#fff;border-color:rgba(255,255,255,.4)">📞 {practice.phone}</a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const els = Array.from(document.querySelectorAll('.parallax'));
      if (!els.length) return;
      let ticking = false;
      function update() {
        const vh = window.innerHeight;
        for (const el of els) {
          const speed = parseFloat(el.dataset.speed || '0');
          const rect = el.getBoundingClientRect();
          const center = rect.top + rect.height / 2 - vh / 2;
          el.style.transform = `translate3d(0, ${(-center * speed * 0.12).toFixed(1)}px, 0)`;
        }
        ticking = false;
      }
      function onScroll() { if (!ticking) { requestAnimationFrame(update); ticking = true; } }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', update);
      update();
    })();
  </script>
</Base>

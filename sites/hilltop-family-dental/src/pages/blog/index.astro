---
import Base from '@layouts/Base.astro'
import BlogCard from '@components/BlogCard.astro'
import practice from '@data/practice.json'
import { getCollection } from 'astro:content'

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())

// count tag usage; drop tags that appear on EVERY post (e.g. a location tag) — they don't filter anything
const counts = {}
posts.forEach((p) => (p.data.tags || []).forEach((t) => { counts[t] = (counts[t] || 0) + 1 }))
const titleCase = (s) => s.replace(/\b\w/g, (m) => m.toUpperCase())
const tags = Array.from(new Set(posts.flatMap((p) => p.data.tags || []).filter(Boolean)))
  .filter((t) => counts[t] < posts.length)
  .sort()

const phoneHref = `tel:${practice.phone.replace(/[^+\d]/g, '')}`
const heroImg = '/images/hero-poster.jpg'
---

<Base title="Blog" description={`Dental health guides, treatment explainers, and practice news from ${practice.name} in Casper, Wyoming.`}>
  {/* ─────────── Hero ─────────── */}
  <section class="relative overflow-hidden bg-secondary text-white">
    <div class="absolute inset-0 bg-cover bg-center opacity-25" style={`background-image:url('${heroImg}')`}></div>
    <div class="absolute inset-0" style="background:linear-gradient(115deg, rgba(43,50,54,.6), rgba(60,69,75,.45))"></div>
    <div class="blob" style="width:26rem;height:26rem;background:#6b7882;top:-9rem;right:-5rem;"></div>
    <div class="blob" style="width:18rem;height:18rem;background:#a38f79;bottom:-8rem;left:-4rem;opacity:0.25;"></div>
    <div class="container-px relative py-16 sm:py-20 lg:py-24 text-center">
      <p class="eyebrow text-accent-soft justify-center">Dental Health Library</p>
      <h1 class="mt-4 text-4xl sm:text-5xl lg:text-6xl font-semibold">The Hilltop Family Dentistry blog</h1>
      <p class="mt-5 max-w-2xl mx-auto text-lg text-white/85">Straight answers on implants, Invisalign, sleep apnea, and gentle family dentistry — from our Casper, Wyoming team.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/contact" class="btn btn-gold">Book a visit</a>
        <a href={phoneHref} class="btn btn-ghost">📞 {practice.phone}</a>
      </div>
    </div>
  </section>

  {posts.length === 0 ? (
    <div class="container-px py-24 text-center">
      <p class="text-dark/60 text-lg">New articles are on the way. In the meantime, we'd love to help — give us a call.</p>
      <a href={phoneHref} class="btn btn-gold mt-6">📞 {practice.phone}</a>
    </div>
  ) : (
    <section class="py-14 sm:py-20">
      <div class="container-px">
        {/* search */}
        <div class="relative max-w-xl mx-auto mb-5">
          <svg class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-dark/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M21 21l-4.3-4.3M11 19a8 8 0 100-16 8 8 0 000 16z"/></svg>
          <input id="blSearch" type="search" placeholder="Search articles…  (press / )" autocomplete="off" aria-label="Search articles" class="w-full pl-12 pr-4 py-3.5 rounded-full border border-dark/10 bg-white outline-none text-base transition focus:border-primary focus:ring-4 focus:ring-primary/15" />
        </div>

        {/* category chips */}
        <div id="blCats" class="flex flex-wrap justify-center gap-2 mb-4">
          <button class="chip is-on" data-tag="">All</button>
          {tags.map((t) => (<button class="chip" data-tag={t.toLowerCase()}>{titleCase(t)}</button>))}
        </div>

        {/* result count */}
        <p id="blCount" class="text-center text-sm text-dark/50 mb-8"></p>

        {/* grid */}
        <div id="blGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map((post) => (
            <div
              class="bfilter"
              data-tags={`|${(post.data.tags || []).map((t) => t.toLowerCase()).join('|')}|`}
              data-t={`${post.data.title} ${post.data.description} ${(post.data.tags || []).join(' ')}`.toLowerCase()}
            >
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                href={`/blog/${post.slug}`}
                pubDate={post.data.pubDate}
                image={post.data.image}
                tags={post.data.tags}
              />
            </div>
          ))}
        </div>

        {/* empty state */}
        <div id="blEmpty" class="text-center py-16" hidden>
          <p class="text-dark/60 text-lg">No articles match your search.</p>
          <button id="blReset" class="btn btn-outline mt-5">Clear filters</button>
        </div>

        {/* conversion band */}
        <div class="mt-16 rounded-3xl p-8 sm:p-12 text-center text-white" style="background:linear-gradient(120deg,var(--color-secondary),var(--color-primary))">
          <h2 class="text-2xl sm:text-3xl font-semibold">Ready for dentistry that feels like family?</h2>
          <p class="mt-3 text-white/90">Comfortable, comprehensive care for every age — right here in Casper.</p>
          <div class="mt-6 flex flex-wrap justify-center gap-3">
            <a href="/contact" class="btn bg-white text-secondary hover:bg-white/90">Book a visit</a>
            <a href={phoneHref} class="btn btn-ghost">📞 {practice.phone}</a>
          </div>
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .chip { border: 1px solid color-mix(in srgb, var(--color-primary) 40%, #fff); background: #fff; color: var(--color-secondary); font-weight: 600; font-size: 13px; padding: 7px 15px; border-radius: 999px; cursor: pointer; transition: .15s; white-space: nowrap; }
  .chip:hover { border-color: var(--color-primary); background: color-mix(in srgb, var(--color-primary) 8%, #fff); }
  .chip.is-on { background: var(--color-secondary); color: #fff; border-color: var(--color-secondary); }
</style>

<script is:inline>
  function blInit() {
    const grid = document.getElementById('blGrid')
    if (!grid || grid.dataset.wired) return
    grid.dataset.wired = '1'
    const cards = [].slice.call(grid.querySelectorAll('.bfilter'))
    const empty = document.getElementById('blEmpty')
    const search = document.getElementById('blSearch')
    const catsEl = document.getElementById('blCats')
    const countEl = document.getElementById('blCount')
    const reset = document.getElementById('blReset')
    let q = '', tag = ''

    function setActive() {
      [].forEach.call(catsEl.children, function (x) { x.classList.toggle('is-on', x.dataset.tag === tag) })
    }
    function syncUrl() {
      try {
        const u = new URL(location.href)
        if (tag) u.searchParams.set('tag', tag); else u.searchParams.delete('tag')
        history.replaceState(null, '', u)
      } catch (e) {}
    }
    function apply() {
      let shown = 0
      cards.forEach(function (c) {
        const ok = (!tag || c.dataset.tags.indexOf('|' + tag + '|') > -1) && (!q || c.dataset.t.indexOf(q) > -1)
        c.style.display = ok ? '' : 'none'
        if (ok) shown++
      })
      empty.hidden = shown > 0
      countEl.textContent = shown === cards.length
        ? 'Showing all ' + cards.length + ' article' + (cards.length === 1 ? '' : 's')
        : 'Showing ' + shown + ' of ' + cards.length + ' articles'
    }

    let t
    search.addEventListener('input', function () { clearTimeout(t); t = setTimeout(function () { q = search.value.trim().toLowerCase(); apply() }, 130) })
    catsEl.addEventListener('click', function (e) {
      const b = e.target.closest('button[data-tag]'); if (!b) return
      tag = b.dataset.tag; setActive(); syncUrl(); apply()
    })
    if (reset) reset.addEventListener('click', function () { q = ''; tag = ''; search.value = ''; setActive(); syncUrl(); apply() })
    document.addEventListener('keydown', function (e) {
      if (e.key === '/' && document.activeElement !== search) { e.preventDefault(); search.focus() }
    })

    try {
      const u = new URLSearchParams(location.search).get('tag')
      if (u) { tag = u.toLowerCase(); setActive() }
    } catch (e) {}
    apply()
  }
  document.addEventListener('astro:page-load', blInit)
  blInit()
</script>

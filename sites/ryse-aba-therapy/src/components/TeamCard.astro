---
interface Props {
  name: string
  credentials: string
  title: string
  photo?: string
  specialties?: string[]
  href?: string
}

const { name, credentials, title, photo, specialties = [], href } = Astro.props
const Tag = href ? 'a' : 'div'
---

<Tag href={href} class:list={['block rounded-xl overflow-hidden border border-gray-200', href && 'hover:shadow-lg transition-shadow group']}>
  {photo && (
    <div class="aspect-[3/4] overflow-hidden bg-gray-100">
      <img src={photo} alt={`${name}, ${credentials}`} class:list={['w-full h-full object-cover', href && 'group-hover:scale-105 transition-transform duration-300']} loading="lazy" />
    </div>
  )}
  <div class="p-6">
    <h3 class="text-lg font-semibold font-heading">{name}, {credentials}</h3>
    <p class="text-sm text-primary font-medium">{title}</p>
    {specialties.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {specialties.map((s) => (
          <span class="text-xs bg-primary/10 text-primary px-2 py-0.5 rounded-full">{s}</span>
        ))}
      </div>
    )}
  </div>
</Tag>

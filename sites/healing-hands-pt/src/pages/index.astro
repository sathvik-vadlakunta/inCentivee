---
import Base from '@layouts/Base.astro'
import Pic from '@components/Pic.astro'
import practice from '@data/practice.json'
import testimonials from '@data/testimonials.json'
import { getCollection } from 'astro:content'

const services = practice.serviceCategories
const svcIcons = {
  'physical-therapy': '🤲',
  'manual-therapy': '💪',
  'dry-needling': '🪡',
  'craniosacral-therapy': '🧠',
  'stemwave': '🌊',
  'myofascial-release': '🌀',
  'muscle-energy-technique': '⚙️',
  'cupping': '🟣',
  'visceral-mobilization': '🫁',
}
const conditions = practice.conditions
const provider = practice.providers[0]
const reviews = practice.reviews
const pricing = practice.pricing
const phoneHref = `tel:${practice.phone.replace(/[^+\d]/g, '')}`

const googleReviews = (testimonials as any).google || []
const siteReviews = (testimonials as any).reviews || []

let posts = []
try {
  posts = (await getCollection('blog'))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3)
} catch (e) { posts = [] }

// CONTRAST 1 — Massage vs. real (doctor-performed) bodywork. The premium education hook.
const massageContrast = [
  { label: 'How it feels', massage: 'Relaxing in the moment', us: 'Just as relaxing — calm, unhurried, hands-on' },
  { label: 'What it treats', massage: 'The surface — tight muscles you can feel', us: 'The root cause beneath the symptom' },
  { label: 'Who performs it', massage: 'A massage therapist', us: 'Dr. Jamie — a doctor of physical therapy (DPT, MTC)' },
  { label: 'The toolkit', massage: 'Kneading & general relaxation', us: 'Manual therapy, myofascial release, dry needling, CranioSacral & StemWave' },
  { label: 'The result', massage: 'Feels good for a day or two, then returns', us: 'Lasting change — and a plan to keep you there' },
]

// CONTRAST 2 — Insurance PT vs. concierge (kept, verbatim from §3.5)
const contrast = [
  { label: 'Time with the doctor', insurance: '~15–20 min, shared with 2–4 patients an hour', us: 'A full 60 minutes, one-on-one, every visit' },
  { label: 'Who treats you', insurance: 'Often an aide or tech for much of the visit', us: 'Dr. Jamie (PT, DPT, MTC) — the whole time' },
  { label: 'What you do', insurance: 'Repetitive gym exercises & machines', us: 'Hands-on manual therapy first, then targeted home exercises' },
  { label: 'Who decides your care', insurance: 'Insurance "medical necessity" rules', us: 'You and your doctor' },
  { label: 'Visit cadence', insurance: '2–3 visits a week for weeks', us: 'Fewer, longer visits — often 6–10 total' },
  { label: 'Cost reality', insurance: 'Copays + deductible + possibly denied claims', us: 'Known up front; superbill for out-of-network reimbursement' },
]

const homeFaqs = [
  { q: 'How is this different from a massage?', a: "A massage feels great, but it works on the surface and the relief is usually temporary. Healing Hands is doctor-performed therapeutic bodywork — manual therapy, myofascial release, dry needling, CranioSacral, and StemWave — that is just as relaxing but is designed to find and fix the underlying cause of your pain, then keep you there with a maintenance plan. You leave feeling great AND actually better." },
  { q: 'Is dry needling the same as acupuncture?', a: "No — and this is our most-asked question. Dry needling uses a thin filiform needle to release tight tissue and reach myofascial trigger points within the muscle, based on Western anatomy and pain science. Acupuncture is rooted in Traditional Chinese Medicine and meridian-energy theory. Dry needling is an evidence-based technique physical therapists use to relieve pain and reactivate muscles — it is not acupuncture." },
  { q: 'What is StemWave (sonic / acoustic wave) therapy?', a: "StemWave is a noninvasive, FDA-listed sonic / acoustic wave (shockwave) therapy — the latest, more powerful evolution of shockwave used in medical offices for over 20 years. It uses harmless acoustic waves to increase blood flow, reduce inflammation, and activate your body's natural healing. At Healing Hands it's a quick 10–15 minute add-on layered onto your hands-on session — just ask to add it to your visit." },
  { q: 'How does pricing work?', a: `Most people start with a one-hour intro session ($${pricing.intro.price}) — a real, hands-on working visit where Dr. Jamie treats you and builds a custom plan to fix the root cause. From there she'll recommend the best path: a package of sessions, or the $${pricing.membership.price}/month Maintenance Membership. You can also add StemWave to any visit for $${pricing.stemwaveAddOn.price}. Pricing is always shared up front — no surprise bills. (Prices shown are provisional and confirmed at booking.)` },
  { q: 'What is the Maintenance Membership?', a: `The Maintenance Membership ($${pricing.membership.price}/mo) is for staying ahead of pain once we've fixed the root cause — ongoing tune-ups so the problem doesn't creep back, plus ${pricing.membership.perks[0].toLowerCase()}, a credit toward your first session, same-day access if you tweak something new, and priority booking. The body needs upkeep; the membership keeps you there.` },
  { q: 'Do you take insurance?', a: "We're an out-of-network, private-pay (cash-pay) clinic by design. Not contracting with insurance lets us give every client a full hour of customized, hands-on care that isn't dictated by insurance limits. We provide a superbill you may submit to your insurer for possible out-of-network reimbursement — and because we resolve the root cause in fewer visits, the total cost is often comparable to, or less than, a full course of insurance PT." },
  { q: 'Where are you located and what are your hours?', a: `We're at ${practice.address.street}, ${practice.address.city}, ${practice.address.state} ${practice.address.zip} in South Reno. Hours are ${practice.hoursShort} (closed Wednesday, Saturday, and Sunday). After-hours visits are available upon request. Call or text ${practice.phone}.` },
]
---

<Base title={practice.name} description="A relaxing, doctor-performed alternative to massage and standard PT in South Reno — hands-on bodywork that fixes the root cause for lasting results. Start with a $150 intro session." image="/images/og.jpg">
  <!-- ============================================================= -->
  <!-- 1 · HERO — premium reposition: experience + results, not price -->
  <!-- ============================================================= -->
  <section id="hero" class="relative overflow-hidden section-bone pt-10 pb-24 lg:pt-16">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-[1.05fr_.95fr] gap-12 lg:gap-16 items-center w-full">
      <div class="reveal is-visible">
        <span class="inline-flex items-center gap-2.5 bg-white text-primary-deep font-bold text-xs tracking-wide px-4 py-2 rounded-full shadow-sm mb-7 ring-1 ring-black/5">
          <span class="relative flex h-2 w-2"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-50"></span><span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span></span>
          Concierge bodywork · Cash-pay · South Reno
        </span>
        <h1 class="text-[2.35rem] sm:text-5xl lg:text-[3.5rem] font-extrabold text-dark leading-[1.06] tracking-tight">
          More relaxing than a massage.<br /><span class="gradient-text">More effective than PT.</span><br />The fix you've been looking for.
        </h1>
        <p class="mt-7 text-lg sm:text-xl text-slate-600 max-w-xl leading-relaxed">
          You've tried the rushed, insurance-run PT and the massage that felt great for a day. Healing Hands is different: a calm, unhurried hour of <strong class="text-dark">doctor-performed hands-on bodywork</strong> that finds and fixes the <strong class="text-dark">root cause</strong> of your pain — so the relief actually lasts.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={practice.booking.url} target="_blank" rel="noopener" class="btn btn-accent text-lg">Start with a ${pricing.intro.price} intro session</a>
          <a href={phoneHref} class="btn btn-ghost text-lg">📞 Call / Text</a>
        </div>
        <p class="mt-4 text-sm text-slate-500">A real, hands-on working hour with Dr. Jamie + a custom plan to fix the root cause.</p>
        <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-semibold text-primary-deep">
          {['DPT · Doctor of Physical Therapy', 'MTC · Manual Therapy Certified', '15+ years', 'Best of Sierra Nevada'].map((c) => (
            <span class="inline-flex items-center gap-1.5"><svg class="w-4 h-4 text-mint shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 011.4-1.4l3.1 3.1 6.8-6.8a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>{c}</span>
          ))}
        </div>
        <div class="mt-5">
          <span class="inline-flex items-center gap-2 bg-white text-primary-deep text-xs font-bold px-3.5 py-2 rounded-full shadow-sm ring-1 ring-primary/15">
            <span class="text-base">🐺</span> Proud partner of Nevada Wolf Pack Athletics
          </span>
        </div>
      </div>

      <div class="relative reveal is-visible">
        <div class="frame-lux aspect-[4/5] w-full max-w-md mx-auto kenburns">
          <Pic src="/images/hero.jpg" alt="Close-up of hands-on manual therapy relieving low-back tension — illustrative of the bodywork at Healing Hands Physical Therapy in South Reno" eager={true} width={520} height={650} widths={[420, 520, 760, 1040]} sizes="(max-width: 1024px) 80vw, 460px" class="w-full h-full object-cover object-center" />
        </div>
        <div class="absolute -bottom-4 -left-2 sm:-left-5 bg-white rounded-2xl shadow-lift px-5 py-3 ring-1 ring-black/5">
          {reviews.rating ? (
            <div class="flex items-center gap-3">
              <svg class="w-7 h-7 shrink-0" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.5 12.2c0-.8-.1-1.5-.2-2.2H12v4.2h5.9a5 5 0 0 1-2.2 3.3v2.7h3.6c2.1-1.9 3.2-4.8 3.2-8z"/><path fill="#34A853" d="M12 23c2.9 0 5.4-1 7.2-2.6l-3.6-2.7c-1 .7-2.3 1.1-3.6 1.1-2.8 0-5.1-1.9-6-4.4H2.3v2.8A11 11 0 0 0 12 23z"/><path fill="#FBBC05" d="M6 14.4a6.6 6.6 0 0 1 0-4.2V7.4H2.3a11 11 0 0 0 0 9.8L6 14.4z"/><path fill="#EA4335" d="M12 5.4c1.6 0 3 .5 4.1 1.6l3.1-3.1A11 11 0 0 0 12 1 11 11 0 0 0 2.3 7.4L6 10.2C6.9 7.7 9.2 5.4 12 5.4z"/></svg>
              <div>
                <div class="flex items-center gap-1.5"><span class="font-extrabold text-dark text-lg leading-none">{reviews.rating}</span><span class="text-primary text-sm leading-none">★★★★★</span></div>
                <div class="text-xs text-slate-500 mt-0.5">{reviews.count}+ Google reviews</div>
              </div>
            </div>
          ) : (
            <div class="flex items-center gap-3"><span class="text-2xl">⭐</span><div><div class="font-extrabold text-dark leading-tight">5-star rated</div><div class="text-xs text-slate-500">on Google</div></div></div>
          )}
        </div>
        <div class="absolute -top-3 -right-1 bg-white rounded-2xl shadow-lift px-4 py-2.5 flex items-center gap-2 ring-1 ring-black/5">
          <span class="text-2xl">🏆</span><div class="font-bold text-dark text-sm leading-tight">Best of Sierra<br/>Nevada</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- 1.5 · TRUST STAT BAND — instant credibility (count-up) -->
  <!-- ============================================================= -->
  <section class="bg-white border-y border-sky">
    <div class="max-w-6xl mx-auto px-4 py-7 grid grid-cols-2 md:grid-cols-4 gap-6 text-center stagger">
      <div class="reveal">
        <div class="text-3xl sm:text-4xl font-extrabold gradient-text"><span data-count="15">15</span>+</div>
        <p class="mt-1 text-xs sm:text-sm text-slate-500 font-semibold">Years of manual-therapy experience</p>
      </div>
      <div class="reveal reveal-delay-1">
        <div class="text-3xl sm:text-4xl font-extrabold gradient-text">{reviews.rating || '4.9'}<span class="text-primary text-2xl align-top">★</span></div>
        <p class="mt-1 text-xs sm:text-sm text-slate-500 font-semibold">Average Google rating</p>
      </div>
      <div class="reveal reveal-delay-2">
        <div class="text-3xl sm:text-4xl font-extrabold gradient-text"><span data-count={reviews.count || 86}>{reviews.count || 86}</span>+</div>
        <p class="mt-1 text-xs sm:text-sm text-slate-500 font-semibold">Five-star Google reviews</p>
      </div>
      <div class="reveal reveal-delay-3">
        <div class="text-3xl sm:text-4xl font-extrabold gradient-text"><span data-count="60">60</span> min</div>
        <p class="mt-1 text-xs sm:text-sm text-slate-500 font-semibold">One-on-one with your doctor, every visit</p>
      </div>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- 2 · MASSAGE vs. REAL BODYWORK — the premium education hook -->
  <!-- ============================================================= -->
  <section class="py-20 sm:py-28 bg-white overflow-hidden">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto reveal">
        <span class="eyebrow">It feels like a spa. It works like medicine.</span>
        <h2 class="text-3xl sm:text-[2.6rem] font-extrabold text-dark mt-3 leading-tight">It's not just a massage</h2>
        <p class="mt-5 text-slate-600 text-lg leading-relaxed">A massage relaxes the surface and fades in a day or two. Dr. Jamie's doctor-performed bodywork is just as calming — but it finds and fixes the <strong class="text-dark">root cause</strong> for results that last.</p>
      </div>

      <!-- Desktop -->
      <div class="mt-14 reveal hidden md:block">
        <div class="grid grid-cols-[1fr_1fr_1.15fr] rounded-[2rem] overflow-hidden border border-black/5 bg-white shadow-soft">
          <div class="bg-sand px-6 py-5"></div>
          <div class="bg-sand px-6 py-5 text-center"><div class="text-xs font-bold uppercase tracking-widest text-slate-400">A typical massage</div></div>
          <div class="px-6 py-5 text-center text-white" style="background:linear-gradient(135deg,var(--color-primary),var(--color-primary-deep));"><div class="text-xs font-bold uppercase tracking-widest text-white/80">Healing Hands bodywork</div><div class="text-sm font-extrabold mt-0.5">Doctor-performed</div></div>
          {massageContrast.map((row, i) => (
            <>
              <div class={`px-6 py-5 font-bold text-dark text-sm flex items-center ${i % 2 ? 'bg-bone' : ''}`}>{row.label}</div>
              <div class={`px-6 py-5 text-sm text-slate-500 flex items-center gap-2 ${i % 2 ? 'bg-bone' : ''}`}><span class="text-slate-300 shrink-0">~</span><span>{row.massage}</span></div>
              <div class={`px-6 py-5 text-sm text-dark font-semibold flex items-center gap-2 ${i % 2 ? 'bg-sky/40' : 'bg-sky/25'}`}>
                <svg class="w-4 h-4 text-primary shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 011.4-1.4l3.1 3.1 6.8-6.8a1 1 0 011.4 0z" clip-rule="evenodd"/></svg><span>{row.us}</span>
              </div>
            </>
          ))}
        </div>
      </div>

      <!-- Mobile -->
      <div class="mt-12 space-y-3 reveal md:hidden">
        {massageContrast.map((row) => (
          <div class="card-lux p-5">
            <div class="font-extrabold text-dark text-sm mb-3">{row.label}</div>
            <div class="flex items-start gap-2 text-sm text-slate-500 mb-3 pb-3 border-b border-black/5"><span class="text-slate-300 shrink-0 mt-0.5">~</span><div><span class="block text-[11px] font-bold uppercase tracking-widest text-slate-400 mb-0.5">A massage</span>{row.massage}</div></div>
            <div class="flex items-start gap-2 text-sm font-semibold text-dark"><svg class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 011.4-1.4l3.1 3.1 6.8-6.8a1 1 0 011.4 0z" clip-rule="evenodd"/></svg><div><span class="block text-[11px] font-bold uppercase tracking-widest text-primary-deep mb-0.5">Healing Hands</span>{row.us}</div></div>
          </div>
        ))}
      </div>
      <p class="mt-10 text-center text-slate-500 reveal max-w-xl mx-auto">We don't chase the symptom — we find and fix the <strong class="text-dark">root cause</strong>, then keep you there with simple ongoing maintenance.</p>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- 3 · SIGNATURE TREATMENTS — Dry Needling + StemWave -->
  <!-- ============================================================= -->
  <section class="py-20 sm:py-28 section-sand overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto reveal">
        <span class="eyebrow">Her signature tools</span>
        <h2 class="text-3xl sm:text-[2.6rem] font-extrabold text-dark mt-3">Two treatments people drive across Nevada for</h2>
        <p class="mt-5 text-slate-600 text-lg">Woven into her hands-on sessions — precise, evidence-based, and genuinely relaxing.</p>
      </div>
      <div class="mt-14 grid lg:grid-cols-2 gap-7">
        <!-- Dry needling -->
        <a href="/services/dry-needling" class="card-lux overflow-hidden block group reveal">
          <div class="aspect-[16/10] overflow-hidden">
            <Pic src="/images/services/dry-needling.jpg" alt="Dry needling treatment at Healing Hands Physical Therapy in Reno" width={760} height={475} class="w-full h-full object-cover group-hover:scale-[1.04] transition-transform duration-700" />
          </div>
          <div class="p-7 sm:p-8">
            <span class="eyebrow eyebrow--quiet">Signature · not acupuncture</span>
            <h3 class="text-2xl font-extrabold text-dark mt-2">Dry Needling</h3>
            <p class="mt-3 text-slate-600 leading-relaxed">A thin filiform needle releases tight tissue and reaches the myofascial trigger points hands alone can't — calming overactive muscles and unlocking pain that's been stuck for months. Based on Western anatomy and pain science.</p>
            <span class="mt-5 inline-flex items-center gap-1 text-primary font-bold group-hover:gap-2 transition-all">How dry needling works →</span>
          </div>
        </a>
        <!-- StemWave (add-on framing) -->
        <a href="/services/stemwave" class="card-lux overflow-hidden block group reveal reveal-delay-1">
          <div class="aspect-[16/10] overflow-hidden relative" transition:name="svc-stemwave">
            <Pic src="/images/services/stemwave.jpg" alt="StemWave sonic / acoustic wave therapy at Healing Hands in Reno" width={760} height={475} class="w-full h-full object-cover group-hover:scale-[1.04] transition-transform duration-700" />
            <span class="absolute top-4 left-4 bg-white text-primary-deep text-xs font-extrabold px-3 py-1.5 rounded-full shadow-sm">⚡ Add to your visit · ${pricing.stemwaveAddOn.price}</span>
          </div>
          <div class="p-7 sm:p-8">
            <span class="eyebrow eyebrow--quiet">Signature · sonic / acoustic wave</span>
            <h3 class="text-2xl font-extrabold text-dark mt-2">StemWave Therapy</h3>
            <p class="mt-3 text-slate-600 leading-relaxed">A quick <strong class="text-dark">10–15 minute</strong> sonic / acoustic-wave (shockwave) booster you can add to any session for <strong class="text-dark">${pricing.stemwaveAddOn.price}</strong>. It increases blood flow, calms inflammation, and activates your body's own healing — drug-free, no downtime. Works best layered over a course of hands-on care.</p>
            <span class="mt-5 inline-flex items-center gap-1 text-primary font-bold group-hover:gap-2 transition-all">More on StemWave →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- 4 · INSURANCE PT CONTRAST -->
  <!-- ============================================================= -->
  <section class="py-20 sm:py-28 bg-white overflow-hidden">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto reveal">
        <span class="eyebrow">The difference, side by side</span>
        <h2 class="text-3xl sm:text-[2.6rem] font-extrabold text-dark mt-3">And it's nothing like rushed insurance PT</h2>
        <p class="mt-5 text-slate-600 text-lg">If standard PT didn't fix you, here's exactly why — and what we do instead.</p>
      </div>

      <div class="mt-14 reveal hidden md:block">
        <div class="grid grid-cols-[1.1fr_1fr_1.15fr] rounded-[2rem] overflow-hidden border border-black/5 bg-white shadow-soft">
          <div class="bg-sand px-6 py-5"></div>
          <div class="bg-sand px-6 py-5 text-center"><div class="text-xs font-bold uppercase tracking-widest text-slate-400">Typical insurance PT</div></div>
          <div class="px-6 py-5 text-center text-white" style="background:linear-gradient(135deg,var(--color-primary),var(--color-primary-deep));"><div class="text-xs font-bold uppercase tracking-widest text-white/80">Healing Hands</div><div class="text-sm font-extrabold mt-0.5">Concierge · cash-pay</div></div>
          {contrast.map((row, i) => (
            <>
              <div class={`px-6 py-5 font-bold text-dark text-sm flex items-center ${i % 2 ? 'bg-bone' : ''}`}>{row.label}</div>
              <div class={`px-6 py-5 text-sm text-slate-500 flex items-center gap-2 ${i % 2 ? 'bg-bone' : ''}`}><span class="text-slate-300 shrink-0">✕</span><span>{row.insurance}</span></div>
              <div class={`px-6 py-5 text-sm text-dark font-semibold flex items-center gap-2 ${i % 2 ? 'bg-sky/40' : 'bg-sky/25'}`}>
                <svg class="w-4 h-4 text-primary shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 011.4-1.4l3.1 3.1 6.8-6.8a1 1 0 011.4 0z" clip-rule="evenodd"/></svg><span>{row.us}</span>
              </div>
            </>
          ))}
        </div>
      </div>

      <div class="mt-12 space-y-3 reveal md:hidden">
        {contrast.map((row) => (
          <div class="card-lux p-5">
            <div class="font-extrabold text-dark text-sm mb-3">{row.label}</div>
            <div class="flex items-start gap-2 text-sm text-slate-500 mb-3 pb-3 border-b border-black/5"><span class="text-slate-300 shrink-0 mt-0.5">✕</span><div><span class="block text-[11px] font-bold uppercase tracking-widest text-slate-400 mb-0.5">Insurance PT</span>{row.insurance}</div></div>
            <div class="flex items-start gap-2 text-sm font-semibold text-dark"><svg class="w-4 h-4 text-primary shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 011.4-1.4l3.1 3.1 6.8-6.8a1 1 0 011.4 0z" clip-rule="evenodd"/></svg><div><span class="block text-[11px] font-bold uppercase tracking-widest text-primary-deep mb-0.5">Healing Hands</span>{row.us}</div></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- 5 · BEFORE → AFTER story band (Jeff & Judy, real quotes) -->
  <!-- ============================================================= -->
  <section class="py-20 sm:py-28 section-bone overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto reveal">
        <span class="eyebrow">Real Reno stories</span>
        <h2 class="text-3xl sm:text-[2.6rem] font-extrabold text-dark mt-3">From "they want to operate" to back in the game</h2>
      </div>
      <div class="mt-14 grid md:grid-cols-2 gap-6">
        <figure class="card-lux p-7 sm:p-9 reveal flex flex-col">
          <div class="flex items-center gap-3 mb-5">

---
import Nav from '@components/Nav.astro'
import Footer from '@components/Footer.astro'
import SchemaMarkup from '@components/SchemaMarkup.astro'
import practice from '@data/practice.json'
import { ClientRouter } from 'astro:transitions'
import '@/styles/global.css'

interface Props {
  title: string
  description?: string
  image?: string
  noindex?: boolean
}

const { title, description = practice.tagline, image, noindex = false } = Astro.props
const pageTitle = title === practice.name ? title : `${title} | ${practice.name}`
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL(image || '/og.webp', Astro.site)
// Homepage uses a transparent header over its full-bleed hero; every other page
// uses a solid maroon header so content isn't hidden and the logo always reads.
const isHome = Astro.url.pathname === '/'

const deardocSrc: string = (practice as any).deardocSrc || ''
const tel: string = practice.phone.replace(/[^+\d]/g, '')
const analytics = (practice as any).analytics ?? {}
const ga4: string = analytics.ga4 || ''
const gtm: string = analytics.gtm || ''
const gsc: string = analytics.googleSiteVerification || ''
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="canonical" href={canonicalURL} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {gsc && <meta name="google-site-verification" content={gsc} />}

    {/* Google Analytics 4 — loads only when a measurement ID is configured */}
    {ga4 && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`}></script>
        <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${ga4}');`}></script>
      </>
    )}
    {/* Google Tag Manager — optional */}
    {gtm && (
      <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${gtm}');`}></script>
    )}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <!-- Brand fonts: EB Garamond (serif headings) + Montserrat (body) — matches their site -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500;600;700&family=Montserrat:wght@300;400;500;600;700&display=swap"
    />

    <SchemaMarkup />
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col bg-white pb-14 lg:pb-0">
    {gtm && (
      <noscript set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${gtm}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`}></noscript>
    )}
    <Nav solid={!isHome} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Sticky mobile conversion bar -->
    <div class="mobile-cta fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 lg:hidden">
      <a href={`tel:${tel}`} class="flex items-center justify-center gap-2 bg-secondary py-3.5 text-sm font-semibold text-white">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
        Call us
      </a>
      <a href="/contact" class="flex items-center justify-center gap-2 bg-primary py-3.5 text-sm font-semibold text-white">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
        Book now
      </a>
    </div>

    <!-- Reveal-on-scroll (re-runs after every View Transition navigation) -->
    <script is:inline>
      function prSetupReveal() {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible')
                io.unobserve(e.target)
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
        )
        document.querySelectorAll('.reveal:not(.is-visible)').forEach((el) => io.observe(el))
      }
      // astro:page-load fires on initial load AND after each client-side navigation.
      document.addEventListener('astro:page-load', prSetupReveal)
      // Fallback if View Transitions are unavailable.
      if (document.readyState !== 'loading') prSetupReveal()
      else document.addEventListener('DOMContentLoaded', prSetupReveal)
    </script>
    <!-- Conversion: click-to-call (document-level, survives View Transitions) -->
    <script is:inline>
      document.addEventListener('click', (e) => {
        const a = e.target.closest && e.target.closest('a[href^="tel:"]')
        if (a) {
          window.dataLayer = window.dataLayer || []
          window.dataLayer.push({ event: 'click_to_call' })
        }
      })
    </script>

    {/* DearDoc AI chat widget — the practice's licensed embed.
        The embed self-initialises on the window 'load' event and guards against
        double-init (window.ddChatbot), so it must load once at initial page load,
        NOT be re-injected per navigation. Its widget DOM (#ddc-*) is then carried
        across Astro View Transitions so the bot persists on every page. */}
    {deardocSrc && (
      <>
        <script is:inline src={deardocSrc}></script>
        <script is:inline>
          {`document.addEventListener('astro:before-swap', function (e) {
            document.querySelectorAll('[id^="ddc-"]').forEach(function (el) {
              try { e.newDocument.body.appendChild(el) } catch (err) {}
            })
          })`}
        </script>
      </>
    )}
  </body>
</html>

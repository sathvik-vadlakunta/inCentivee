---
import practice from '@data/practice.json'

const currentYear = new Date().getFullYear()
const tel = practice.phone.replace(/[^+\d]/g, '')
const area = (practice as any).areaServed ?? []
---

<footer class="bg-dark text-white/70">
  <div class="container-px py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      <!-- Brand + contact -->
      <div class="md:col-span-1">
        <img src="/images/oak/logo-white.webp" alt={practice.name} class="h-12 w-auto" />
        <p class="mt-4 text-sm leading-relaxed">{practice.address.street}<br />{practice.address.city}, {practice.address.state} {practice.address.zip}</p>
        <a href={`tel:${tel}`} class="mt-3 inline-block text-accent font-semibold hover:text-white transition-colors">{practice.phone}</a>
        <div class="mt-4 flex gap-3">
          {(practice as any).social?.facebook && (
            <a href={(practice as any).social.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="w-9 h-9 rounded-full bg-white/10 hover:bg-accent hover:text-dark grid place-items-center transition-colors">
              <svg class="w-4.5 h-4.5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z"/></svg>
            </a>
          )}
          {(practice as any).social?.instagram && (
            <a href={(practice as any).social.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="w-9 h-9 rounded-full bg-white/10 hover:bg-accent hover:text-dark grid place-items-center transition-colors">
              <svg class="w-4.5 h-4.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 01-1.38-.9 3.7 3.7 0 01-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zM12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.3-1.46.72-2.12 1.38C1.35 2.68.93 3.35.63 4.14.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.3.79.72 1.46 1.38 2.12.66.66 1.33 1.08 2.12 1.38.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.86 5.86 0 002.12-1.38 5.86 5.86 0 001.38-2.12c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.86 5.86 0 00-1.38-2.12A5.86 5.86 0 0019.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0zm0 5.84A6.16 6.16 0 1018.16 12 6.16 6.16 0 0012 5.84zM12 16a4 4 0 110-8 4 4 0 010 8zm6.41-10.85a1.44 1.44 0 100 2.88 1.44 1.44 0 000-2.88z"/></svg>
            </a>
          )}
        </div>
      </div>

      <!-- Hours -->
      <div>
        <h3 class="text-white text-sm font-semibold uppercase tracking-wider mb-4">Office Hours</h3>
        <ul class="space-y-1.5 text-sm">
          {practice.hours.map((h: { days: string; open?: string; close?: string; note?: string }) => (
            <li class="flex justify-between gap-3">
              <span>{h.days}</span>
              <span class="text-white/45">{h.note ? h.note : `${h.open} – ${h.close}`}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Explore -->
      <div>
        <h3 class="text-white text-sm font-semibold uppercase tracking-wider mb-4">Explore</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/services" class="hover:text-white transition-colors">Our Services</a></li>
          <li><a href="/team" class="hover:text-white transition-colors">Meet the Doctors</a></li>
          <li><a href="/about" class="hover:text-white transition-colors">About Oakridge</a></li>
          <li><a href="/financing" class="hover:text-white transition-colors">Financial Options</a></li>
          <li><a href="/blog" class="hover:text-white transition-colors">Blog</a></li>
          <li><a href="/reviews" class="hover:text-white transition-colors">Reviews</a></li>
          <li><a href="/contact" class="hover:text-white transition-colors">Contact &amp; Directions</a></li>
          {(practice as any).patientPortal && (
            <li><a href={(practice as any).patientPortal} target="_blank" rel="noopener" class="hover:text-white transition-colors">Patient Portal ↗</a></li>
          )}
        </ul>
      </div>

      <!-- Area served (local SEO landing pages) -->
      <div>
        <h3 class="text-white text-sm font-semibold uppercase tracking-wider mb-4">Proudly Serving</h3>
        <ul class="space-y-1.5 text-sm">
          {(area.length ? area : [practice.address.city]).map((a: string) => (
            <li><a href={`/dentist/${a.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} class="hover:text-white transition-colors">Dentist in {a}</a></li>
          ))}
        </ul>
        <a href="/contact" class="btn btn-gold mt-5 !py-2 !px-5 text-sm">Book an Appointment</a>
      </div>
    </div>

    <div class="border-t border-white/10 mt-12 pt-8 flex flex-col sm:flex-row justify-between gap-3 text-sm text-white/45">
      <p>&copy; {currentYear} {practice.name}. All rights reserved.</p>
      <p>Caring for smiles in {practice.address.city}, {practice.address.state === 'UT' ? 'Utah' : practice.address.state}.</p>
    </div>
  </div>
</footer>

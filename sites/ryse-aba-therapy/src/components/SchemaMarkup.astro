---
import practice from '@data/practice.json'

const base = `https://${practice.domain}`
const schema = {
  '@context': 'https://schema.org',
  '@type': ['MedicalBusiness', 'ProfessionalService'],
  '@id': `${base}/#org`,
  name: practice.name,
  description:
    'In-home and community-based ABA (Applied Behavior Analysis) therapy for autism, serving Southern Utah (Washington County). Ages 2-65, no waitlist, BCBA-led, insurance accepted.',
  url: base,
  telephone: practice.phone,
  email: practice.email || undefined,
  image: `${base}/images/logo.webp`,
  logo: `${base}/images/logo.webp`,
  priceRange: '$$',
  // In-home provider — no clinic address; describe the service area instead of a street.
  address: {
    '@type': 'PostalAddress',
    addressLocality: practice.address.city,
    addressRegion: practice.address.state,
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: practice.geo.lat,
    longitude: practice.geo.lng,
  },
  areaServed: (practice.areaServed || []).map((c: string) => ({ '@type': 'City', name: `${c}, UT` })),
  serviceArea: {
    '@type': 'GeoCircle',
    geoMidpoint: { '@type': 'GeoCoordinates', latitude: practice.geo.lat, longitude: practice.geo.lng },
    geoRadius: 70000,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '18:00',
    },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'ABA Therapy Services',
    itemListElement: (practice.serviceCategories || []).map((s: { title: string; slug: string }) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.title, url: `${base}/services/${s.slug}` },
    })),
  },
  sameAs: Object.values(practice.social).filter(Boolean),
}
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

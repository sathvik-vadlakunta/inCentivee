---
import Base from '@layouts/Base.astro'
import practice from '@data/practice.json'
const tel = practice.phone.replace(/[^+\d]/g, '')
const offices = (practice as any).locations || []
---

<Base title="Contact Parian Lawyers" description="Free, confidential consultation — available 24/7. Offices in Carrollton, Bremen, and Atlanta.">
  <div class="ct">
    <div class="ct__head">
      <span class="ey">Get in Touch</span>
      <h1>Contact Parian Lawyers</h1><div class="bar"></div>
      <p>Injured and unsure what to do next? Reach out for a free, confidential consultation — we answer 24/7, and there's no fee unless we win.</p>
    </div>

    <div class="ct__offices">
      {offices.map((o: any, i: number) => (
        <div class="off">
          <span class="off__tag">{i === 0 ? 'Main Office' : 'Office'}</span>
          <h3>{o.label}</h3>
          <p>{o.street}{o.suite ? `, ${o.suite}` : ''}</p>
          <p>{o.city}, {o.state} {o.zip}</p>
          <a class="off__tel" href={`tel:${tel}`}><i class="fas fa-phone"></i> {practice.phone}</a>
          <a class="off__dir" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(o.street + ' ' + o.city + ' ' + o.state + ' ' + o.zip)}`} target="_blank" rel="noopener">Get directions →</a>
        </div>
      ))}
    </div>

    <div class="ct__band">
      <span>Available 24/7 · Free Consultation · No Fee Unless We Win</span>
      <a href={`tel:${tel}`}><i class="fas fa-phone"></i> {practice.phone}</a>
    </div>

    <div class="ct__grid">
      <form class="ct__form" id="ctForm">
        <h2>How can we help you?</h2>
        <label>Full Name *</label><input name="name" required />
        <label>Phone Number *</label><input name="phone" required />
        <label>Email Address *</label><input type="email" name="email" required />
        <label>Tell us what happened</label><textarea name="msg" rows="5"></textarea>
        <button type="submit">Request My Free Consultation</button>
        <p class="ok" id="ctOk">Thank you — we've received your request and will reach out shortly. For immediate help, call {practice.phone}.</p>
      </form>
      <div class="ct__map">
        <iframe loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Parian Lawyers — Carrollton office" src="https://www.google.com/maps?q=314+Bradley+Street+Carrollton+GA+30117&output=embed"></iframe>
        <p>Serving Carrollton, Bremen, Atlanta and communities across West Georgia &amp; metro Atlanta.</p>
      </div>
    </div>
  </div>
</Base>

<style>
  .ct{max-width:1180px;margin:0 auto;padding:56px 20px 76px;}
  .ey{display:block;color:#c18d15;font:800 12px 'Inter';text-transform:uppercase;letter-spacing:.12em;}
  .ct__head{text-align:center;max-width:720px;margin:0 auto 40px;}
  .ct__head h1{font-family:Georgia,serif;font-size:42px;color:#27314f;margin:.4rem 0 0;}
  .bar{width:64px;height:3px;background:#c18d15;margin:14px auto 16px;}
  .ct__head p{color:#5b6472;font-size:17px;}
  .ct__offices{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-bottom:30px;}
  @media(max-width:840px){.ct__offices{grid-template-columns:1fr;}}
  .off{background:#fff;border:1px solid #eceef1;border-radius:16px;padding:24px;box-shadow:0 2px 10px rgba(16,24,40,.05);transition:transform .3s cubic-bezier(.22,1,.36,1),box-shadow .3s;}
  .off:hover{transform:translateY(-4px);box-shadow:0 18px 40px rgba(16,24,40,.12);}
  .off__tag{color:#c18d15;font:800 11px 'Inter';text-transform:uppercase;letter-spacing:.05em;}
  .off h3{font-family:Georgia,serif;color:#27314f;font-size:20px;margin:6px 0 10px;}
  .off p{color:#5b6472;font-size:15px;margin:0 0 4px;}
  .off__tel{display:inline-block;margin-top:10px;color:#27314f;font-weight:700;text-decoration:none;}
  .off__dir{display:block;margin-top:10px;color:#c18d15;font-weight:700;font-size:14px;text-decoration:none;}
  .ct__band{background:linear-gradient(135deg,#27314f,#1a2238);color:#fff;border-radius:18px;padding:24px 30px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:40px;}
  .ct__band span{font:600 14px 'Inter';letter-spacing:.02em;text-transform:uppercase;color:#cfd6e6;}
  .ct__band a{color:#ffb400;font:800 26px Georgia,serif;text-decoration:none;}
  .ct__grid{display:grid;grid-template-columns:1.1fr .9fr;gap:34px;align-items:start;}
  @media(max-width:840px){.ct__grid{grid-template-columns:1fr;}}
  .ct__form{background:#fff;border:1px solid #eceef1;border-radius:18px;padding:28px;box-shadow:0 6px 26px rgba(16,24,40,.08);}
  .ct__form h2{font-family:Georgia,serif;color:#27314f;margin:0 0 6px;font-size:24px;}
  .ct__form label{display:block;font:700 13px 'Inter';color:#27314f;margin:14px 0 6px;}
  .ct__form input,.ct__form textarea{width:100%;padding:12px 14px;border:1px solid #d8dee6;border-radius:10px;font:15px 'Inter';outline:none;transition:border .2s,box-shadow .2s;}
  .ct__form input:focus,.ct__form textarea:focus{border-color:#c18d15;box-shadow:0 0 0 4px rgba(193,141,21,.14);}
  .ct__form button{margin-top:20px;width:100%;background:#c18d15;color:#fff;border:0;padding:15px;border-radius:12px;font:800 16px 'Inter';cursor:pointer;transition:.2s;}
  .ct__form button:hover{background:#a9790f;transform:translateY(-2px);box-shadow:0 12px 26px rgba(193,141,21,.35);}
  .ct__form .ok{display:none;background:#dcfce7;color:#166534;border-radius:10px;padding:14px;font-weight:600;margin-top:14px;}
  .ct__map iframe{width:100%;height:360px;border:0;border-radius:18px;box-shadow:0 6px 26px rgba(16,24,40,.10);}
  .ct__map p{font-size:13px;color:#8a93a0;margin-top:12px;}
</style>

<script>
  function w(){var f=document.getElementById('ctForm');if(f&&!f.dataset.w){f.dataset.w='1';f.addEventListener('submit',function(e){e.preventDefault();document.getElementById('ctOk').style.display='block';f.querySelectorAll('input,textarea,button').forEach(function(x){x.disabled=true;});});}}
  document.addEventListener('astro:page-load',w);w();
</script>

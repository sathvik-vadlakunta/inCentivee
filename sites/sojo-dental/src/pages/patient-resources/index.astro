---
import Base from '@layouts/Base.astro'
import Hero from '@components/Hero.astro'
import CTABanner from '@components/CTABanner.astro'
import practice from '@data/practice.json'
---

<Base title="Patient Resources" description={`Patient resources at ${practice.name}. Access financial options, patient forms, special offers and reviews for dental care in ${practice.address.city}, ${practice.address.state}.`}>
  <Hero title="Patient Resources" subtitle="Everything you need for a seamless dental experience" />

  <section class="py-16 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="text-gray-600 text-lg max-w-3xl mx-auto">
          At {practice.name}, we are committed to making your dental experience seamless from start
          to finish. Dr. Brian Call and Dr. Conner Ogden offer a full suite of patient resources to
          help you feel informed and prepared for your dental care in {practice.address.city}, {practice.address.state}.
          Our resources are regularly updated to reflect the latest dental care standards as of 2026.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {/* Financial Options */}
        <a href="/patient-resources/financial-options" class="group block bg-white p-8 rounded-xl border border-gray-200 shadow-sm hover:shadow-md hover:border-primary/30 transition-all">
          <div class="w-14 h-14 mb-4 bg-primary/10 rounded-xl flex items-center justify-center group-hover:bg-primary/20 transition-colors">
            <svg class="w-7 h-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h2 class="text-xl font-bold font-heading mb-2 group-hover:text-primary transition-colors">Financial Options</h2>
          <p class="text-gray-600 text-sm">Cherry Financing, PPO insurance plans and flexible payment options to make dental care accessible.</p>
        </a>

        {/* Patient Forms */}
        <a href="/patient-resources/patient-forms" class="group block bg-white p-8 rounded-xl border border-gray-200 shadow-sm hover:shadow-md hover:border-primary/30 transition-all">
          <div class="w-14 h-14 mb-4 bg-primary/10 rounded-xl flex items-center justify-center group-hover:bg-primary/20 transition-colors">
            <svg class="w-7 h-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h2 class="text-xl font-bold font-heading mb-2 group-hover:text-primary transition-colors">Patient Forms</h2>
          <p class="text-gray-600 text-sm">Complete your paperwork before your visit through our convenient patient portal.</p>
        </a>

        {/* Special Offers */}
        <a href="/patient-resources/special-offers" class="group block bg-white p-8 rounded-xl border border-gray-200 shadow-sm hover:shadow-md hover:border-primary/30 transition-all">
          <div class="w-14 h-14 mb-4 bg-primary/10 rounded-xl flex items-center justify-center group-hover:bg-primary/20 transition-colors">
            <svg class="w-7 h-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
            </svg>
          </div>
          <h2 class="text-xl font-bold font-heading mb-2 group-hover:text-primary transition-colors">Special Offers</h2>
          <p class="text-gray-600 text-sm">Rotating promotions and specials to help families access quality dental care at a great value.</p>
        </a>

        {/* Reviews */}
        <a href="/patient-resources/reviews" class="group block bg-white p-8 rounded-xl border border-gray-200 shadow-sm hover:shadow-md hover:border-primary/30 transition-all">
          <div class="w-14 h-14 mb-4 bg-primary/10 rounded-xl flex items-center justify-center group-hover:bg-primary/20 transition-colors">
            <svg class="w-7 h-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
            </svg>
          </div>
          <h2 class="text-xl font-bold font-heading mb-2 group-hover:text-primary transition-colors">Reviews</h2>
          <p class="text-gray-600 text-sm">See what our patients are saying about their experience at {practice.name}.</p>
        </a>
      </div>
    </div>
  </section>

  <CTABanner
    title="Questions? We're Here to Help"
    subtitle={`Call ${practice.name} or request an appointment online.`}
  />
</Base>

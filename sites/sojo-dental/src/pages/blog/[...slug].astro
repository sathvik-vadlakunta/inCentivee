---
import Base from '@layouts/Base.astro'
import practice from '@data/practice.json'
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts
    .filter((p) => !p.data.draft)
    .map((post) => ({
      params: { slug: post.slug },
      props: { post },
    }))
}

const { post } = Astro.props
const { Content } = await post.render()
const base = `https://${practice.domain}`
const tel = practice.phone.replace(/[^+\d]/g, '')
const faqs: { question: string; answer: string }[] = post.data.faqs || []
const sources: { title: string; publisher?: string; url: string }[] = post.data.sources || []
const reviewer = (practice.providers || [])[0]
const reviewerName = reviewer ? `${reviewer.name}, ${reviewer.credentials}` : practice.name

const allServices = await getCollection('services')
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')
const related = (post.data.tags || [])
  .map((t: string) => allServices.find((s) => slugify(s.data.title) === slugify(t) || s.data.category === t))
  .filter((s, i, arr): s is (typeof allServices)[number] => Boolean(s) && arr.indexOf(s) === i)
  .slice(0, 4)

const formattedDate = post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate || post.data.pubDate).toISOString(),
  author: { '@type': 'Organization', name: post.data.author || practice.name, url: base },
  reviewedBy: reviewer ? { '@type': 'Person', name: reviewerName, jobTitle: 'Dentist' } : undefined,
  publisher: { '@type': 'Organization', name: practice.name, url: base, logo: { '@type': 'ImageObject', url: `${base}/images/logo.webp` } },
  image: post.data.image ? `${base}${post.data.image}` : `${base}/og.webp`,
  mainEntityOfPage: `${base}/blog/${post.slug}`,
  citation: sources.length ? sources.map((s) => ({ '@type': 'CreativeWork', name: s.title, publisher: s.publisher, url: s.url })) : undefined,
}
const faqSchema =
  faqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
      }
    : null
---

<Base title={post.data.title} description={post.data.description} image={post.data.image}>
  <!-- Breadcrumb -->
  <nav class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-4 text-sm text-gray-500">
    <a href="/" class="hover:text-primary">Home</a>
    <span class="mx-2">/</span>
    <a href="/blog" class="hover:text-primary">Blog</a>
    <span class="mx-2">/</span>
    <span class="text-gray-900 truncate">{post.data.title}</span>
  </nav>

  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <header class="mb-8">
      <h1 class="mt-2 text-3xl sm:text-4xl font-bold font-heading" data-speakable>{post.data.title}</h1>
      <p class="mt-3 text-lg text-gray-600" data-speakable>{post.data.description}</p>
      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-500">
        <time>{formattedDate}</time>
        <span class="hidden sm:inline">·</span>
        <span>Medically reviewed by {reviewerName}</span>
      </div>
      {post.data.tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {post.data.tags.map((tag: string) => (
            <span class="text-xs bg-primary/10 text-primary px-2.5 py-1 rounded-full uppercase tracking-wider">{tag}</span>
          ))}
        </div>
      )}
    </header>

    {post.data.image && (
      <img src={post.data.image} alt={post.data.title} class="w-full rounded-xl mb-8 aspect-[21/9] object-cover" />
    )}

    <div class="prose prose-lg max-w-none prose-a:text-primary prose-headings:font-heading">
      <Content />
    </div>

    {faqs.length > 0 && (
      <section class="mt-12">
        <h2 class="text-2xl font-bold font-heading mb-5">Frequently asked questions</h2>
        <div class="space-y-3">
          {faqs.map((f) => (
            <details class="group rounded-lg border border-gray-200 p-0">
              <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer font-semibold list-none [&::-webkit-details-marker]:hidden">
                {f.question}
                <span class="text-primary text-xl transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="px-5 pb-5 -mt-1 text-gray-600 leading-relaxed">{f.answer}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    {sources.length > 0 && (
      <section class="mt-12 border-t border-gray-200 pt-8">
        <h2 class="text-lg font-bold font-heading">Sources &amp; references</h2>
        <p class="mt-1 text-sm text-gray-500">This article is informational and reviewed by our clinical team. It draws on guidance from the following authoritative organizations:</p>
        <ol class="mt-4 space-y-2 text-sm">
          {sources.map((s, i) => (
            <li class="flex gap-2">
              <span class="text-primary font-semibold">{i + 1}.</span>
              <a href={s.url} target="_blank" rel="noopener nofollow" class="text-gray-700 hover:text-primary">
                {s.publisher && <span class="font-medium">{s.publisher}.</span>} {s.title} ↗
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}

    {related.length > 0 && (
      <section class="mt-12 rounded-lg border border-gray-200 p-7">
        <p class="text-[11px] uppercase tracking-wider text-primary font-semibold">Related treatments</p>
        <div class="mt-3 grid sm:grid-cols-2 gap-2">
          {related.map((s) => (
            <a href={`/services/${s.slug}`} class="flex items-center gap-2 text-sm text-gray-700 hover:text-primary py-1"><span class="text-primary">→</span> {s.data.title}</a>
          ))}
        </div>
      </section>
    )}

    <div class="mt-10 rounded-xl bg-primary/5 border border-primary/20 p-7 text-center">
      <h2 class="text-xl font-bold font-heading">Have questions about your smile?</h2>
      <p class="mt-2 text-gray-600">Our team in {practice.address.city} is happy to help. New patients are always welcome.</p>
      <div class="mt-5 flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/contact" class="inline-block bg-primary text-dark px-6 py-3 font-bold text-sm uppercase tracking-wider">Request an appointment</a>
        <a href={`tel:${tel}`} class="inline-block border-2 border-primary text-primary px-6 py-3 font-bold text-sm uppercase tracking-wider hover:bg-primary hover:text-dark transition-colors">Call {practice.phone}</a>
      </div>
    </div>

    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </article>
</Base>

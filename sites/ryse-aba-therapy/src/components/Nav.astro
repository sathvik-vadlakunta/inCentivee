---
import practice from '@data/practice.json'
const services = practice.serviceCategories
const areas = practice.areaServed
const slug = (a) => a.toLowerCase().replace(/[^a-z]+/g, '-').replace(/^-|-$/g, '')
const path = Astro.url.pathname
const phoneHref = `tel:${practice.phone.replace(/[^+\d]/g, '')}`
const isOn = (h) => h !== '/' && path.startsWith(h)
---
<header id="nav" class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-sky transition-shadow">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between py-3">
    <a href="/" class="flex items-center shrink-0">
      <img src="/images/logo.webp" alt="Ryse ABA Therapy" class="h-16 sm:h-[4.5rem] w-auto" onerror="this.outerHTML='<span class=&quot;text-xl font-extrabold font-heading text-dark&quot;>Ryse<span class=&quot;text-primary&quot;> ABA</span></span>'" />
    </a>

    <div class="hidden lg:flex items-center gap-1">
      <!-- Services dropdown -->
      <div class="relative group">
        <a href="/services" class:list={['flex items-center gap-1 px-3 py-2 rounded-lg text-sm font-semibold transition-colors', isOn('/services') ? 'text-primary bg-sky' : 'text-slate-600 group-hover:text-primary group-hover:bg-sky']}>
          Services <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" d="M19 9l-7 7-7-7"/></svg>
        </a>
        <div class="absolute left-0 top-full pt-2 w-72 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200">
          <div class="bg-white rounded-2xl shadow-xl border border-sky p-2">
            {services.map((s) => (
              <a href={`/services/${s.slug}`} class="block px-3 py-2.5 rounded-xl hover:bg-sky">
                <div class="font-semibold text-dark text-sm">{s.title}</div>
                <div class="text-xs text-slate-500 line-clamp-1">{s.summary}</div>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Areas We Serve dropdown -->
      <div class="relative group">
        <a href="/locations" class:list={['flex items-center gap-1 px-3 py-2 rounded-lg text-sm font-semibold transition-colors', isOn('/locations') ? 'text-primary bg-sky' : 'text-slate-600 group-hover:text-primary group-hover:bg-sky']}>
          Areas We Serve <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" d="M19 9l-7 7-7-7"/></svg>
        </a>
        <div class="absolute left-0 top-full pt-2 w-60 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200">
          <div class="bg-white rounded-2xl shadow-xl border border-sky p-2 grid grid-cols-1">
            {areas.map((a) => (
              <a href={`/locations/${slug(a)}`} class="flex items-center gap-2 px-3 py-2 rounded-xl hover:bg-sky text-sm font-semibold text-slate-700"><span>📍</span>{a}, UT</a>
            ))}
          </div>
        </div>
      </div>

      <a href="/blog" class:list={['px-3 py-2 rounded-lg text-sm font-semibold transition-colors', isOn('/blog') ? 'text-primary bg-sky' : 'text-slate-600 hover:text-primary hover:bg-sky']}>Blog</a>
      <a href="/about" class:list={['px-3 py-2 rounded-lg text-sm font-semibold transition-colors', isOn('/about') ? 'text-primary bg-sky' : 'text-slate-600 hover:text-primary hover:bg-sky']}>About</a>
      <a href="/careers" class:list={['px-3 py-2 rounded-lg text-sm font-semibold transition-colors', isOn('/careers') ? 'text-primary bg-sky' : 'text-slate-600 hover:text-primary hover:bg-sky']}>Join Our Team</a>
      <a href={practice.social.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="p-2 rounded-lg text-slate-500 hover:text-accent hover:bg-sky transition-colors">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.3 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .3-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.3-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.3 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 1.8c-3.1 0-3.5 0-4.7.1-1.1.1-1.7.2-2.1.4-.5.2-.9.4-1.2.8-.4.3-.6.7-.8 1.2-.2.4-.3 1-.4 2.1C2.8 9.6 2.8 10 2.8 12s0 2.4.1 3.6c.1 1.1.2 1.7.4 2.1.2.5.4.9.8 1.2.3.4.7.6 1.2.8.4.2 1 .3 2.1.4 1.2.1 1.6.1 4.7.1s3.5 0 4.7-.1c1.1-.1 1.7-.2 2.1-.4.5-.2.9-.4 1.2-.8.4-.3.6-.7.8-1.2.2-.4.3-1 .4-2.1.1-1.2.1-1.6.1-3.6s0-2.4-.1-3.6c-.1-1.1-.2-1.7-.4-2.1-.2-.5-.4-.9-.8-1.2-.3-.4-.7-.6-1.2-.8-.4-.2-1-.3-2.1-.4-1.2-.1-1.6-.1-4.7-.1zm0 3.1a4.9 4.9 0 110 9.8 4.9 4.9 0 010-9.8zm0 8.1a3.2 3.2 0 100-6.4 3.2 3.2 0 000 6.4zm6.2-8.3a1.1 1.1 0 11-2.3 0 1.1 1.1 0 012.3 0z"/></svg>
      </a>
      <a href="/contact" class="btn btn-accent ml-2 text-sm py-2.5">Get Started — No Waitlist</a>
    </div>

    <button id="menu-btn" class="lg:hidden p-2 rounded-lg text-slate-700 hover:bg-sky" aria-label="Menu">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </nav>

  <div id="mobile-menu" class="lg:hidden hidden border-t border-sky bg-white px-4 py-3 space-y-1 max-h-[80vh] overflow-y-auto">
    <details class="group">
      <summary class="flex justify-between items-center px-3 py-2.5 rounded-lg font-semibold text-slate-700 cursor-pointer">Services <span class="group-open:rotate-180 transition-transform">▾</span></summary>
      <div class="pl-3">{services.map((s) => (<a href={`/services/${s.slug}`} class="block px-3 py-2 rounded-lg text-sm text-slate-600 hover:bg-sky">{s.title}</a>))}</div>
    </details>
    <details class="group">
      <summary class="flex justify-between items-center px-3 py-2.5 rounded-lg font-semibold text-slate-700 cursor-pointer">Areas We Serve <span class="group-open:rotate-180 transition-transform">▾</span></summary>
      <div class="pl-3">{areas.map((a) => (<a href={`/locations/${slug(a)}`} class="block px-3 py-2 rounded-lg text-sm text-slate-600 hover:bg-sky">📍 {a}, UT</a>))}</div>
    </details>
    <a href="/blog" class="block px-3 py-2.5 rounded-lg font-semibold text-slate-700 hover:bg-sky">Blog</a>
    <a href="/about" class="block px-3 py-2.5 rounded-lg font-semibold text-slate-700 hover:bg-sky">About</a>
    <a href="/careers" class="block px-3 py-2.5 rounded-lg font-semibold text-slate-700 hover:bg-sky">Join Our Team</a>
    <a href={practice.social.instagram} target="_blank" rel="noopener" class="block px-3 py-2.5 rounded-lg font-semibold text-slate-700 hover:bg-sky">📸 Instagram</a>
    <a href="/contact" class="btn btn-accent w-full justify-center mt-2">Get Started — No Waitlist</a>
    <a href={phoneHref} class="block text-center mt-2 font-bold text-primary">{practice.phone}</a>
  </div>
</header>
<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
  const nav = document.getElementById('nav');
  const onScroll = () => nav?.classList.toggle('shadow-lg', window.scrollY > 10);
  window.addEventListener('scroll', onScroll); onScroll();
</script>

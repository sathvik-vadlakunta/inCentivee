---
import Base from '@layouts/Base.astro'
import CTABanner from '@components/CTABanner.astro'
import practice from '@data/practice.json'
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
  const locations = await getCollection('locations')
  return locations.map((loc) => ({ params: { slug: loc.slug }, props: { loc } }))
}

const { loc } = Astro.props
const { Content } = await loc.render()
const tel = practice.phone.replace(/[^+\d]/g, '')
const d = (practice as any).disclaimers || {}
const cityName = `${loc.data.city}, ${loc.data.state}`
const h1 = loc.data.title || `${practice.practiceType || 'Injury Lawyer'} in ${loc.data.city}`

// Anti-cookie-cutter: deterministic layout variety per city page.
const sum = [...loc.slug].reduce((a, c) => a + c.charCodeAt(0), 0)
const v = sum % 3
const accent = ['border-primary', 'border-accent', 'border-secondary'][sum % 3]
const areas = loc.data.practiceAreas || []
---

<Base title={`${h1} | ${practice.name}`} description={loc.data.description}>
  <nav class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-4 text-sm text-gray-500">
    <a href="/" class="hover:text-primary">Home</a><span class="mx-2">/</span>
    <a href="/areas-served" class="hover:text-primary">Areas We Serve</a><span class="mx-2">/</span>
    <span class="text-gray-900">{cityName}</span>
  </nav>

  {/* Three hero treatments so city pages don't read as clones */}
  {v === 0 && (
    <header class="bg-dark text-white"><div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <h1 class="text-3xl sm:text-4xl font-bold font-heading">{h1}</h1>
      <p class="mt-3 text-lg text-gray-200 max-w-2xl">{loc.data.description}</p>
      <a href={`tel:${tel}`} class="inline-block mt-6 bg-accent text-dark px-6 py-3 rounded-lg font-semibold">Call {practice.phone}</a>
    </div></header>
  )}
  {v === 1 && (
    <header class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <p class="text-primary font-medium text-sm uppercase tracking-wide">Serving {cityName}</p>
      <h1 class="text-3xl sm:text-4xl font-bold font-heading mt-1">{h1}</h1>
      <p class="mt-3 text-lg text-gray-600">{loc.data.description}</p>
      {loc.data.driveTime && <p class="mt-2 text-sm text-gray-500">{loc.data.driveTime}{loc.data.nearbyOffice ? ` from our ${loc.data.nearbyOffice} office` : ''}.</p>}
    </header>
  )}
  {v === 2 && (
    <header class={`max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 border-l-4 ${accent} pl-6 mt-4`}>
      <h1 class="text-3xl sm:text-4xl font-bold font-heading">{h1}</h1>
      <p class="mt-3 text-lg text-gray-600">{loc.data.description}</p>
    </header>
  )}

  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="prose prose-lg max-w-none mt-8"><Content /></div>

    {areas.length > 0 && (
      <section class="mt-10">
        <h2 class="text-2xl font-bold font-heading mb-4">How we help in {loc.data.city}</h2>
        <div class={`grid sm:grid-cols-2 gap-3 ${v === 1 ? '' : 'sm:grid-cols-3'}`}>
          {areas.map((a: string) => (
            <a href={`/services/${a.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`}
               class={`block border ${accent} rounded-lg p-4 hover:bg-gray-50 transition-colors font-medium`}>{a}</a>
          ))}
        </div>
      </section>
    )}

    <div class="mt-12 bg-gray-50 rounded-xl p-8 text-center">
      <h3 class="text-xl font-bold font-heading mb-2">Injured in {loc.data.city}? Talk to {practice.name}.</h3>
      <p class="text-gray-600 mb-4">{practice.feePromise || 'Free consultation — no obligation.'}</p>
      <a href="/contact" class="inline-block bg-primary text-white px-6 py-3 rounded-lg font-semibold">Free Consultation</a>
    </div>

    {d.pastResults && <p class="mt-8 text-xs text-gray-500 italic">{d.pastResults}</p>}

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'LegalService',
      name: `${practice.name} — ${cityName}`, telephone: practice.phone,
      areaServed: { '@type': 'City', name: cityName },
      url: `https://${practice.domain}/areas-served/${loc.slug}`,
    })} />
  </article>
  <CTABanner />
</Base>

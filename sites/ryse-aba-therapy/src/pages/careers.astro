---
import Base from '@layouts/Base.astro'
import practice from '@data/practice.json'
const phoneHref = `tel:${practice.phone.replace(/[^+\d]/g, '')}`
const applyHref = `mailto:${practice.email}?subject=Careers at Ryse ABA Therapy`
const roles = [
  { icon: '🧩', t: 'Registered Behavior Technician (RBT)', d: "Work 1:1 with children in their homes and community, implementing individualized ABA programs under BCBA supervision. We'll support your RBT certification." },
  { icon: '🎓', t: 'Board Certified Behavior Analyst (BCBA)', d: 'Design and oversee individualized treatment plans, supervise technicians, and partner with families — with the autonomy and support to do your best clinical work.' },
  { icon: '💛', t: 'Always growing', d: "Even if you don't see your exact role, we love meeting compassionate people who want to make a difference. Reach out." },
]
const perks = ['Family-first culture', 'In-home & community-based work', 'BCBA mentorship & supervision', 'Make a real difference, daily', 'Serving Southern Utah', 'Room to grow your career']
---
<Base title="Careers — Join the Ryse Team" description="Join Ryse ABA Therapy in Southern Utah. We're hiring compassionate RBTs and BCBAs who want to change children's lives through in-home ABA.">
  <!-- HERO -->
  <section class="section-sky relative overflow-hidden py-16 sm:py-20">
    <div class="aurora"></div>
    <div class="parallax blob" data-speed="0.3" style="width:360px;height:360px;background:var(--color-mint);top:-110px;left:-70px;opacity:.4;"></div>
    <div class="relative max-w-3xl mx-auto px-4 text-center reveal is-visible">
      <span class="text-accent font-bold uppercase tracking-wide text-sm">Careers</span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-dark mt-2">Do the most <span class="gradient-text">meaningful</span> work of your life</h1>
      <p class="mt-5 text-lg text-slate-600">Help children with autism build communication, confidence, and independence — right where they live. Join a family-first team that puts care first.</p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <a href={applyHref} class="btn btn-accent text-lg">Apply now</a>
        <a href={practice.social.instagram} target="_blank" rel="noopener" class="btn btn-ghost text-lg">📸 See life at Ryse</a>
      </div>
    </div>
  </section>

  <!-- WHY -->
  <section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-3xl font-extrabold text-dark text-center reveal">Why you'll love working here</h2>
      <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {perks.map((p, i) => (
          <div class={`card p-6 flex items-center gap-3 reveal reveal-delay-${(i%3)+1}`}><svg class="w-6 h-6 text-mint shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 011.4-1.4l3.1 3.1 6.8-6.8a1 1 0 011.4 0z" clip-rule="evenodd"/></svg><span class="font-semibold text-slate-700">{p}</span></div>
        ))}
      </div>
    </div>
  </section>

  <!-- ROLES -->
  <section class="py-16 section-cream">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-3xl font-extrabold text-dark text-center reveal">Roles we hire for</h2>
      <div class="mt-10 grid md:grid-cols-3 gap-6">
        {roles.map((r, i) => (
          <div class={`card p-7 reveal reveal-delay-${i+1}`}>
            <div class="w-14 h-14 rounded-2xl bg-sky flex items-center justify-center text-3xl mb-4">{r.icon}</div>
            <h3 class="text-lg font-extrabold text-dark">{r.t}</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">{r.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- APPLY CTA -->
  <section class="py-16" style="background:linear-gradient(120deg,var(--color-primary-deep),var(--color-primary));">
    <div class="max-w-2xl mx-auto px-4 text-center text-white reveal">
      <h2 class="text-3xl font-extrabold">Ready to make a difference?</h2>
      <p class="mt-3 text-white/85">Send us a note and your resume — we'd love to meet you.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href={applyHref} class="btn btn-accent text-lg">Apply now</a>
        <a href={phoneHref} class="btn bg-white text-primary-deep text-lg">📞 {practice.phone}</a>
      </div>
    </div>
  </section>
</Base>

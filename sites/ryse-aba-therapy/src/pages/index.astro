---
import Base from '@layouts/Base.astro'
import practice from '@data/practice.json'
import { getCollection } from 'astro:content'

const services = practice.serviceCategories
const svcIcons = {
  'in-home-aba-therapy': '🏡',
  'community-based-aba': '🌳',
  'early-intervention': '🌱',
  'social-skills': '🤝',
  'parent-training': '👪',
  'adolescent-adult-autism': '🌟',
}
const diffs = practice.differentiators
const areas = practice.areaServed
const phoneHref = `tel:${practice.phone.replace(/[^+\d]/g, '')}`
const slug = (a) => a.toLowerCase().replace(/[^a-z]+/g, '-').replace(/^-|-$/g, '')

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)

const outcomes = [
  { icon: '💬', t: 'Communication', d: 'From first words to full conversations — we help children find their voice.' },
  { icon: '🌱', t: 'Independence', d: 'Everyday skills — dressing, routines, self-care — that build real autonomy.' },
  { icon: '🤝', t: 'Connection', d: 'Friendship, play, and social confidence with peers and family.' },
  { icon: '⭐', t: 'Confidence', d: 'A calmer, happier child who believes in what they can do.' },
]
const homeFaqs = [
  { q: "What's the best ABA therapy for my child in Southern Utah?", a: "The best ABA is individualized, BCBA-led, and a genuine fit for your family — not one-size-fits-all. Look for a provider with no long waitlist, transparent insurance verification, and care delivered where your child actually lives and learns. Ryse provides in-home and community-based ABA across St. George and Washington County, designed and overseen by a Board Certified Behavior Analyst, with no waitlist." },
  { q: 'Why choose in-home ABA instead of a clinic?', a: "In-home ABA teaches and practices skills in the real settings where your child lives — the kitchen table, the backyard, the store — so progress transfers to daily life. It also removes the commute and lets parents be part of every session. For many Southern Utah families, that makes care easier to stick with and more effective." },
  { q: 'How soon can my child start? Is there a waitlist?', a: "There's no waitlist at Ryse — families typically start right away, often within the same week. Once your child has an autism diagnosis and active insurance coverage, we verify your benefits for free and begin building a personalized plan." },
  { q: 'Does insurance cover ABA therapy in Utah?', a: "In most cases, yes. ABA is widely recognized as an evidence-based autism service and is covered by Utah Medicaid and many commercial plans when there's an autism diagnosis. We run a free benefits check and verify your specific plan before any services begin — no surprise bills." },
  { q: 'What ages do you serve?', a: 'Ryse serves clients ages 2 to 65. Early support can be especially impactful for young children, but ABA helps teens and adults too — every plan is built around the individual.' },
  { q: 'How do I get started?', a: 'Three steps: (1) confirm an autism diagnosis, (2) we verify your insurance for free, and (3) we begin in-home or community-based sessions — no waitlist. Call (385) 549-5656 and our team will walk you through each step in plain language.' },
]
const steps = [
  { n: '1', t: 'Reach out', d: "Call or message us. We'll listen, answer your questions, and explain how in-home ABA works — no pressure." },
  { n: '2', t: 'We verify your insurance', d: 'Send us your insurance card and we check your benefits for free. An autism diagnosis and active coverage are all that\'s needed.' },
  { n: '3', t: 'Start right away', d: 'No waitlist. We build your child\'s personalized plan and begin therapy in your home — often within the same week.' },
]
const imgFallback = "this.style.opacity=0"
---

<Base title={practice.name} description={practice.hero.subheadline}>
  <!-- ================= HERO (parallax) ================= -->
  <section id="hero" class="relative overflow-hidden min-h-[88vh] flex items-center section-sky pt-8 pb-20">
    <div class="aurora"></div>
    <!-- parallax depth layers -->
    <div class="parallax blob" data-speed="0.25" style="width:520px;height:520px;background:var(--color-primary);top:-120px;left:-140px;"></div>
    <div class="parallax blob" data-speed="0.45" style="width:380px;height:380px;background:var(--color-sun);bottom:-140px;right:-90px;animation-delay:-5s;"></div>
    <div class="parallax blob" data-speed="0.6" style="width:300px;height:300px;background:var(--color-mint);top:24%;right:14%;animation-delay:-8s;opacity:.3;"></div>
    <div class="parallax" data-speed="0.15" style="position:absolute;inset:0;background-image:radial-gradient(circle at 20% 30%, rgba(46,143,206,.06), transparent 40%);"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-12 items-center w-full">
      <div class="reveal is-visible">
        <span class="inline-flex items-center gap-2 bg-white text-accent font-bold text-sm px-4 py-2 rounded-full shadow-sm mb-6">
          <span class="relative flex h-2.5 w-2.5"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-60"></span><span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-accent"></span></span>
          In-home ABA therapy · No waitlist · Southern Utah
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-[3.7rem] font-extrabold text-dark leading-[1.04]">
          Helping children with autism <span class="gradient-text">find their voice</span> — and reach their potential.
        </h1>
        <p class="mt-6 text-lg text-slate-600 max-w-xl">{practice.hero.subheadline} Personalized, play-based ABA therapy that changes lives, delivered right in your home.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact" class="btn btn-accent text-lg">Get started — verify my insurance</a>
          <a href={phoneHref} class="btn btn-ghost text-lg">📞 {practice.phone}</a>
        </div>
        <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2">
          {diffs.slice(0,4).map((d) => (
            <span class="trust-pill"><svg class="w-4 h-4 text-mint" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 011.4-1.4l3.1 3.1 6.8-6.8a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>{d}</span>
          ))}
        </div>
      </div>
      <div class="relative reveal is-visible">
        <div data-speed="0">
          <div class="blob-mask shadow-2xl aspect-[4/5] max-w-md mx-auto" style="background:linear-gradient(150deg,var(--color-primary),var(--color-mint));">
            <img src="/images/hero.jpg" alt="A child and ABA therapist playing and learning together at home" class="w-full h-full object-cover" loading="eager" onerror={imgFallback} />
          </div>
        </div>
        <div class="parallax absolute -bottom-2 -left-2 bg-white rounded-2xl shadow-lift px-5 py-3 flex items-center gap-3" data-speed="-0.4">
          <span class="text-3xl">💙</span>
          <div><div class="font-extrabold text-dark leading-tight">Ages 2–65</div><div class="text-xs text-slate-500">BCBA-led, family-first care</div></div>
        </div>
        <div class="parallax absolute -top-3 -right-1 bg-white rounded-2xl shadow-lift px-4 py-2.5 flex items-center gap-2" data-speed="-0.28">
          <span class="text-2xl">⚡</span><div class="font-bold text-dark text-sm leading-tight">No waitlist</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= IMPACT / WHAT WE DO ================= -->
  <section class="py-20 bg-white relative">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <div class="reveal max-w-3xl mx-auto">
        <span class="text-accent font-bold uppercase tracking-wide text-sm">What ABA therapy can do</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-dark mt-2">Real progress that changes a child's whole world</h2>
        <p class="mt-4 text-slate-600 text-lg">ABA (Applied Behavior Analysis) is the most-studied, evidence-based therapy for autism. At Ryse, we use it to help your child build the skills that open up their life — one meaningful step at a time.</p>
      </div>
      <div class="mt-14 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {outcomes.map((o, i) => (
          <div class={`card p-7 text-center reveal reveal-delay-${i+1}`}>
            <div class="w-16 h-16 rounded-2xl bg-sky mx-auto flex items-center justify-center text-3xl mb-4 float" style={`animation-delay:-${i}s`}>{o.icon}</div>
            <h3 class="text-lg font-extrabold text-dark">{o.t}</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">{o.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= WHAT IS ABA ================= -->
  <section class="py-20 bg-white overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 grid lg:grid-cols-2 gap-12 items-center">
      <div class="reveal">
        <span class="text-accent font-bold uppercase tracking-wide text-sm">The basics, in plain language</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-dark mt-2">What is ABA therapy?</h2>
        <p class="mt-5 text-slate-600 leading-relaxed text-lg"><strong>ABA (Applied Behavior Analysis) is the most-studied, evidence-based approach for helping children with autism learn and grow.</strong> In plain terms, it's a structured, individualized way of teaching real-life skills — communication, daily routines, play, and social connection — by understanding what motivates your child and building on it with positive reinforcement.</p>
        <p class="mt-4 text-slate-600 leading-relaxed">ABA isn't about changing who your child is. It's about giving them the tools to build confidence, independence, and a brighter future — one step at a time. At Ryse, every plan is designed and overseen by a <strong>BCBA (Board Certified Behavior Analyst)</strong> and delivered right in your home and community.</p>
        <a href="/blog/what-is-aba-therapy" class="btn btn-ghost mt-6">Read the full guide →</a>
      </div>
      <div class="reveal reveal-delay-1 grid gap-4">
        {[
          ['🗣️','Builds communication','From first words to full conversations.'],
          ['🧠','Evidence-based','Decades of research; recommended for autism.'],
          ['🎯','Individualized','Built around your child — never one-size-fits-all.'],
          ['📊','Data-driven','Every step measured, so you can see real progress.'],
        ].map(([i,t,d]) => (
          <div class="card p-5 flex items-start gap-4">
            <span class="text-3xl">{i}</span>
            <div><h3 class="font-bold text-dark">{t}</h3><p class="text-sm text-slate-600 mt-0.5">{d}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= STAT BAND ================= -->
  <section class="relative overflow-hidden py-16" style="background:linear-gradient(120deg,var(--color-primary-deep),var(--color-primary));">
    <div class="aurora opacity-30"></div>
    <div class="relative max-w-5xl mx-auto px-4 grid grid-cols-2 md:grid-cols-4 gap-8 text-center text-white stagger">
      <div class="reveal"><div class="text-4xl sm:text-5xl font-extrabold"><span data-count="5">5</span>+</div><p class="mt-1 text-white/80 text-sm font-semibold">Years of experience</p></div>
      <div class="reveal"><div class="text-4xl sm:text-5xl font-extrabold"><span data-count="7">7</span></div><p class="mt-1 text-white/80 text-sm font-semibold">Southern Utah cities served</p></div>
      <div class="reveal"><div class="text-4xl sm:text-5xl font-extrabold">2–65</div><p class="mt-1 text-white/80 text-sm font-semibold">Ages we welcome</p></div>
      <div class="reveal"><div class="text-4xl sm:text-5xl font-extrabold">$0</div><p class="mt-1 text-white/80 text-sm font-semibold">Waitlist — start this week</p></div>
    </div>
  </section>

  <!-- ================= SERVICES ================= -->
  <section class="py-20 section-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto reveal">
        <span class="text-accent font-bold uppercase tracking-wide text-sm">Our services</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-dark mt-2">Personalized ABA, built around your child</h2>
        <p class="mt-4 text-slate-600">Individualized, play-based care — delivered where your family lives life.</p>
      </div>
      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((s, i) => (
          <a href={`/services/${s.slug}`} class={`card p-7 reveal reveal-delay-${(i%3)+1} block group`}>
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-primary to-mint flex items-center justify-center text-2xl mb-4 group-hover:scale-110 group-hover:rotate-3 transition-transform">{svcIcons[s.slug] || '✨'}</div>
            <h3 class="text-xl font-bold text-dark">{s.title}</h3>
            <p class="mt-2 text-slate-600 text-sm leading-relaxed">{s.summary}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-primary font-semibold text-sm group-hover:gap-2 transition-all">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= WHY RYSE (parallax image) ================= -->
  <section class="py-24 bg-white overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 grid lg:grid-cols-2 gap-14 items-center">
      <div class="reveal order-2 lg:order-1 relative">
        <div class="parallax" data-speed="-0.12">
          <div class="blob-mask aspect-[5/4] shadow-xl" style="background:linear-gradient(150deg,var(--color-sun),var(--color-accent));">
            <img src="/images/family.jpg" alt="A Southern Utah family smiling together at home" class="w-full h-full object-cover" loading="lazy" onerror={imgFallback} />
          </div>
        </div>
      </div>
      <div class="reveal reveal-delay-1 order-1 lg:order-2">
        <span class="text-accent font-bold uppercase tracking-wide text-sm">The Ryse difference</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-dark mt-2">{practice.tagline}</h2>
        <p class="mt-5 text-slate-600 leading-relaxed text-lg">{practice.mission}</p>
        <ul class="mt-6 space-y-3">
          {diffs.map((d) => (
            <li class="flex items-start gap-3"><svg class="w-6 h-6 text-mint shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.7-9.3a1 1 0 00-1.4-1.4L9 10.6 7.7 9.3a1 1 0 10-1.4 1.4l2 2a1 1 0 001.4 0l4-4z" clip-rule="evenodd"/></svg><span class="text-slate-700">{d}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ================= HOW IT WORKS (FUNNEL) ================= -->
  <section class="py-20 section-sky relative overflow-hidden">
    <div class="parallax blob" data-speed="0.3" style="width:300px;height:300px;background:var(--color-mint);top:-80px;right:8%;opacity:.25;"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto reveal">
        <span class="text-accent font-bold uppercase tracking-wide text-sm">Getting started is simple</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-dark mt-2">Three steps. No waitlist.</h2>
      </div>
      <div class="mt-14 grid md:grid-cols-3 gap-8">
        {steps.map((s, i) => (
          <div class={`relative reveal reveal-delay-${i+1}`}>
            <div class="card p-8 h-full">
              <div class="w-14 h-14 rounded-full bg-accent text-white font-extrabold text-2xl flex items-center justify-center mb-5 shadow-lg">{s.n}</div>
              <h3 class="text-xl font-bold text-dark">{s.t}</h3>
              <p class="mt-2 text-slate-600 text-sm leading-relaxed">{s.d}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="mt-12 text-center reveal">
        <a href="/contact" class="btn btn-accent text-lg">Check my insurance & get started</a>
        <p class="mt-3 text-sm text-slate-500">Or call <a href={phoneHref} class="text-primary font-semibold">{practice.phone}</a> — we're happy to walk you through it.</p>
      </div>
    </div>
  </section>

  <!-- ================= LOCATIONS ================= -->
  <section class="py-20 section-cream">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <div class="reveal max-w-2xl mx-auto">
        <span class="text-accent font-bold uppercase tracking-wide text-sm">Serving Southern Utah</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-dark mt-2">In-home ABA across Washington County</h2>
        <p class="mt-4 text-slate-600">We come to you — no driving to a clinic. Proudly serving families in:</p>
      </div>
      <div class="mt-10 flex flex-wrap justify-center gap-3 reveal">
        {areas.map((a) => (
          <a href={`/locations/${slug(a)}`} class="px-5 py-2.5 bg-white rounded-full shadow-sm font-semibold text-primary-deep hover:shadow-lift hover:-translate-y-0.5 transition-all">📍 {a}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= BLOG TEASER ================= -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex items-end justify-between flex-wrap gap-4 reveal">
        <div><span class="text-accent font-bold uppercase tracking-wide text-sm">Parent resources</span><h2 class="text-3xl sm:text-4xl font-extrabold text-dark mt-2">From the Ryse blog</h2></div>
        <a href="/blog" class="btn btn-ghost">Browse all articles →</a>
      </div>
      <div class="mt-10 grid md:grid-cols-3 gap-6">
        {posts.map((p, i) => (
          <a href={`/blog/${p.slug}`} class={`card overflow-hidden reveal reveal-delay-${i+1} group`}>
            <div class="aspect-[16/10] overflow-hidden" style="background:linear-gradient(140deg,var(--color-primary),var(--color-mint));">
              <img src={p.data.image} alt="" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" onerror="this.onerror=null;this.src='/images/categories/local.jpg'" />
            </div>
            <div class="p-6">
              <span class="text-xs font-bold text-accent uppercase">{p.data.tags[0]}</span>
              <h3 class="mt-2 font-bold text-dark leading-snug group-hover:text-primary transition-colors">{p.data.title}</h3>
              <p class="mt-2 text-sm text-slate-500 line-clamp-2">{p.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= GUARANTEE + VALUE STACK ================= -->
  <section class="py-20 section-cream">
    <div class="max-w-6xl mx-auto px-4 grid lg:grid-cols-2 gap-8 items-stretch">
      <!-- Our promise (ethical risk reversal) -->
      <div class="reveal card p-8 sm:p-10 flex flex-col" style="border-top:5px solid var(--color-accent);">
        <div class="w-14 h-14 rounded-2xl bg-accent/10 flex items-center justify-center text-3xl mb-4">🛡️</div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-dark">Our promise to your family</h2>
        <p class="mt-4 text-slate-600 leading-relaxed">We verify your insurance <strong>before we ever start</strong> — so no surprise bills. You'll get a personalized plan from a Board Certified Behavior Analyst (BCBA), in-home convenience, and <strong>no long-term contract</strong>. If in-home ABA isn't the right fit for your child, we'll tell you honestly and help you find who is.</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <span class="trust-pill">✓ No surprise bills</span>
          <span class="trust-pill">✓ No waitlist</span>
          <span class="trust-pill">✓ No long-term contract</span>
        </div>
      </div>
      <!-- Value stack -->
      <div class="reveal reveal-delay-1 card p-8 sm:p-10 flex flex-col" style="border-top:5px solid var(--color-primary);">
        <div class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center text-3xl mb-4">🎁</div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-dark">What's included when you start with Ryse</h2>
        <ul class="mt-5 grid sm:grid-cols-2 gap-x-6 gap-y-3">
          {['Free insurance verification','BCBA assessment','Individualized treatment plan','In-home care — zero commute','Parent training & coaching','Regular progress reports','No waitlist','No long-term contract'].map((v) => (
            <li class="flex items-start gap-2 text-slate-700 text-sm"><svg class="w-5 h-5 text-mint shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 011.4-1.4l3.1 3.1 6.8-6.8a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>{v}</li>
          ))}
        </ul>
        <a href="/contact" class="btn btn-accent mt-7 self-start">Check my insurance — free, 60 sec</a>
      </div>
    </div>
  </section>

  <!-- ================= REVIEWS ================= -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 text-center reveal">
      <span class="text-accent font-bold uppercase tracking-wide text-sm">Loved by families</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-dark mt-2">Southern Utah families trust Ryse</h2>
      <p class="mt-4 text-slate-600">We'd love your feedback — and if you're a current family, your review helps other parents find compassionate care.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/reviews" class="btn btn-primary">Read & leave reviews</a>
        <a href={practice.reviews.googleReviewUrl || '/reviews'} class="btn btn-ghost">⭐ Leave a Google review</a>
      </div>
    </div>
  </section>

  <!-- ================= FAQ (intent-answering + AEO) ================= -->
  <section class="py-20 section-cream">
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: homeFaqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) })} />
    <div class="max-w-3xl mx-auto px-4">
      <div class="text-center reveal">
        <span class="text-accent font-bold uppercase tracking-wide text-sm">Questions parents ask</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-dark mt-2">Answers for Southern Utah families</h2>
      </div>
      <div class="mt-10 space-y-3">
        {homeFaqs.map((f) => (
          <details class="card p-5 group reveal">
            <summary class="font-bold text-dark cursor-pointer flex justify-between items-center gap-4">{f.q}<span class="text-primary group-open:rotate-45 transition-transform text-2xl shrink-0">+</span></summary>
            <p class="mt-3 text-slate-600 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
      <div class="mt-8 text-center reveal">
        <a href="/blog" class="btn btn-ghost">Browse 50+ parent guides →</a>
      </div>
    </div>
  </section>

  <!-- ================= JOIN TEAM + SOCIAL ================= -->
  <section class="py-20 section-cream">
    <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-2 gap-6">
      <div class="reveal card p-8 sm:p-10" style="border-top:5px solid var(--color-mint);">
        <div class="text-3xl mb-3">🌟</div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-dark">Join our team</h2>
        <p class="mt-3 text-slate-600">Love helping kids grow? We're always looking for compassionate RBTs and BCBAs across Southern Utah. Grow with a family-first team that puts care first.</p>
        <a href={`mailto:${practice.email}?subject=Careers at Ryse ABA`} class="btn btn-primary mt-6">Apply / get in touch</a>
      </div>
      <div class="reveal reveal-delay-1 card p-8 sm:p-10 flex flex-col justify-center text-center" style="background:linear-gradient(140deg,#f9ce34,#ee2a7b 50%,#6228d7);color:#fff;">
        <div class="text-4xl mb-2">📸</div>
        <h2 class="text-2xl sm:text-3xl font-extrabold">Follow us on Instagram</h2>
        <p class="mt-2 text-white/90">See the smiles, the wins, and life at Ryse.</p>
        <a href={practice.social.instagram} target="_blank" rel="noopener" class="btn bg-white text-dark mt-5 self-center">@ryse_aba →</a>
      </div>
    </div>
  </section>

  <!-- ================= FINAL CTA ================= -->
  <section class="py-24 relative overflow-hidden" style="background:linear-gradient(120deg,var(--color-primary-deep),var(--color-primary));">
    <div class="parallax blob" data-speed="0.4" style="width:360px;height:360px;background:#fff;opacity:.08;top:-90px;right:8%;"></div>
    <div class="relative max-w-3xl mx-auto px-4 text-center text-white reveal">
      <h2 class="text-3xl sm:text-5xl font-extrabold leading-tight">Every child has potential.<br/>Let's help yours reach it.</h2>
      <p class="mt-5 text-white/85 text-lg">We'll verify your insurance for free and start in your home — with no waitlist.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/contact" class="btn btn-accent text-lg">Get started today</a>
        <a href={phoneHref} class="btn bg-white text-primary-deep text-lg">📞 {practice.phone}</a>
      </div>
    </div>
  </section>

  <script is:inline>
    // Gentle parallax — sensory-safe, disabled for reduced-motion users.
    (function () {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const els = Array.from(document.querySelectorAll('.parallax'));
      let ticking = false;
      function update() {
        const vh = window.innerHeight;
        for (const el of els) {
          const speed = parseFloat(el.dataset.speed || '0');
          const rect = el.getBoundingClientRect();
          const center = rect.top + rect.height / 2 - vh / 2;
          el.style.transform = `translate3d(0, ${(-center * speed * 0.12).toFixed(1)}px, 0)`;
        }
        ticking = false;
      }
      function onScroll() { if (!ticking) { requestAnimationFrame(update); ticking = true; } }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', update);
      update();
    })();
  </script>
</Base>

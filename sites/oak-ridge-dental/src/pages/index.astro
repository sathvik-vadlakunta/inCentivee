---
import Base from '@layouts/Base.astro'
import CTABanner from '@components/CTABanner.astro'
import ServiceCard from '@components/ServiceCard.astro'
import practice from '@data/practice.json'
import testimonials from '@data/testimonials.json'
import { getCollection } from 'astro:content'

const allServices = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order)
const tel = practice.phone.replace(/[^+\d]/g, '')
const reviews = (practice as any).reviews ?? {}

// Office & technology gallery (real practice photography from the asset pack)
const gallery = [
  { src: '/images/oak/internal-banner.webp', alt: 'Modern treatment room at Oakridge Dental in Farmington' },
  { src: '/images/oak/yomi1.webp', alt: 'Yomi robotic-assisted dental implant system' },
  { src: '/images/oak/dr-call-home.webp', alt: 'Dr. Brian Call at Oakridge Dental' },
  { src: '/images/oak/yomi2.webp', alt: 'Guided implant technology at Oakridge Dental' },
  { src: '/images/oak/why-choose-bg.webp', alt: 'Comfortable, modern dental office in Farmington, Utah' },
  { src: '/images/oak/yomi3.webp', alt: 'Precision implant placement with the Yomi system' },
]
// Marquee needs the list duplicated for a seamless loop
const marqueeReviews = [...testimonials, ...testimonials]

const featuredSlugs = ['dental-implants', 'clear-aligners', 'teeth-whitening', 'root-canal-therapy', 'sleep-apnea-treatment', 'dental-cleanings-exams']
const featured = featuredSlugs.map((s) => allServices.find((x) => x.slug === s)).filter(Boolean)

const pillars = [
  { title: 'Comprehensive', body: 'From cleanings and fillings to implants, orthodontics, oral surgery, and pediatric care — every service your family needs, under one roof.', icon: 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z' },
  { title: 'Comfortable', body: 'Anxiety-free dentistry with nitrous oxide, oral, IV, and general sedation options — plus a gentle team that treats you like family.', icon: 'M3 13l2-5h14l2 5M5 13h14v4a1 1 0 01-1 1h-1a1 1 0 01-1-1v-1H8v1a1 1 0 01-1 1H6a1 1 0 01-1-1v-4z' },
  { title: 'Advanced', body: 'Same-day CEREC crowns, 3D cone-beam imaging, iTero digital scanning, and laser dentistry for precise, modern care.', icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z' },
]
const stats = [
  { num: allServices.length, suffix: '+', label: 'Services offered' },
  { num: practice.providers.length, suffix: '', label: 'Experienced dentists' },
  ...(reviews.count > 0
    ? [{ num: reviews.rating, suffix: '★', decimals: 1, label: `${reviews.count.toLocaleString()} Google reviews` }]
    : [{ num: 11, suffix: '', label: 'Areas of dentistry' }]),
  { text: 'Farmington', label: 'Serving Davis County' },
]
const initials = (n) => n.replace(/^Dr\.?\s+/, '').split(' ').map((p) => p[0]).slice(0, 2).join('')
---

<Base title={practice.name} description={practice.tagline}>
  <!-- Hero: full-bleed building photo + centered headline (matches their layout) -->
  <section class="relative min-h-[72vh] sm:min-h-[82vh] flex items-end overflow-hidden text-white">
    <img src="/images/oak/banner1.webp" alt="Oakridge Dental office in Farmington, Utah" fetchpriority="high" class="absolute inset-0 w-full h-full object-cover kenburns" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-black/15"></div>
    <div class="container-px relative pb-20 sm:pb-28 text-center w-full">
      <h1 class="hero-in text-5xl sm:text-6xl lg:text-7xl font-semibold drop-shadow-lg" data-d="1">{practice.name}</h1>
      <p class="hero-in mt-4 text-lg text-white/90 max-w-2xl mx-auto drop-shadow" data-d="2">Comprehensive, comfortable dentistry for the whole family in {practice.address.city}, {practice.address.state}.</p>
      <div class="hero-in mt-8 flex flex-col sm:flex-row gap-3 justify-center" data-d="3">
        <a href="/contact" class="btn btn-gold">Request Appointment</a>
        <a href={`tel:${tel}`} class="btn btn-ghost">{practice.phone}</a>
      </div>
      {reviews.count > 0 && (
        <a href={reviews.googleReadUrl} target="_blank" rel="noopener" class="hero-in mt-6 inline-flex items-center gap-2 text-sm text-white/90 drop-shadow hover:text-white" data-d="4">
          <span class="flex gap-0.5 text-accent-soft">
            {[0, 1, 2, 3, 4].map(() => (<svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.27 5.82.85-4.21 4.1.99 5.79L10 14.77 4.8 17.5l.99-5.79-4.21-4.1 5.82-.85z" /></svg>))}
          </span>
          <span><strong>{reviews.rating}</strong> from {reviews.count.toLocaleString()}+ Google reviews</span>
        </a>
      )}
    </div>
  </section>

  <!-- Welcome -->
  <section class="py-16 sm:py-20 text-center">
    <div class="container-px max-w-3xl">
      <p class="eyebrow justify-center">Your dentist in {practice.address.city}, {practice.address.state}</p>
      <h2 class="mt-4 text-3xl sm:text-4xl font-semibold text-dark">Welcome to {practice.name}</h2>
      <p class="mt-5 text-dark/70 leading-relaxed">From your child's first checkup to a complete smile makeover, our team provides comprehensive, gentle dentistry for every member of your family. With advanced technology, comfortable sedation options, and a team that treats you like a neighbor, we make every visit easy.</p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <a href="/services" class="btn btn-gold">Explore our services</a>
        <a href="/contact" class="btn btn-outline">Become a patient</a>
      </div>
    </div>
  </section>

  <!-- Stats (count up on scroll) -->
  <section class="bg-light border-b border-black/5">
    <div class="container-px grid grid-cols-2 lg:grid-cols-4 gap-6 py-10">
      {stats.map((s) => (
        <div class="reveal text-center">
          <div class="text-3xl sm:text-4xl font-semibold text-primary">
            {s.text
              ? s.text
              : <span class="stat-num" data-count={s.num} data-decimals={s.decimals || 0}>0</span>}{!s.text && s.suffix}
          </div>
          <div class="mt-1 text-sm text-dark/60">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Pillars -->
  <section class="py-20 sm:py-24">
    <div class="container-px">
      <div class="max-w-2xl reveal">
        <p class="eyebrow">The Oakridge difference</p>
        <h2 class="mt-4 text-3xl sm:text-4xl font-semibold text-dark">Modern dentistry, delivered with genuine care</h2>
      </div>
      <div class="mt-12 grid md:grid-cols-3 gap-6">
        {pillars.map((p) => (
          <div class="reveal card-soft p-8">
            <div class="w-12 h-12 rounded-2xl bg-primary/10 flex items-center justify-center text-primary">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d={p.icon} /></svg>
            </div>
            <h3 class="mt-5 text-xl font-semibold text-dark">{p.title}</h3>
            <p class="mt-2 text-dark/65 leading-relaxed">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured services -->
  <section class="py-20 sm:py-24 bg-light">
    <div class="container-px">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 reveal">
        <div class="max-w-xl">
          <p class="eyebrow">What we do</p>
          <h2 class="mt-4 text-3xl sm:text-4xl font-semibold text-dark">Complete care for every smile</h2>
        </div>
        <a href="/services" class="btn btn-outline shrink-0">All {allServices.length} services</a>
      </div>
      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {featured.map((service) => (
          <div class="reveal"><ServiceCard title={service.data.title} description={service.data.description} href={`/services/${service.slug}`} category={service.data.category} /></div>
        ))}
      </div>
    </div>
  </section>

  <!-- Doctors -->
  <section class="py-20 sm:py-24">
    <div class="container-px">
      <div class="max-w-2xl reveal">
        <p class="eyebrow">Meet your dentists</p>
        <h2 class="mt-4 text-3xl sm:text-4xl font-semibold text-dark">Four dentists who care for you like family</h2>
      </div>
      <div class="mt-12 grid grid-cols-2 lg:grid-cols-4 gap-6">
        {practice.providers.map((doc) => (
          <a href="/team" class="reveal card-soft overflow-hidden text-center group">
            {doc.photo
              ? <div class="aspect-square overflow-hidden bg-cream"><img src={doc.photo} alt={`${doc.name}, ${doc.credentials}`} class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-300" loading="lazy" /></div>
              : <div class="aspect-square grid place-items-center bg-gradient-to-br from-primary to-secondary text-white text-3xl font-semibold">{initials(doc.name)}</div>}
            <div class="p-5">
              <h3 class="text-lg font-semibold text-dark group-hover:text-primary transition-colors">{doc.name}, {doc.credentials}</h3>
              <p class="text-sm text-primary">{doc.title}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Office & technology gallery -->
  <section class="py-20 sm:py-24">
    <div class="container-px">
      <div class="max-w-2xl reveal">
        <p class="eyebrow">Take a look inside</p>
        <h2 class="mt-4 text-3xl sm:text-4xl font-semibold text-dark">Our office &amp; technology</h2>
        <p class="mt-3 text-dark/65">From robotic-assisted implants to same-day crowns, in a calm, modern space designed around your comfort.</p>
      </div>
      <div class="mt-10 grid grid-cols-2 md:grid-cols-3 gap-4">
        {gallery.map((g) => (
          <button type="button" class="gallery-item reveal aspect-[4/3]" data-lightbox={g.src} data-alt={g.alt} aria-label={`View: ${g.alt}`}>
            <img src={g.src} alt={g.alt} loading="lazy" class="h-full w-full object-cover" />
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Reviews marquee -->
  {testimonials.length > 0 && (
    <section class="py-20 sm:py-24 bg-light border-y border-black/5 overflow-hidden">
      <div class="container-px">
        <div class="max-w-2xl reveal">
          <p class="eyebrow">Loved by Farmington families</p>
          <h2 class="mt-4 text-3xl sm:text-4xl font-semibold text-dark">{reviews.rating}★ from {reviews.count.toLocaleString()}+ Google reviews</h2>
        </div>
      </div>
      <div class="marquee mt-10">
        <div class="marquee__track">
          {marqueeReviews.map((t) => (
            <figure class="w-80 shrink-0 card-soft p-6">
              <div class="flex gap-0.5 text-accent">{[0, 1, 2, 3, 4].map(() => (<svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.27 5.82.85-4.21 4.1.99 5.79L10 14.77 4.8 17.5l.99-5.79-4.21-4.1 5.82-.85z" /></svg>))}</div>
              <blockquote class="mt-3 text-sm text-dark/70 leading-relaxed line-clamp-5">"{t.quote}"</blockquote>
              <figcaption class="mt-3 text-sm font-semibold text-dark">— {t.name}</figcaption>
            </figure>
          ))}
        </div>
      </div>
      <div class="container-px mt-8 text-center">
        <a href="/reviews" class="btn btn-outline">Read all reviews</a>
      </div>
    </section>
  )}

  <CTABanner title="Ready for the dentist your whole family will love?" subtitle="New patients are always welcome at Oakridge Dental in Farmington." />

  <!-- Lightbox -->
  <dialog id="lightbox" aria-label="Image viewer">
    <img id="lightbox-img" src="" alt="" />
  </dialog>

  <script is:inline>
    function prCountUp() {
      var els = document.querySelectorAll('[data-count]')
      if (!els.length || !('IntersectionObserver' in window)) return
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting || e.target.dataset.done) return
            e.target.dataset.done = '1'
            io.unobserve(e.target)
            var target = parseFloat(e.target.getAttribute('data-count'))
            var dec = parseInt(e.target.getAttribute('data-decimals') || '0', 10)
            var start = null
            function step(ts) {
              if (!start) start = ts
              var p = Math.min((ts - start) / 1200, 1)
              var val = target * (1 - Math.pow(1 - p, 3))
              e.target.textContent = dec ? val.toFixed(dec) : Math.round(val).toLocaleString()
              if (p < 1) requestAnimationFrame(step)
            }
            requestAnimationFrame(step)
          })
        },
        { threshold: 0.5 }
      )
      els.forEach(function (el) { io.observe(el) })
    }
    function prLightbox() {
      var dlg = document.getElementById('lightbox')
      var img = document.getElementById('lightbox-img')
      if (!dlg) return
      document.querySelectorAll('[data-lightbox]').forEach(function (btn) {
        if (btn.dataset.bound) return
        btn.dataset.bound = '1'
        btn.addEventListener('click', function () {
          img.src = btn.getAttribute('data-lightbox')
          img.alt = btn.getAttribute('data-alt') || ''
          if (dlg.showModal) dlg.showModal()
        })
      })
      if (!dlg.dataset.bound) { dlg.dataset.bound = '1'; dlg.addEventListener('click', function () { dlg.close() }) }
    }
    document.addEventListener('astro:page-load', function () { prCountUp(); prLightbox() })
    if (document.readyState !== 'loading') { prCountUp(); prLightbox() }
  </script>
</Base>

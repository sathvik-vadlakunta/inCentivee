---
import Base from '@layouts/Base.astro'
import Hero from '@components/Hero.astro'
import CTABanner from '@components/CTABanner.astro'
import practice from '@data/practice.json'
---

<Base title="Financial Options" description={`Financial options at ${practice.name}. Cherry Financing, PPO insurance plans, and flexible payment methods for dental care in ${practice.address.city}, ${practice.address.state}.`}>
  <Hero title="Financial Options" subtitle="Quality dental care that fits your budget" />

  <section class="py-16 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <p class="text-gray-600 text-lg">
          We believe that quality dental care should be accessible to everyone. At {practice.name},
          Dr. Brian Call, Dr. Conner Ogden and our compassionate team offer a range of financial
          options for dental care in {practice.address.city}, {practice.address.state}. We accept
          most PPO plans — call today and find out if we are in your network!
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-5xl mx-auto">
        {/* Cherry Financing */}
        <div class="bg-white p-8 rounded-xl border border-gray-200 shadow-sm">
          <div class="w-14 h-14 mb-5 bg-primary/10 rounded-xl flex items-center justify-center">
            <svg class="w-7 h-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h2 class="text-2xl font-bold font-heading mb-4">Cherry Financing</h2>
          <p class="text-gray-600 mb-4">
            Cherry financing offers a simple and flexible way to pay for dental care over time.
            With quick approval and transparent terms, patients can choose affordable monthly
            payments that fit their budget.
          </p>
          <p class="text-gray-600 mb-6">
            It is a convenient solution that helps remove financial barriers, allowing you to
            prioritize your oral health without delay. Ask our dental team about how to apply
            for Cherry and get started on your treatment today.
          </p>
          <a
            href="https://withcherry.com"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center text-primary font-semibold hover:text-secondary transition-colors"
          >
            Learn More About Cherry
            <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>

        {/* Insurance & Payment */}
        <div class="space-y-8">
          {/* PPO Insurance */}
          <div class="bg-white p-8 rounded-xl border border-gray-200 shadow-sm">
            <div class="w-14 h-14 mb-5 bg-primary/10 rounded-xl flex items-center justify-center">
              <svg class="w-7 h-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h2 class="text-2xl font-bold font-heading mb-4">Insurance</h2>
            <p class="text-gray-600 mb-4">
              We accept most PPO dental insurance plans. Our team will help you understand your
              coverage and maximize your benefits.
            </p>
            <p class="text-gray-600">
              Not sure if we are in your network? Call us at
              <a href={`tel:${practice.phone.replace(/[^+\d]/g, '')}`} class="text-primary font-semibold hover:text-secondary transition-colors">{practice.phone}</a>
              and we will be happy to verify your insurance.
            </p>
          </div>

          {/* Other Payment Methods */}
          <div class="bg-white p-8 rounded-xl border border-gray-200 shadow-sm">
            <h3 class="text-lg font-bold font-heading mb-4">Other Accepted Payment Methods</h3>
            <ul class="space-y-3">
              <li class="flex items-center gap-3 text-gray-600">
                <svg class="w-5 h-5 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                Cash
              </li>
              <li class="flex items-center gap-3 text-gray-600">
                <svg class="w-5 h-5 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                Checks
              </li>
              <li class="flex items-center gap-3 text-gray-600">
                <svg class="w-5 h-5 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                Credit Cards
              </li>
            </ul>
          </div>
        </div>
      </div>

      <div class="max-w-3xl mx-auto text-center mt-12">
        <p class="text-gray-600">
          Whether you need help understanding insurance or are looking for payment plans, we are
          here to guide you. Call our team at
          <a href={`tel:${practice.phone.replace(/[^+\d]/g, '')}`} class="text-primary font-semibold hover:text-secondary transition-colors">{practice.phone}</a>
          to explore the options that work best for your budget.
        </p>
      </div>
    </div>
  </section>

  <CTABanner
    title="Ready to Schedule Your Visit?"
    subtitle="Our team is happy to help you navigate your financial options."
  />
</Base>

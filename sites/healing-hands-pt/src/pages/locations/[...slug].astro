---
import Base from '@layouts/Base.astro'
import Pic from '@components/Pic.astro'
import practice from '@data/practice.json'
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
  const locations = await getCollection('locations')
  return locations.map((l) => ({ params: { slug: l.slug }, props: { entry: l } }))
}
const { entry } = Astro.props
const { Content } = await entry.render()
const phoneHref = `tel:${practice.phone.replace(/[^+\d]/g, '')}`
const city = entry.data.city
const a = practice.address
const provider = practice.providers[0]
const faqs = entry.data.faqs ?? []
const others = (await getCollection('locations')).filter((l) => l.slug !== entry.slug).sort((x, y) => x.data.order - y.data.order)
const img = entry.data.image || '/images/hero.jpg'
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(`${practice.name}, ${a.street}, ${a.city}, ${a.state} ${a.zip}`)}&z=12&output=embed`

// LocalBusiness + Service schema scoped to this city's areaServed.
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': ['MedicalBusiness', 'PhysicalTherapy'],
  name: practice.name,
  url: `https://${practice.domain}/locations/${entry.slug}`,
  telephone: practice.phone,
  email: practice.email,
  image: `https://${practice.domain}${img}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: a.street,
    addressLocality: a.city,
    addressRegion: a.state,
    postalCode: a.zip,
    addressCountry: 'US',
  },
  geo: { '@type': 'GeoCoordinates', latitude: practice.geo.lat, longitude: practice.geo.lng },
  areaServed: { '@type': entry.data.state.includes('/') ? 'Place' : 'City', name: `${city}, ${entry.data.state}` },
  priceRange: '$$',
  makesOffer: practice.serviceCategories.map((s) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: s.title, areaServed: { '@type': 'City', name: `${city}, ${entry.data.state}` } },
  })),
}
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `https://${practice.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'Areas We Serve', item: `https://${practice.domain}/locations` },
    { '@type': 'ListItem', position: 3, name: entry.data.title, item: `https://${practice.domain}/locations/${entry.slug}` },
  ],
}
---
<Base title={entry.data.title} description={entry.data.description}>
  <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />

  <!-- HERO -->
  <section class="section-sky relative overflow-hidden">
    <div class="aurora"></div>
    <div class="blob" style="width:340px;height:340px;background:var(--color-primary);top:-120px;left:-70px;"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16 grid lg:grid-cols-2 gap-10 items-center">
      <div class="reveal is-visible">
        <a href="/locations" class="text-sm font-semibold text-primary">← Areas we serve</a>
        <span class="block mt-3 text-accent font-bold uppercase tracking-wide text-xs">📍 {city}, {entry.data.state}{entry.data.mobile ? ' · In-clinic + mobile' : ' · In-clinic'}</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-dark mt-2 leading-tight">{entry.data.title}</h1>
        <p class="mt-4 text-lg text-slate-600">{entry.data.description}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={practice.booking.url} target="_blank" rel="noopener" class="btn btn-accent text-lg">Book an appointment</a>
          <a href={phoneHref} class="btn btn-ghost text-lg">📞 Call / Text {practice.phone}</a>
        </div>
        <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2">
          {['A full hour, 1:1', 'Hands-on care', 'Cash-pay concierge', entry.data.mobile ? 'Mobile visits available' : 'Seen in our South Reno clinic'].map((t) => (<span class="trust-pill">✓ {t}</span>))}
        </div>
      </div>
      <div class="reveal is-visible">
        <div class="zoom-frame frame-lux aspect-[5/4]">
          <Pic src={img} alt={`Physical therapy for ${city}, ${entry.data.state} — Healing Hands Physical Therapy`} eager={true} width={720} height={576} widths={[480, 720, 960]} sizes="(max-width: 1024px) 92vw, 580px" class="w-full h-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- BODY + MAP -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 grid lg:grid-cols-[1fr_360px] gap-12 items-start">
      <article class="reveal prose prose-slate prose-lg prose-headings:font-heading prose-headings:text-dark prose-a:text-primary max-w-none">
        <Content />
      </article>
      <aside class="reveal reveal-delay-1 lg:sticky lg:top-28 space-y-5">
        <div class="card overflow-hidden">
          <div class="aspect-[4/3] bg-sky">
            <iframe src={mapSrc} title={`Map to Healing Hands Physical Therapy, serving ${city}`} loading="lazy" class="w-full h-full border-0" referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
          <div class="p-6">
            <h3 class="font-extrabold text-dark">Serving {city}</h3>
            <p class="mt-2 text-sm text-slate-600">{entry.data.driveTime}</p>
            {entry.data.mobile && <p class="mt-2 text-sm text-slate-600">Mobile (in-home) visits available in {city}, subject to scheduling and availability.</p>}
            <a href={practice.booking.url} target="_blank" rel="noopener" class="btn btn-accent w-full justify-center mt-4 text-sm">Book an appointment</a>
            <a href={phoneHref} class="block text-center mt-3 font-bold text-primary">📞 {practice.phone}</a>
          </div>
        </div>
        <div class="glass p-6 text-center">
          <p class="font-bold text-dark">{provider.name}</p>
          <p class="text-sm text-slate-600 mt-1">{provider.credentials} · 15+ years of hands-on, manual-therapy experience.</p>
        </div>
      </aside>
    </div>
  </section>

  {faqs.length > 0 && (
    <section class="pb-16 bg-white">
      <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) })} />
      <div class="max-w-3xl mx-auto px-5 sm:px-6">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-dark mb-6 text-center">{city} — common questions</h2>
        <div class="space-y-3">
          {faqs.map((f) => (
            <details class="card p-5 group">
              <summary class="font-bold text-dark cursor-pointer flex justify-between items-center gap-4">{f.question}<span class="text-primary group-open:rotate-45 transition-transform text-2xl shrink-0">+</span></summary>
              <p class="mt-3 text-slate-600 leading-relaxed">{f.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- NEARBY AREAS -->
  <section class="py-14 section-cream">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <h2 class="text-xl font-extrabold text-dark mb-6 reveal">Other areas we serve</h2>
      <div class="flex flex-wrap justify-center gap-2.5 reveal">
        {others.map((l) => (<a href={`/locations/${l.slug}`} class="px-4 py-2 bg-white rounded-full shadow-sm text-sm font-semibold text-primary-deep hover:shadow-lift hover:-translate-y-0.5 transition-all">📍 {l.data.city}</a>))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="py-16 relative overflow-hidden" style="background:linear-gradient(120deg,var(--color-primary-deep),var(--color-primary));">
    <div class="aurora opacity-30"></div>
    <div class="relative max-w-2xl mx-auto px-4 text-center text-white reveal">
      <h2 class="text-3xl font-extrabold">Serving {city} with concierge, hands-on care</h2>
      <p class="mt-3 text-white/85">A full hour, one-on-one with your doctor — cash-pay, root-cause focused.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href={practice.booking.url} target="_blank" rel="noopener" class="btn btn-accent text-lg">Book your appointment</a>
        <a href={phoneHref} class="btn bg-white text-primary-deep text-lg">📞 {practice.phone}</a>
      </div>
    </div>
  </section>
</Base>

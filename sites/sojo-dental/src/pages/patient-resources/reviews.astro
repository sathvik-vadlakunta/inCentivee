---
import Base from '@layouts/Base.astro'
import Hero from '@components/Hero.astro'
import CTABanner from '@components/CTABanner.astro'
import practice from '@data/practice.json'

const reviews = [
  { text: "Sojo is a great office! The staff is so kind and accommodating. Melanie is the best assistant and made me feel so comfortable and at ease when I got my filling done. Dr. Call is very proficient and does great dental work.", author: "K. G." },
  { text: "Dr. Call is such a great guy, compassionate, and a gentle dentist. His assistant Melanie is skilled and the kind of person you want to have as a friend. Seriously the whole crew there makes your dental experience into an enjoyable visit.", author: "R. M." },
  { text: "I've been coming here for several years now! Everyone is so friendly, informative, and GENTLE. Each person that has cleaned my teeth has been amazing. I'd recommend this place to anyone!! 10/10!", author: "A. B." },
  { text: "I loved SoJo dental. The hygienists were amazing. The dentist does a great job, and is very friendly. I have never had any problems with my fillings. He is reasonable and not \"cavity happy\" like some dentists. His office is homey. His front desk staff is so nice and knowledgeable.", author: "A. S." },
  { text: "I had a great experience at SoJo Dental. The team was incredibly friendly and made sure I was comfortable during the appointment. The doctors were also very professional & outgoing. The environment and work they do is what I'd recommend to any friend or family member looking for an excellent office.", author: "K. K." },
]
---

<Base title="Reviews" description={`Read patient reviews for ${practice.name}. See why patients trust Dr. Brian Call and Dr. Conner Ogden for dental care in ${practice.address.city}, ${practice.address.state}.`}>
  <Hero title="Patient Reviews" subtitle="See what our patients are saying" />

  <section class="py-16 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="text-gray-600 text-lg max-w-3xl mx-auto">
          The experiences of our patients speak volumes. At {practice.name}, Dr. Brian Call,
          Dr. Conner Ogden and our skilled team prioritize comfort, clarity and lasting results.
          Patients appreciate our gentle approach, advanced technology and commitment to excellence.
        </p>
      </div>

      {/* Write a Review CTA */}
      <div class="flex justify-center mb-12">
        <a
          href={practice.social.google}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 bg-primary text-white px-6 py-3 rounded-lg font-semibold hover:bg-secondary transition-colors"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
          </svg>
          Write a Review on Google
        </a>
      </div>

      {/* Reviews Grid */}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {reviews.map((review) => (
          <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
            <div class="flex items-center gap-1 text-primary mb-3">
              {[1,2,3,4,5].map(() => (
                <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
              ))}
            </div>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">"{review.text}"</p>
            <div class="flex items-center justify-between">
              <p class="text-sm font-semibold text-dark">{review.author}</p>
              <span class="text-xs text-gray-400">Google Review</span>
            </div>
          </div>
        ))}
      </div>

      {/* Google CTA */}
      <div class="text-center mt-12">
        <a
          href={practice.social.google}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center text-primary font-semibold text-lg hover:text-secondary transition-colors"
        >
          See All Reviews on Google
          <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <CTABanner
    title="Experience the Difference"
    subtitle={`Call ${practice.name} today at ${practice.phone} to schedule your visit.`}
  />
</Base>

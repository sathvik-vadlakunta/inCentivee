---
import fs from 'node:fs'
import path from 'node:path'
import CloneBase from '@layouts/CloneBase.astro'

// Serve every ingested clone page (exact content) at its original URL, through
// our shared header/footer on our Astro stack. Blog + its posts are handled by
// the clean components (src/pages/blog/*), so they aren't in clone-pages.
export async function getStaticPaths() {
  // Bespoke pages we render with clean Astro templates instead of the raw clone.
  const OVERRIDDEN = new Set([
    '',                       // home / landing page — clean rebuild in src/pages/index.astro
    'about-us/cade-parian',
    'about-us/tyler-paul-smith',
    'about-us/ryan-farmer',
    'scholarship-2021',
    'carrollton-personal-injury-lawyers',
  ])
  const root = path.resolve('clone-pages')
  const out: any[] = []
  const walk = (dir: string) => {
    for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
      const fp = path.join(dir, e.name)
      if (e.isDirectory()) walk(fp)
      else if (e.name === 'index.html') {
        const rel = path.relative(root, fp).replace(/\/index\.html$/, '').replace(/index\.html$/, '')
        if (OVERRIDDEN.has(rel)) continue
        const html = fs.readFileSync(fp, 'utf8')
        // Strip the firm's inherited 3rd-party tracking: their old Google Tag Manager
        // container injects a call-tracking DNI script that swaps our real phone number
        // for a stale tracking number we don't own. Also drop WP.com stats. We'll add
        // our OWN GA4/GTM later. (See platform plan.)
        // NOTE: each regex is bounded with a (?!<\/script>) / (?!<\/noscript>) negative
        // lookahead so a match can't span across element boundaries and eat page content
        // (a naive [\s\S]*? would run from the first <script> through the banner to GTM).
        const sanitize = (s: string) =>
          s
            // Cutover: rewrite the WordPress staging domain to the real domain so
            // og:url/og:image/canonical/internal links + assets resolve on westgalawyer.com
            // (same-origin after the DNS cutover) instead of leaking the staging host.
            .replace(/https?:\/\/mediatorworks\.wpcomstaging\.com/gi, 'https://westgalawyer.com')
            // inline GTM bootstrap / dataLayer script (its own content references GTM)
            .replace(/<script\b[^>]*>(?:(?!<\/script>)[\s\S])*?googletagmanager\.com(?:(?!<\/script>)[\s\S])*?<\/script>/gi, '')
            // external GTM script tag
            .replace(/<script\b[^>]*\bsrc="[^"]*googletagmanager\.com[^"]*"[^>]*>\s*<\/script>/gi, '')
            // GTM <noscript> iframe fallback
            .replace(/<noscript\b[^>]*>(?:(?!<\/noscript>)[\s\S])*?googletagmanager\.com(?:(?!<\/noscript>)[\s\S])*?<\/noscript>/gi, '')
            // WordPress.com / Jetpack stats pixel
            .replace(/<script\b[^>]*\bsrc="[^"]*stats\.wp\.com[^"]*"[^>]*>\s*<\/script>/gi, '')

        // Fix the stray opening apostrophes from the WP migration (". 'Many times",
        // "cars,'trucks", and "injuries</a>'are" — the last one has NO space, so the
        // browser can't break between the link and the next word, which is why inline
        // links drop onto their own line on mobile). Done at BUILD time over TEXT
        // BETWEEN TAGS ONLY (scripts/styles are stashed first), so inline JS and
        // attributes are never touched — and there's no runtime flash.
        const fixApostrophes = (s: string) => {
          const stash: string[] = []
          s = s.replace(/<(script|style|noscript)\b[\s\S]*?<\/\1>/gi, (m) => {
            stash.push(m)
            return `${stash.length - 1}`
          })
          s = s.replace(/>([^<]+)</g, (_m, text: string) =>
            '>' +
            text
              .replace(/([.!?:,])\s*'(?=[A-Za-z])/g, '$1 ') // ". 'Word" / ",'word" -> ". Word" / ", word"
              .replace(/^'(?!s\b)(?=[A-Za-z])/, ' ')        // "</a>'are" -> "</a> are" (not possessive 's)
              .replace(/ {2,}/g, ' ') +
            '<'
          )
          return s.replace(/(\d+)/g, (_x, i) => stash[+i])
        }

        // Speed: the clone hauls the whole WordPress asset stack (~1.5MB CSS+JS). Most
        // of it is dead weight on these theme-template pages — strip the heavy libraries
        // that are replaced (nav SmartMenus), dead (CleanTalk/CF7 for the disabled form,
        // wp-emoji), or simply unused here (Elementor, Swiper, Owl, Isotope). Carousel/
        // Elementor libs are only dropped when the page body doesn't actually use them.
        // Font Awesome + jQuery are left alone so icons/behaviour don't break.
        const stripAssets = (h: string, b: string) => {
          const drop = ['smartmenus', 'cleantalk', 'apbct', 'wp-emoji', 'contact-form-7', 'isotope', 'jquery-migrate']
          if (!/class="[^"]*swiper/i.test(b)) drop.push('swiper')
          if (!/class="[^"]*owl-carousel/i.test(b)) drop.push('owl.carousel', 'owl.theme')
          if (!/class="[^"]*elementor-(?:widget|element)|data-elementor-type/i.test(b)) {
            drop.push('elementor/assets/js/frontend', 'elements-handlers', 'frontend-modules',
                      'elementor/assets/css/frontend', 'elementor/assets/css/widget-', 'pro-elements/assets')
          }
          const tokens = drop.map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')
          const re = new RegExp(`<(?:script|link)\\b[^>]*\\b(?:src|href)="[^"]*(?:${tokens})[^"]*"[^>]*>(?:\\s*</script>)?`, 'gi')
          return h
            .replace(re, '')
            .replace(/<script\b[^>]*>(?:(?!<\/script>)[\s\S])*?wpemoji(?:(?!<\/script>)[\s\S])*?<\/script>/gi, '')
            .replace(/<style\b[^>]*>\s*img\.wp-smiley[\s\S]*?<\/style>/gi, '')
        }

        // WordPress enqueues most heavy scripts in the FOOTER, so strip both head + body.
        const rawBody = fixApostrophes(sanitize((html.match(/<body[^>]*>([\s\S]*?)<\/body>/i) || [, ''])[1]))
        const head = stripAssets(sanitize((html.match(/<head[^>]*>([\s\S]*?)<\/head>/i) || [, ''])[1]), rawBody)
        const body = stripAssets(rawBody, rawBody)
        // preserve the original <body> classes — the theme/Elementor uses them for
        // page background, text colors, and layout scoping.
        const bodyOpen = (html.match(/<body([^>]*)>/i) || [, ''])[1]
        const bodyClass = (bodyOpen.match(/class="([^"]*)"/i) || [, ''])[1]
        out.push({ params: { path: rel || undefined }, props: { head, body, bodyClass } })
      }
    }
  }
  walk(root)
  return out
}

const { head, body, bodyClass } = Astro.props
---

<CloneBase head={head} body={body} bodyClass={bodyClass} />

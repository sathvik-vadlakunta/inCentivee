---
import Base from '@layouts/Base.astro'
import practice from '@data/practice.json'
---
<Base title="Meet Our Doctors" description={`Meet the dentists at ${practice.name} in ${practice.address.city}, ${practice.address.state}.`}>
  <section class="bg-primary text-white">
    <div class="max-w-7xl mx-auto px-4 py-16">
      <h1 class="text-4xl font-bold">Meet Our Doctors</h1>
      <p class="mt-3 text-white/80 max-w-2xl">Our experienced, caring dentists provide comprehensive dentistry for the whole family in {practice.address.city}.</p>
    </div>
  </section>
  <section class="py-16">
    <div class="max-w-5xl mx-auto px-4 grid sm:grid-cols-3 gap-6">
      {practice.providers.map((doc) => (
        <div class="rounded-xl border border-gray-200 p-6 text-center">
          <div class="w-20 h-20 mx-auto rounded-full bg-gradient-to-br from-primary to-secondary text-white grid place-items-center text-2xl font-semibold">
            {doc.name.replace(/^Dr\.?\s+/, '').split(' ').map((p) => p[0]).slice(0, 2).join('')}
          </div>
          <h2 class="mt-4 text-lg font-semibold">{doc.name}, {doc.credentials}</h2>
          <p class="text-sm text-primary">{doc.title}</p>
          <div class="mt-3 flex flex-wrap gap-1.5 justify-center">
            {doc.specialties.map((s) => <span class="text-xs bg-primary/10 text-primary px-2 py-0.5 rounded-full">{s}</span>)}
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>

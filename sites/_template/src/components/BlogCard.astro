---
interface Props {
  title: string
  description: string
  href: string
  pubDate: Date
  image?: string
  tags?: string[]
}

const { title, description, href, pubDate, image, tags = [] } = Astro.props
const formattedDate = pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
---

<a href={href} class="group block rounded-xl border border-gray-200 overflow-hidden hover:shadow-lg transition-shadow">
  {image && (
    <div class="aspect-[16/9] overflow-hidden bg-gray-100">
      <img src={image} alt={title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
    </div>
  )}
  <div class="p-6">
    <time class="text-xs text-gray-500">{formattedDate}</time>
    <h3 class="mt-1 text-lg font-semibold font-heading text-dark group-hover:text-primary transition-colors">
      {title}
    </h3>
    <p class="mt-2 text-sm text-gray-600 line-clamp-2">{description}</p>
    {tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <span class="text-xs bg-gray-100 text-gray-600 px-2 py-0.5 rounded-full">{tag}</span>
        ))}
      </div>
    )}
  </div>
</a>

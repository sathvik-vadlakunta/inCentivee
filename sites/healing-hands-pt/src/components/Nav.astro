---
import practice from '@data/practice.json'
import { getCollection } from 'astro:content'
const services = practice.serviceCategories
const locations = (await getCollection('locations')).sort((a, b) => a.data.order - b.data.order)
const path = Astro.url.pathname
const phoneHref = `tel:${practice.phone.replace(/[^+\d]/g, '')}`
const isOn = (h) => h !== '/' && path.startsWith(h)
---
<header id="nav" class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-sky transition-shadow">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between py-3">
    <a href="/" class="flex items-center shrink-0" aria-label="Healing Hands Physical Therapy home">
      <img src="/images/logo.png" alt="Healing Hands Physical Therapy and Bodywork" class="h-20 sm:h-24 w-auto" onerror="this.outerHTML='<span class=&quot;text-lg sm:text-xl font-extrabold font-heading text-dark leading-tight&quot;>Healing&nbsp;Hands<span class=&quot;text-primary&quot;> PT</span></span>'" />
    </a>

    <div class="hidden lg:flex items-center gap-1">
      <a href="/" class:list={['px-3 py-2 rounded-lg text-sm font-semibold transition-colors', path === '/' ? 'text-primary bg-sky' : 'text-slate-600 hover:text-primary hover:bg-sky']}>Home</a>
      <a href="/about" class:list={['px-3 py-2 rounded-lg text-sm font-semibold transition-colors', isOn('/about') ? 'text-primary bg-sky' : 'text-slate-600 hover:text-primary hover:bg-sky']}>About Us</a>

      <!-- Services dropdown -->
      <div class="relative group">
        <a href="/services" class:list={['flex items-center gap-1 px-3 py-2 rounded-lg text-sm font-semibold transition-colors', isOn('/services') ? 'text-primary bg-sky' : 'text-slate-600 group-hover:text-primary group-hover:bg-sky']}>
          Services <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" d="M19 9l-7 7-7-7"/></svg>
        </a>
        <div class="absolute left-0 top-full pt-2 w-80 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200">
          <div class="bg-white rounded-2xl shadow-xl border border-sky p-2 max-h-[70vh] overflow-y-auto">
            {services.map((s) => (
              <a href={`/services/${s.slug}`} class="block px-3 py-2.5 rounded-xl hover:bg-sky">
                <div class="font-semibold text-dark text-sm">{s.title}</div>
                <div class="text-xs text-slate-500 line-clamp-1">{s.summary}</div>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Areas We Serve dropdown -->
      <div class="relative group">
        <a href="/locations" class:list={['flex items-center gap-1 px-3 py-2 rounded-lg text-sm font-semibold transition-colors', isOn('/locations') ? 'text-primary bg-sky' : 'text-slate-600 group-hover:text-primary group-hover:bg-sky']}>
          Areas We Serve <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" d="M19 9l-7 7-7-7"/></svg>
        </a>
        <div class="absolute left-0 top-full pt-2 w-64 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200">
          <div class="bg-white rounded-2xl shadow-xl border border-sky p-2">
            {locations.map((l) => (
              <a href={`/locations/${l.slug}`} class="flex items-center justify-between px-3 py-2.5 rounded-xl hover:bg-sky">
                <span class="font-semibold text-dark text-sm">📍 {l.data.city}, {l.data.state}</span>
                <span class="text-[10px] font-semibold text-primary-deep/70">{l.data.mobile ? 'Clinic + mobile' : 'In-clinic'}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <a href="/membership" class:list={['px-3 py-2 rounded-lg text-sm font-semibold transition-colors', isOn('/membership') ? 'text-primary bg-sky' : 'text-slate-600 hover:text-primary hover:bg-sky']}>Membership</a>
      <a href="/testimonials" class:list={['px-3 py-2 rounded-lg text-sm font-semibold transition-colors', isOn('/testimonials') ? 'text-primary bg-sky' : 'text-slate-600 hover:text-primary hover:bg-sky']}>Testimonials</a>
      <a href="/blog" class:list={['px-3 py-2 rounded-lg text-sm font-semibold transition-colors', isOn('/blog') ? 'text-primary bg-sky' : 'text-slate-600 hover:text-primary hover:bg-sky']}>Blog</a>
      <a href="/contact" class:list={['px-3 py-2 rounded-lg text-sm font-semibold transition-colors', isOn('/contact') ? 'text-primary bg-sky' : 'text-slate-600 hover:text-primary hover:bg-sky']}>Contact</a>
      <a href={phoneHref} class="ml-1 px-3 py-2 rounded-lg text-sm font-bold text-primary-deep hover:bg-sky whitespace-nowrap">📞 {practice.phone}</a>
      <a href={practice.booking.url} target="_blank" rel="noopener" class="btn btn-accent ml-1 text-sm py-2.5 whitespace-nowrap">Book Now</a>
    </div>

    <button id="menu-btn" class="lg:hidden p-2 rounded-lg text-slate-700 hover:bg-sky" aria-label="Menu" aria-expanded="false">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </nav>

  <div id="mobile-menu" class="lg:hidden hidden border-t border-sky bg-white px-4 py-3 space-y-1 max-h-[80vh] overflow-y-auto">
    <a href="/" class="block px-3 py-2.5 rounded-lg font-semibold text-slate-700 hover:bg-sky">Home</a>
    <a href="/about" class="block px-3 py-2.5 rounded-lg font-semibold text-slate-700 hover:bg-sky">About Us</a>
    <details class="group">
      <summary class="flex justify-between items-center px-3 py-2.5 rounded-lg font-semibold text-slate-700 cursor-pointer">Services <span class="group-open:rotate-180 transition-transform">▾</span></summary>
      <div class="pl-3">{services.map((s) => (<a href={`/services/${s.slug}`} class="block px-3 py-2 rounded-lg text-sm text-slate-600 hover:bg-sky">{s.title}</a>))}</div>
    </details>
    <details class="group">
      <summary class="flex justify-between items-center px-3 py-2.5 rounded-lg font-semibold text-slate-700 cursor-pointer">Areas We Serve <span class="group-open:rotate-180 transition-transform">▾</span></summary>
      <div class="pl-3">
        <a href="/locations" class="block px-3 py-2 rounded-lg text-sm font-semibold text-primary hover:bg-sky">All areas →</a>
        {locations.map((l) => (<a href={`/locations/${l.slug}`} class="block px-3 py-2 rounded-lg text-sm text-slate-600 hover:bg-sky">📍 {l.data.city}, {l.data.state}</a>))}
      </div>
    </details>
    <a href="/membership" class="block px-3 py-2.5 rounded-lg font-semibold text-slate-700 hover:bg-sky">Membership</a>
    <a href="/testimonials" class="block px-3 py-2.5 rounded-lg font-semibold text-slate-700 hover:bg-sky">Testimonials</a>
    <a href="/blog" class="block px-3 py-2.5 rounded-lg font-semibold text-slate-700 hover:bg-sky">Blog</a>
    <a href="/contact" class="block px-3 py-2.5 rounded-lg font-semibold text-slate-700 hover:bg-sky">Contact</a>
    <a href={practice.booking.url} target="_blank" rel="noopener" class="btn btn-accent w-full justify-center mt-2">Book Now</a>
    <a href={phoneHref} class="block text-center mt-2 font-bold text-primary">📞 {practice.phone}</a>
  </div>
</header>
<script>
  // View-Transition-safe: (re)bind on every page load, not just first paint.
  function initNav() {
    const btn = document.getElementById('menu-btn')
    const menu = document.getElementById('mobile-menu')
    if (btn && menu && !btn.dataset.bound) {
      btn.dataset.bound = '1'
      btn.addEventListener('click', () => {
        const open = menu.classList.toggle('hidden')
        btn.setAttribute('aria-expanded', String(!open))
      })
    }
    const nav = document.getElementById('nav')
    const onScroll = () => nav?.classList.toggle('shadow-lg', window.scrollY > 10)
    window.addEventListener('scroll', onScroll, { passive: true })
    onScroll()
  }
  initNav()
  document.addEventListener('astro:page-load', initNav)
</script>

---
import Nav from '@components/Nav.astro'
import Footer from '@components/Footer.astro'
import SchemaMarkup from '@components/SchemaMarkup.astro'
import practice from '@data/practice.json'
import '@/styles/global.css'

interface Props {
  title: string
  description?: string
  image?: string
  noindex?: boolean
}

const { title, description = practice.tagline, image, noindex = false } = Astro.props
const pageTitle = title === practice.name ? title : `${title} | ${practice.name}`
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}

    <!-- Preconnect fonts if custom -->
    {practice.fonts.heading !== 'system-ui' && (
      <link rel="preconnect" href="https://fonts.googleapis.com" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link
        rel="stylesheet"
        href={`https://fonts.googleapis.com/css2?family=${practice.fonts.heading.replace(/ /g, '+')}:wght@400;600;700&family=${practice.fonts.body.replace(/ /g, '+')}:wght@300;400;500;600&display=swap`}
      />
    )}

    <SchemaMarkup />
  </head>
  <body class="min-h-screen flex flex-col">
    <Nav />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

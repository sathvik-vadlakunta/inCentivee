---
import Base from '@layouts/Base.astro'
import Pic from '@components/Pic.astro'
import practice from '@data/practice.json'
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
  const services = await getCollection('services')
  return services.map((s) => ({ params: { slug: s.slug }, props: { entry: s } }))
}
const { entry } = Astro.props
const { Content } = await entry.render()
const phoneHref = `tel:${practice.phone.replace(/[^+\d]/g, '')}`
const faqs = entry.data.faqs ?? []
const others = (await getCollection('services')).filter((s) => s.slug !== entry.slug).slice(0, 3)
const img = entry.data.image || '/images/services/manual-therapy.jpg'
// TODO(2026-07): clinic.jpg (old South Reno location) removed ahead of the move.
// Neutral hands-on image for now — swap to Jamie's new lobby/room photos when provided.
const sideImg = '/images/hero.jpg'
const provider = practice.providers[0]
const facts = [
  { v: '60', suffix: ' min', label: 'One-on-one with your doctor' },
  { v: '1:1', suffix: '', label: 'Always — never shared', static: true },
  { v: '15', suffix: '+', label: 'Years of experience' },
  { v: '4', suffix: '', label: 'Cities served across NV' },
]
const steps = [
  { n: '1', icon: '📞', t: 'Reach out', d: "Call, text, or email to schedule. We'll listen, answer your questions, and explain how concierge PT works — no pressure." },
  { n: '2', icon: '🔎', t: 'Root-cause evaluation', d: 'Your doctor analyzes your gait, posture, and mobility to find what is actually driving your pain — not just where it hurts.' },
  { n: '3', icon: '🤲', t: 'Hands-on treatment', d: 'A full hour of hands-on manual therapy and targeted modalities, tailored to you — in clinic or at your home in the Reno-Sparks area.' },
  { n: '4', icon: '🏃', t: 'Back to what you love', d: 'We focus on lasting relief and give you simple home exercises so you keep your gains and reduce the risk of re-injury.' },
]
---
<Base title={entry.data.title} description={entry.data.description}>
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `https://${practice.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `https://${practice.domain}/services` },
    { '@type': 'ListItem', position: 3, name: entry.data.title, item: `https://${practice.domain}/services/${entry.slug}` },
  ] })} />
  <!-- HERO -->
  <section class="section-sky relative overflow-hidden">
    <div class="aurora"></div>
    <div class="blob" style="width:320px;height:320px;background:var(--color-primary);top:-120px;left:-70px;opacity:.3;"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16 grid lg:grid-cols-2 gap-10 items-center">
      <div class="reveal is-visible">
        <a href="/services" class="text-sm font-semibold text-primary">← All services</a>
        <span class="block mt-3 text-primary font-bold uppercase tracking-wide text-xs">{entry.data.category} · Reno, NV</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-dark mt-2 leading-tight">{entry.data.title}</h1>
        <p class="mt-4 text-lg text-slate-600">{entry.data.description}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={practice.booking.url} target="_blank" rel="noopener" class="btn btn-accent text-lg">Book an appointment</a>
          <a href={phoneHref} class="btn btn-ghost text-lg">📞 {practice.phone}</a>
        </div>
        <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2">
          {['A full hour, 1:1','Hands-on care','Root-cause focus','Mobile visits available'].map((t) => (<span class="trust-pill">✓ {t}</span>))}
        </div>
      </div>
      <div class="reveal is-visible">
        <div class="zoom-frame frame-lux aspect-[5/4]" transition:name={`svc-${entry.slug}`}>
          <Pic src={img} alt={`${entry.data.title} at Healing Hands Physical Therapy in Reno`} eager={true} width={720} height={576} widths={[480, 720, 960]} sizes="(max-width: 1024px) 92vw, 580px" class="w-full h-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- QUICK FACTS -->
  <section class="bg-white py-10 border-b border-sky">
    <div class="max-w-6xl mx-auto px-4 grid grid-cols-2 lg:grid-cols-4 gap-4 stagger">
      {facts.map((f) => (
        <div class="card p-6 text-center reveal">
          <div class="text-3xl sm:text-4xl font-extrabold gradient-text">{f.static ? f.v : (<><span data-count={f.v}>{f.v}</span>{f.suffix}</>)}</div>
          <p class="mt-1 text-xs sm:text-sm text-slate-500 font-semibold">{f.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- WHAT IT IS (prose + image) -->
  <section class="py-16 lg:py-20 bg-white overflow-x-hidden">
    <div class="max-w-6xl mx-auto px-5 sm:px-6 grid lg:grid-cols-[1fr_minmax(0,340px)] gap-12 items-start">
      <div class="reveal prose prose-lg prose-slate max-w-none prose-headings:font-heading prose-headings:text-dark prose-a:text-primary">
        <Content />
      </div>
      <aside class="reveal reveal-delay-1 lg:sticky lg:top-28 space-y-5">
        <div class="zoom-frame rounded-[var(--radius)] aspect-[4/5] shadow-xl bg-sky">
          <Pic src={sideImg} alt="Hands-on treatment at Healing Hands Physical Therapy in Reno" width={340} height={425} sizes="340px" class="w-full h-full object-cover" />
        </div>
        <div class="glass p-6 text-center">
          <p class="font-bold text-dark">Ready to get started?</p>
          <p class="text-sm text-slate-600 mt-1">A full hour, one-on-one with your doctor.</p>
          <a href={practice.booking.url} target="_blank" rel="noopener" class="btn btn-accent w-full justify-center mt-4 text-sm">Book an appointment</a>
        </div>
      </aside>
    </div>
  </section>

  <!-- HOW IT WORKS (timeline) -->
  <section class="py-16 lg:py-20 section-sky relative overflow-hidden">
    <div class="max-w-5xl mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto reveal">
        <span class="text-primary font-bold uppercase tracking-wide text-sm">How it works</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-dark mt-2">What to expect at Healing Hands</h2>
      </div>
      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-4 gap-6 stagger">
        {steps.map((s) => (
          <div class="card p-6 reveal text-center">
            <div class="w-14 h-14 rounded-full bg-primary text-white text-2xl font-extrabold grid place-items-center mx-auto shadow-lg">{s.n}</div>
            <div class="text-3xl mt-4">{s.icon}</div>
            <h3 class="mt-2 font-bold text-dark">{s.t}</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PULL QUOTE -->
  <section class="py-16 bg-white">
    <figure class="glass max-w-3xl mx-auto px-6 sm:px-10 py-10 text-center relative reveal">
      <span class="absolute -top-3 left-6 text-7xl text-primary/15 font-heading leading-none">“</span>
      <blockquote class="text-xl sm:text-2xl font-heading text-dark leading-snug">We look for the root cause of your pain, not just the symptoms — a full hour of hands-on care that gets to the real issue, so you can get back to doing what you love.</blockquote>
      <figcaption class="mt-5 text-sm font-bold text-primary-deep">— {provider.name}, {provider.credentials} · {provider.title}</figcaption>
    </figure>
  </section>

  {faqs.length > 0 && (
    <section class="pb-16 bg-white">
      <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) })} />
      <div class="max-w-3xl mx-auto px-5 sm:px-6">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-dark mb-6 text-center">Frequently asked questions</h2>
        <div class="space-y-3">
          {faqs.map((f) => (
            <details class="card p-5 group">
              <summary class="font-bold text-dark cursor-pointer flex justify-between items-center gap-4">{f.question}<span class="text-primary group-open:rotate-45 transition-transform text-2xl shrink-0">+</span></summary>
              <p class="mt-3 text-slate-600 leading-relaxed">{f.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- RELATED -->
  <section class="py-16 section-cream">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-2xl font-extrabold text-dark mb-8 reveal text-center">Explore more of how we help</h2>
      <div class="grid sm:grid-cols-3 gap-6 stagger">
        {others.map((s) => (
          <a href={`/services/${s.slug}`} class="card overflow-hidden reveal group">
            <div class="zoom-frame aspect-[16/10] bg-sky"><Pic src={s.data.image} alt={s.data.title} width={420} height={262} class="w-full h-full object-cover" /></div>
            <div class="p-6">
              <h3 class="font-bold text-dark group-hover:text-primary transition-colors">{s.data.title}</h3>
              <p class="mt-2 text-sm text-slate-500 line-clamp-2">{s.data.description}</p>
              <span class="mt-3 inline-block text-primary font-semibold text-sm">Learn more →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="py-16 relative overflow-hidden" style="background:linear-gradient(120deg,var(--color-primary-deep),var(--color-primary));">
    <div class="aurora opacity-30"></div>
    <div class="relative max-w-2xl mx-auto px-4 text-center text-white reveal">
      <h2 class="text-3xl font-extrabold">Let's get to the root of your pain.</h2>
      <p class="mt-3 text-white/85">A full hour of hands-on, one-on-one care — in Reno, Sparks, Carson City &amp; Incline Village.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href={practice.booking.url} target="_blank" rel="noopener" class="btn btn-accent text-lg">Book your appointment</a>
        <a href={phoneHref} class="btn bg-white text-primary-deep text-lg">📞 {practice.phone}</a>
      </div>
    </div>
  </section>
</Base>

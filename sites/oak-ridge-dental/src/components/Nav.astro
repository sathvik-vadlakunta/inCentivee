---
import practice from '@data/practice.json'
import { getCollection } from 'astro:content'

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order)
const categories = practice.serviceCategories.filter((c) => services.some((s) => s.data.category === c))
const grouped = categories.map((cat) => ({ name: cat, items: services.filter((s) => s.data.category === cat) }))

const areas: string[] = (practice as any).areaServed ?? []
const areaSlug = (a: string) => a.toLowerCase().replace(/[^a-z0-9]+/g, '-')
const navLinks = [
  { label: 'About', href: '/about' },
  { label: 'Doctors', href: '/team' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contact', href: '/contact' },
]
const currentPath = Astro.url.pathname
const tel = practice.phone.replace(/[^+\d]/g, '')
const trig = 'px-3 py-2 rounded-full text-sm font-medium inline-flex items-center gap-1 text-white/85 hover:text-white hover:bg-white/10 transition-colors'
---

<header class="sticky top-0 z-50 bg-secondary/95 backdrop-blur-md border-b border-white/10 text-white">
  <nav class="container-px">
    <div class="flex items-center justify-between h-16 sm:h-20">
      <a href="/" class="shrink-0 flex items-center gap-2.5">
        <img src="/images/oak/logo-white.webp" alt={practice.name} class="h-9 sm:h-11 w-auto" />
      </a>

      <div class="hidden lg:flex items-center gap-0.5">
        <div class="relative group">
          <a href="/services" class={trig}>Services
            <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </a>
          <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-all duration-150 absolute left-1/2 -translate-x-1/2 top-full pt-3 w-[64rem] max-w-[94vw]">
            <div class="rounded-2xl bg-white text-dark shadow-2xl ring-1 ring-black/5 p-6 grid grid-cols-4 gap-x-6 gap-y-5 max-h-[70vh] overflow-y-auto">
              {grouped.map((group) => (
                <div>
                  <p class="text-[11px] uppercase tracking-wider text-accent font-semibold mb-2">{group.name}</p>
                  <ul class="space-y-1">
                    {group.items.map((s) => (<li><a href={`/services/${s.slug}`} class="block text-sm text-dark/70 hover:text-primary py-0.5">{s.data.title}</a></li>))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </div>

        {areas.length > 0 && (
          <div class="relative group">
            <a href={`/dentist/${areaSlug(areas[0])}`} class={trig + ' whitespace-nowrap'}>Areas We Serve
              <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </a>
            <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-all duration-150 absolute left-1/2 -translate-x-1/2 top-full pt-3 w-60">
              <div class="rounded-2xl bg-white shadow-2xl ring-1 ring-black/5 p-4">
                <ul class="space-y-0.5">
                  {areas.map((a) => (<li><a href={`/dentist/${areaSlug(a)}`} class="block text-sm text-dark/70 hover:text-primary py-1">Dentist in {a}</a></li>))}
                </ul>
              </div>
            </div>
          </div>
        )}

        {navLinks.map((link) => (
          <a href={link.href} class:list={['px-3 py-2 rounded-full text-sm font-medium transition-colors', currentPath.startsWith(link.href) ? 'text-white bg-white/12' : 'text-white/85 hover:text-white hover:bg-white/10']}>{link.label}</a>
        ))}
        <a href={`tel:${tel}`} class="ml-1 text-sm font-semibold text-white/90 hover:text-white px-2">{practice.phone}</a>
        <a href="/contact" class="btn btn-gold ml-1 !py-2 !px-5 text-sm">Book Now</a>
      </div>

      <button id="mobile-menu-btn" class="lg:hidden p-2 rounded-md text-white/85 hover:bg-white/10" aria-label="Toggle menu">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
      </button>
    </div>

    <div id="mobile-menu" class="hidden lg:hidden pb-4 max-h-[78vh] overflow-y-auto">
      <a href="/services" class="block px-3 py-2.5 rounded-lg text-base font-semibold text-white hover:bg-white/10">All Services</a>
      {grouped.map((group) => (
        <div class="pl-3 mb-1">
          <p class="text-[11px] uppercase tracking-wider text-accent-soft font-semibold mt-2 mb-1">{group.name}</p>
          {group.items.map((s) => (<a href={`/services/${s.slug}`} class="block px-2 py-1.5 rounded text-sm text-white/75 hover:bg-white/10">{s.data.title}</a>))}
        </div>
      ))}
      <div class="border-t border-white/10 mt-2 pt-2">
        {navLinks.map((link) => (<a href={link.href} class="block px-3 py-2.5 rounded-lg text-base font-medium text-white/80 hover:bg-white/10">{link.label}</a>))}
        {areas.length > 0 && (
          <div class="pl-3">
            <p class="text-[11px] uppercase tracking-wider text-accent-soft font-semibold mt-2 mb-1">Areas We Serve</p>
            {areas.map((a) => (<a href={`/dentist/${areaSlug(a)}`} class="block px-2 py-1.5 rounded text-sm text-white/75 hover:bg-white/10">Dentist in {a}</a>))}
          </div>
        )}
      </div>
      <a href="/contact" class="btn btn-gold w-full mt-3">Book Now</a>
    </div>
  </nav>
</header>

<script is:inline>
  function prBindMenu() {
    const btn = document.getElementById('mobile-menu-btn')
    const menu = document.getElementById('mobile-menu')
    if (!btn || btn.dataset.bound) return
    btn.dataset.bound = '1'
    btn.addEventListener('click', () => menu?.classList.toggle('hidden'))
  }
  document.addEventListener('astro:page-load', prBindMenu)
  if (document.readyState !== 'loading') prBindMenu()
  else document.addEventListener('DOMContentLoaded', prBindMenu)
</script>

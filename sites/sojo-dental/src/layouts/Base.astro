---
import Nav from '@components/Nav.astro'
import Footer from '@components/Footer.astro'
import SchemaMarkup from '@components/SchemaMarkup.astro'
import LeadTracking from '@components/LeadTracking.astro'
import practice from '@data/practice.json'
import '@/styles/global.css'

const analytics = (practice as any).analytics ?? {}
const ga4: string = analytics.ga4 || ''
const gtm: string = analytics.gtm || ''
const gsc: string = analytics.googleSiteVerification || ''

interface Props {
  title: string
  description?: string
  image?: string
  noindex?: boolean
  hideFooter?: boolean
}

const { title, description = practice.tagline, image, noindex = false, hideFooter = false } = Astro.props
const pageTitle = title === practice.name ? title : `${title} | ${practice.name}`
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {gsc && <meta name="google-site-verification" content={gsc} />}

    {/* Analytics — GA4 + GTM from practice.json.analytics (loads only when set) */}
    {ga4 && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`}></script>
        <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${ga4}');`}></script>
      </>
    )}
    {gtm && (
      <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${gtm}');`}></script>
    )}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}

    <!-- Preconnect fonts if custom -->
    {practice.fonts.heading !== 'system-ui' && (
      <link rel="preconnect" href="https://fonts.googleapis.com" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link
        rel="stylesheet"
        href={`https://fonts.googleapis.com/css2?family=${practice.fonts.heading.replace(/ /g, '+')}:wght@400;600;700&family=${practice.fonts.body.replace(/ /g, '+')}:wght@300;400;500;600&display=swap`}
      />
    )}

    <SchemaMarkup />
  </head>
  <body class="min-h-screen flex flex-col">
    <Nav />
    <main class="flex-1">
      <slot />
    </main>
    {!hideFooter && <Footer />}
    {gtm && <noscript set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${gtm}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`}></noscript>}
    <LeadTracking />
  </body>
</html>
